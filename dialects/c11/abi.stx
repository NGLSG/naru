    => seq(mlir.op("llvm.store",[$value,$buffer],[],[Attr("alignment",c11.abi.copy_alignment($type),"i64")],[]),$buffer);
effect c11.abi.prepend_return_buffer(Indirect($type),$buffer,$args) => list.prepend($buffer,$args);
