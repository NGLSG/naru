      "work_item": "preprocessor-completeness",
      "clause": "6.10.9",
      "source": "#define PRAGMA(x) _Pragma(#x)\nint main(void){return 20 PRAGMA(STDC FP_CONTRACT OFF) + 22;}"
    },
    {
