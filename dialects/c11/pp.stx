mod c11.pp;
use c11.lex;
use c11.types;
use base;
use headers;

// The macro table, conditional stack, include stack and expansion hide sets
// are ordinary terms. No C directive is implemented in the compiler core.
effect c11.pp.option($options,$key,$default) => choose(env.contains($options,$key),env.get($options,$key),$default);
effect c11.pp.initial() => list.fold("c11.pp.predefine",[["__STDC__","1"],["__STDC_VERSION__","201112L"],
    ["__STDC_HOSTED__","1"],["__STDC_NO_ATOMICS__","1"],["__STDC_NO_THREADS__","1"],
    ["__STDC_NO_COMPLEX__","1"],["__STDC_NO_VLA__","1"]],env.empty());
effect c11.pp.predefine($macros,[$name,$value]) => env.put($macros,$name,c11.pp.Object(c11.lex.tokens($value,"<predefined>")));
effect c11.pp.preprocess($source,$path,$options) => bind($configured,c11.pp.configure($options),
    bind([$tokens,$macros],c11.pp.file($source,$path,c11.pp.platform_macros($configured),$configured,[],0),$tokens));
effect c11.pp.configure($options) => bind($target,headers.toolchain($options),seq(
    choose(and(text.starts(env.get($target,"os"),"windows"),eq(env.get($target,"architecture"),"x86_64")),1,
        fail("C ABI rule profile currently supports only x86_64 Windows; select a matching target profile")),
    env.put(env.put($options,"target_facts",$target),"system_include_paths",choose(env.contains($options,"system_include_paths"),
        text.split(env.get($options,"system_include_paths"),"|"),env.get($target,"include_paths")))));
// Platform compatibility facts are C rule policy, never Naru keywords.
effect c11.pp.platform_macros($options) => choose(env.contains($options,"target_facts"),
    c11.pp.target_macros(c11.pp.initial(),env.get($options,"target_facts")),c11.pp.initial());
effect c11.pp.target_macros($macros,$target) => choose(and(text.starts(env.get($target,"os"),"windows"),eq(env.get($target,"architecture"),"x86_64")),
    list.fold("c11.pp.predefine",[["_WIN32","1"],["_WIN64","1"],["_M_X64","100"],["_M_AMD64","100"],
        ["_INTEGRAL_MAX_BITS","64"]],$macros),$macros);
effect c11.pp.file($source,$path,$macros,$options,$stack,$depth) when lt(128,$depth) => fail("C include nesting exceeds 128");

// Each file uses context stored in the macro table under an opaque term key.
effect c11.pp.context($macros,$path,$options,$stack,$depth) => env.put($macros,c11.pp.ContextKey(),c11.pp.Context($path,$options,$stack,$depth));
effect c11.pp.file($source,$path,$macros,$options,$stack,$depth) when lt($depth,129)
    => choose(env.contains($macros,c11.pp.Once(text.lower($path))),[[],$macros],
        bind(c11.pp.State($result,$final,$conditions,$pending),list.fold("c11.pp.line_step",c11.pp.lines(c11.lex.tokens($source,$path)),
            c11.pp.State([],env.put(c11.pp.context($macros,$path,$options,list.prepend($path,$stack),$depth),c11.pp.LineMapKey(),c11.pp.LineMap($path,0)),[],[])),
            c11.pp.finish_file($result,$final,$conditions,$pending,$path,$options,$stack,$depth)));
effect c11.pp.finish_file($result,$macros,[],$pending,$path,$options,$stack,$depth)
    => [list.flatten(list.reverse(list.prepend(c11.pp.expand(c11.pp.pending_tokens($pending),$macros,env.empty(),0),$result))),$macros];
effect c11.pp.finish_file($result,$macros,$conditions,$pending,$path,$options,$stack,$depth) when lt(0,size($conditions))
    => source.error($path,1,1,"unterminated C conditional directive");

// Split once at newlines; ordinary lines are accumulated until a directive so
// function-like macro calls can cross physical/logical lines.
effect c11.pp.lines($tokens) => bind([$done,$line],list.fold("c11.pp.split_line",$tokens,[[],[]]),
    list.reverse(list.prepend(list.reverse($line),$done)));
effect c11.pp.split_line([$done,$line],$token) => choose(eq(c11.lex.kind($token),7),
    [list.prepend(list.reverse($line),$done),[]],[$done,list.prepend($token,$line)]);
effect c11.pp.active([]) => 1;
effect c11.pp.active($conditions) when lt(0,size($conditions)) => bind(c11.pp.Conditional($parent,$taken,$active,$else),list.head($conditions),$active);
effect c11.pp.line_step(c11.pp.State($output,$macros,$conditions,$pending),[]) => c11.pp.State($output,$macros,$conditions,$pending);
effect c11.pp.line_step(c11.pp.State($output,$macros,$conditions,$pending),$line) when lt(0,size($line))
    => c11.pp.mapped_line(c11.pp.State($output,$macros,$conditions,$pending),c11.pp.remap($line,env.get($macros,c11.pp.LineMapKey())));
effect c11.pp.remap($line,$mapping) => bind(c11.pp.Mapping($reversed,$map),list.fold("c11.pp.remap_one",$line,c11.pp.Mapping([],$mapping)),list.reverse($reversed));
effect c11.pp.remap_one(c11.pp.Mapping($out,c11.pp.LineMap($file,0)),$token) when eq(arg($token,2),$file)
    => c11.pp.Mapping(list.prepend($token,$out),c11.pp.LineMap($file,0));
effect[fallback] c11.pp.remap_one(c11.pp.Mapping($out,c11.pp.LineMap($file,$offset)),[$kind,$raw,$path,$line,$column,$space])
    => c11.pp.Mapping(list.prepend([$kind,$raw,$file,add($line,$offset),$column,$space],$out),c11.pp.LineMap($file,$offset));
effect c11.pp.mapped_line(c11.pp.State($output,$macros,$conditions,$pending),$line)
    => choose(eq(c11.lex.spelling(list.head($line)),"#"),
        c11.pp.directive(c11.pp.State(list.prepend(c11.pp.expand(c11.pp.pending_tokens($pending),$macros,env.empty(),0),$output),$macros,$conditions,[]),list.tail($line),list.head($line)),
        choose(c11.pp.active($conditions),c11.pp.State($output,$macros,$conditions,list.prepend($line,$pending)),c11.pp.State($output,$macros,$conditions,$pending)));
effect c11.pp.pending_tokens($chunks) => list.flatten(list.reverse($chunks));
effect c11.pp.directive($state,[],$at) => $state;
effect c11.pp.directive($state,$tokens,$at) when lt(0,size($tokens)) => c11.pp.command(c11.lex.spelling(list.head($tokens)),list.tail($tokens),$state,$at);
effect c11.pp.command("if",$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => c11.pp.push_condition($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at);
effect c11.pp.command("ifdef",$tokens,$state,$at) => c11.pp.defined_condition($tokens,$state,$at,0);
effect c11.pp.command("ifndef",$tokens,$state,$at) => c11.pp.defined_condition($tokens,$state,$at,1);
effect c11.pp.defined_condition([$name],c11.pp.State($out,$macros,$conditions,$pending),$at,$invert)
    => bind($value,choose($invert,not(c11.pp.defined($macros,c11.lex.spelling($name))),c11.pp.defined($macros,c11.lex.spelling($name))),
        c11.pp.State($out,$macros,list.prepend(c11.pp.Conditional(c11.pp.active($conditions),$value,and(c11.pp.active($conditions),$value),0),$conditions),$pending));
effect[fallback] c11.pp.defined_condition($tokens,$state,$at,$invert) => c11.lex.error($at,"ifdef/ifndef requires one identifier");
effect c11.pp.push_condition($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => bind($parent,c11.pp.active($conditions),bind($value,choose($parent,c11.pp.condition($tokens,$macros),0),
        c11.pp.State($out,$macros,list.prepend(c11.pp.Conditional($parent,$value,and($parent,$value),0),$conditions),$pending)));
effect c11.pp.command("elif",$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(eq(size($conditions),0),c11.lex.error($at,"elif without if"),
        c11.pp.elif($tokens,$out,$macros,list.head($conditions),list.tail($conditions),$at));
effect c11.pp.elif($tokens,$out,$macros,c11.pp.Conditional($parent,$taken,$active,0),$rest,$at)
    => bind($value,choose(and($parent,not($taken)),c11.pp.condition($tokens,$macros),0),
        c11.pp.State($out,$macros,list.prepend(c11.pp.Conditional($parent,or($taken,$value),$value,0),$rest),[]));
effect c11.pp.elif($tokens,$out,$macros,c11.pp.Conditional($parent,$taken,$active,1),$rest,$at) => c11.lex.error($at,"elif after else");
effect c11.pp.command("else",[],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(eq(size($conditions),0),c11.lex.error($at,"else without if"),
        c11.pp.else_branch($out,$macros,list.head($conditions),list.tail($conditions),$at));
effect c11.pp.else_branch($out,$macros,c11.pp.Conditional($parent,$taken,$active,0),$rest,$at)
    => c11.pp.State($out,$macros,list.prepend(c11.pp.Conditional($parent,1,and($parent,not($taken)),1),$rest),[]);
effect c11.pp.else_branch($out,$macros,c11.pp.Conditional($parent,$taken,$active,1),$rest,$at) => c11.lex.error($at,"duplicate else");
effect c11.pp.command("endif",[],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(eq(size($conditions),0),c11.lex.error($at,"endif without if"),c11.pp.State($out,$macros,list.tail($conditions),[]));
effect[fallback] c11.pp.command($name,$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(c11.pp.active($conditions),c11.pp.enabled($name,$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at),c11.pp.State($out,$macros,$conditions,$pending));
effect c11.pp.enabled("define",$tokens,$state,$at) => c11.pp.define($tokens,$state,$at);
effect c11.pp.enabled("undef",[$name],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => c11.pp.State($out,env.put($macros,c11.lex.spelling($name),c11.pp.Undefined()),$conditions,$pending);
effect c11.pp.enabled("include",$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => bind(c11.pp.Context($path,$options,$stack,$depth),env.get($macros,c11.pp.ContextKey()),
        bind($line_map,env.get($macros,c11.pp.LineMapKey()),bind([$header,$local],c11.pp.header(c11.pp.include_tokens($tokens,$macros),$at),
            bind($found,c11.pp.find_header($header,$local,$path,$options,$at),
                bind([$items,$final],c11.pp.file(source.read($found),$found,$macros,$options,$stack,add($depth,1)),
                    c11.pp.State(list.prepend($items,$out),env.put(c11.pp.context($final,$path,$options,$stack,$depth),c11.pp.LineMapKey(),$line_map),$conditions,[]))))));
effect c11.pp.include_tokens([],$macros) => [];
effect c11.pp.include_tokens($tokens,$macros) when lt(0,size($tokens)) => choose(or(eq(c11.lex.kind(list.head($tokens)),3),eq(c11.lex.spelling(list.head($tokens)),"<")),
    $tokens,c11.pp.expand($tokens,$macros,env.empty(),0));
effect c11.pp.enabled("error",$tokens,$state,$at) => c11.lex.error($at,concat("#error ",text.join(list.map("c11.lex.spelling",$tokens)," ")));
// Unknown pragmas may be ignored by the implementation.
effect c11.pp.enabled("pragma",[$token],c11.pp.State($out,$macros,$conditions,$pending),$at) when eq(c11.lex.spelling($token),"once")
    => bind(c11.pp.Context($path,$options,$stack,$depth),env.get($macros,c11.pp.ContextKey()),c11.pp.State($out,env.put($macros,c11.pp.Once(text.lower($path)),1),$conditions,$pending));
effect[fallback] c11.pp.enabled("pragma",$tokens,$state,$at) => $state;
effect c11.pp.enabled("line",$tokens,$state,$at) => c11.pp.line_control(c11.pp.expand($tokens,c11.pp.state_macros($state),env.empty(),0),$state,$at);
effect c11.pp.state_macros(c11.pp.State($out,$macros,$conditions,$pending)) => $macros;
effect c11.pp.line_control([$number],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => bind(c11.pp.LineMap($file,$offset),env.get($macros,c11.pp.LineMapKey()),c11.pp.line_mapping($number,$file,$offset,$out,$macros,$conditions,$pending,$at));
effect c11.pp.line_control([$number,$file],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => bind(c11.pp.LineMap($old_file,$offset),env.get($macros,c11.pp.LineMapKey()),
        c11.pp.line_mapping($number,text.unquote(c11.lex.spelling($file)),$offset,$out,$macros,$conditions,$pending,$at));
effect[fallback] c11.pp.line_control($tokens,$state,$at) => c11.lex.error($at,"line requires a line number and optional quoted filename");
effect c11.pp.line_mapping($number,$file,$offset,$out,$macros,$conditions,$pending,$at)
    => bind($line,int.parse(c11.lex.spelling($number)),choose(and(lt(0,$line),not(lt(2147483647,$line))),
        c11.pp.State($out,env.put($macros,c11.pp.LineMapKey(),c11.pp.LineMap($file,add($offset,sub($line,add(arg($at,3),1))))),$conditions,$pending),
        c11.lex.error($at,"line number outside C11's valid range")));
effect[fallback] c11.pp.enabled($name,$tokens,$state,$at) when not(eq($name,"pragma")) => c11.lex.error($at,concat("unknown preprocessing directive: ",$name));

effect c11.pp.header([$token],$at) when eq(c11.lex.kind($token),3) => [text.unquote(c11.lex.spelling($token)),1];
effect c11.pp.header($tokens,$at) when and(lt(1,size($tokens)),eq(c11.lex.spelling(list.head($tokens)),"<"))
    => choose(eq(c11.lex.spelling(arg($tokens,sub(size($tokens),1))),">"),
        [text.join(list.map("c11.lex.spelling",list.slice($tokens,1,sub(size($tokens),1))),""),0],c11.lex.error($at,"unterminated include header"));
effect[fallback] c11.pp.header($tokens,$at) => c11.lex.error($at,"include requires a quoted or bracketed header");
effect c11.pp.find_header($header,$local,$path,$options,$at)
    => headers.find($header,$local,$path,$options,env.get($options,"system_include_paths"),$at);

effect c11.pp.defined($macros,$name) => choose(env.contains($macros,$name),not(eq(env.get($macros,$name),c11.pp.Undefined())),0);
effect c11.pp.define($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at) => choose(eq(size($tokens),0),c11.lex.error($at,"define requires a macro name"),
    bind($name,list.head($tokens),choose(eq(c11.lex.kind($name),1),
        c11.pp.macro_definition(c11.lex.spelling($name),list.tail($tokens),$out,$macros,$conditions,$at),c11.lex.error($at,"invalid macro name"))));
effect c11.pp.macro_definition($name,[],$out,$macros,$conditions,$at) => c11.pp.install($name,c11.pp.Object([]),$out,$macros,$conditions,$at);
effect c11.pp.macro_definition($name,$tokens,$out,$macros,$conditions,$at) when lt(0,size($tokens))
    => choose(and(eq(c11.lex.spelling(list.head($tokens)),"("),not(c11.lex.space(list.head($tokens)))),
        bind([$params,$variadic,$body],c11.pp.parameters(list.tail($tokens),[],0,$at),c11.pp.install($name,c11.pp.Function($params,$variadic,$body),$out,$macros,$conditions,$at)),
        c11.pp.install($name,c11.pp.Object($tokens),$out,$macros,$conditions,$at));
effect c11.pp.install($name,$macro,$out,$macros,$conditions,$at) => choose(c11.pp.defined($macros,$name),
    choose(eq(c11.pp.shape(env.get($macros,$name)),c11.pp.shape($macro)),c11.pp.State($out,env.put($macros,$name,$macro),$conditions,[]),c11.lex.error($at,"incompatible macro redefinition")),
    c11.pp.State($out,env.put($macros,$name,$macro),$conditions,[]));
effect c11.pp.shape(c11.pp.Object($body)) => c11.pp.Object(list.map("c11.lex.spelling",$body));
effect c11.pp.shape(c11.pp.Function($params,$variadic,$body)) => c11.pp.Function($params,$variadic,list.map("c11.lex.spelling",$body));
effect c11.pp.parameters([],$params,$variadic,$at) => c11.lex.error($at,"unterminated macro parameter list");
effect c11.pp.parameters($tokens,$params,$variadic,$at) when lt(0,size($tokens))
    => bind($head,c11.lex.spelling(list.head($tokens)),choose(eq($head,")"),[$params,$variadic,list.tail($tokens)],
        choose(eq($head,"..."),c11.pp.variadic_parameter(list.tail($tokens),$params,$at),
            choose(eq(c11.lex.kind(list.head($tokens)),1),
                choose(c11.pp.member($head,$params),c11.lex.error($at,"duplicate macro parameter"),c11.pp.parameter_tail(list.tail($tokens),list.concat($params,[$head]),$at)),
                c11.lex.error($at,"invalid macro parameter")))));
effect c11.pp.parameter_tail([],$params,$at) => c11.lex.error($at,"unterminated macro parameter list");
effect c11.pp.parameter_tail($tokens,$params,$at) when lt(0,size($tokens))
    => choose(eq(c11.lex.spelling(list.head($tokens)),","),c11.pp.parameters(list.tail($tokens),$params,0,$at),
        choose(eq(c11.lex.spelling(list.head($tokens)),")"),[$params,0,list.tail($tokens)],c11.lex.error($at,"expected comma or closing parenthesis")));
effect c11.pp.variadic_parameter($tokens,$params,$at) => choose(choose(lt(0,size($tokens)),eq(c11.lex.spelling(list.head($tokens)),")"),0),
    [$params,1,list.tail($tokens)],c11.lex.error($at,"ellipsis must be the final macro parameter"));
effect c11.pp.member($value,[]) => 0;
effect c11.pp.member($value,$list) when lt(0,size($list)) => choose(eq($value,list.head($list)),1,c11.pp.member($value,list.tail($list)));

// Expansion uses per-token hide sets. Replacement tokens and the remaining
// input are rescanned together, so aliases may become function-like macros.
effect c11.pp.expand($tokens,$macros,$hide,$depth) => c11.pp.unmark(c11.pp.expand_mark(c11.pp.mark($tokens,$hide),$macros,$depth));
effect c11.pp.mark($tokens,$hide) when eq(term.kind($tokens),5)
    => c11.pp.Marked(list.unfold("c11.pp.mark_step",c11.pp.Marking(list.cursor($tokens),$hide),1000000),$hide);
effect c11.pp.mark_step(c11.pp.Marking($cursor,$hide)) => choose(list.cursor.empty($cursor),[0,c11.pp.Marking($cursor,$hide),[]],
    [1,c11.pp.Marking(list.cursor.tail($cursor),$hide),[c11.pp.MarkedToken(list.cursor.head($cursor),$hide)]]);
effect c11.pp.expand_mark(c11.pp.Marked($tokens,$hide),$macros,$depth) => c11.pp.expand_items($tokens,$macros,$depth);
effect c11.pp.unmark([]) => [];
effect c11.pp.unmark($tokens) when lt(0,size($tokens)) => list.map("c11.pp.unmark_one",$tokens);
effect c11.pp.unmark_one(c11.pp.MarkedToken($token,$hide)) => $token;
// Replacement chunks form a persistent cursor stack. Replacing a macro pushes
// one chunk without copying the unconsumed source or the growing output.
effect c11.pp.work($tokens,$tail) => choose(eq(size($tokens),0),$tail,c11.pp.CursorWork(list.cursor($tokens),$tail));
effect c11.pp.work_head(c11.pp.CursorWork($cursor,$tail)) => list.cursor.head($cursor);
effect c11.pp.work_next(c11.pp.CursorWork($cursor,$tail)) => bind($next,list.cursor.tail($cursor),
    choose(list.cursor.empty($next),$tail,c11.pp.CursorWork($next,$tail)));
effect c11.pp.expand_items($tokens,$macros,$depth) => choose(lt(64,$depth),fail("C macro argument expansion nesting exceeds 64"),
    list.unfold("c11.pp.expansion_step",c11.pp.Expansion(c11.pp.work($tokens,c11.pp.EmptyWork()),$macros,$depth),1000000));
effect c11.pp.expansion_step(c11.pp.Expansion(c11.pp.EmptyWork(),$macros,$depth)) => [0,c11.pp.Expansion(c11.pp.EmptyWork(),$macros,$depth),[]];
effect c11.pp.expansion_step(c11.pp.Expansion(c11.pp.CursorWork($cursor,$tail),$macros,$depth))
    => bind($work,c11.pp.CursorWork($cursor,$tail),bind(c11.pp.MarkedToken($token,$hide),c11.pp.work_head($work),
        choose(and(eq(c11.lex.kind($token),1),and(c11.pp.defined($macros,c11.lex.spelling($token)),not(env.contains($hide,c11.lex.spelling($token))))),
            c11.pp.replace_macro(env.get($macros,c11.lex.spelling($token)),$token,$hide,c11.pp.work_next($work),$macros,$depth),
            [1,c11.pp.Expansion(c11.pp.work_next($work),$macros,$depth),[c11.pp.MarkedToken(c11.pp.builtin($token),$hide)]])));
effect c11.pp.builtin($token) when eq(c11.lex.spelling($token),"__LINE__") => c11.lex.made(2,text(arg($token,3)),$token);
effect c11.pp.builtin($token) when eq(c11.lex.spelling($token),"__FILE__") => c11.lex.made(3,text.quote(arg($token,2)),$token);
effect[fallback] c11.pp.builtin($token) => $token;
effect c11.pp.replace_macro(c11.pp.Object($body),$at,$hide,$rest,$macros,$depth)
    => bind(c11.pp.Marked($replacement,$new_hide),c11.pp.mark(c11.pp.relocate($body,$at),env.put($hide,c11.lex.spelling($at),1)),
        [1,c11.pp.Expansion(c11.pp.work($replacement,$rest),$macros,$depth),[]]);
effect c11.pp.replace_macro(c11.pp.Function($params,$variadic,$body),$at,$hide,c11.pp.EmptyWork(),$macros,$depth)
    => [1,c11.pp.Expansion(c11.pp.EmptyWork(),$macros,$depth),[c11.pp.MarkedToken($at,$hide)]];
effect c11.pp.replace_macro(c11.pp.Function($params,$variadic,$body),$at,$hide,c11.pp.CursorWork($cursor,$remaining),$macros,$depth)
    => bind($rest,c11.pp.CursorWork($cursor,$remaining),bind(c11.pp.MarkedToken($next,$next_hide),c11.pp.work_head($rest),choose(eq(c11.lex.spelling($next),"("),
        bind([$arguments,$tail],c11.pp.arguments(c11.pp.work_next($rest),[],[],0,$at),
            bind($bindings,c11.pp.bind_arguments($params,$variadic,$arguments,$at),
                bind($replacement,c11.pp.substitute($body,$bindings,$macros,$at,$depth),
                    bind(c11.pp.Marked($marked,$new_hide),c11.pp.mark(c11.pp.relocate($replacement,$at),env.put($hide,c11.lex.spelling($at),1)),
                        [1,c11.pp.Expansion(c11.pp.work($marked,$tail),$macros,$depth),[]])))),
        [1,c11.pp.Expansion($rest,$macros,$depth),[c11.pp.MarkedToken($at,$hide)]])));
effect c11.pp.relocate($tokens,$at) => bind(c11.pp.Located($reversed,$origin),list.fold("c11.pp.relocate_one",$tokens,c11.pp.Located([],$at)),c11.pp.Located(list.reverse($reversed),$origin));
effect c11.pp.relocate_one(c11.pp.Located($tokens,$at),$token) => c11.pp.Located(list.prepend(c11.lex.made(c11.lex.kind($token),c11.lex.spelling($token),$at),$tokens),$at);
// unwrap the fold state without rewriting token provenance in the core
effect c11.pp.mark(c11.pp.Located($tokens,$at),$hide) => c11.pp.mark($tokens,$hide);

effect c11.pp.arguments($work,$done,$current,$nesting,$at) => bind(c11.pp.ArgumentResult($arguments,$tail),
    rule.iterate("c11.pp.argument_step",c11.pp.Arguments($work,list.reverse($done),list.reverse($current),$nesting,$at),1000000),[$arguments,$tail]);
effect c11.pp.argument_step(c11.pp.Arguments(c11.pp.EmptyWork(),$done,$current,$nesting,$at)) => c11.lex.error($at,"unterminated macro invocation");
effect c11.pp.argument_step(c11.pp.Arguments(c11.pp.CursorWork($cursor,$tail),$done,$current,$nesting,$at))
    => bind($work,c11.pp.CursorWork($cursor,$tail),bind(c11.pp.MarkedToken($token,$hide),c11.pp.work_head($work),bind($raw,c11.lex.spelling($token),
        choose(and(eq($raw,")"),eq($nesting,0)),[0,c11.pp.ArgumentResult(list.reverse(list.prepend(list.reverse($current),$done)),c11.pp.work_next($work))],
            choose(and(eq($raw,","),eq($nesting,0)),[1,c11.pp.Arguments(c11.pp.work_next($work),list.prepend(list.reverse($current),$done),[],0,$at)],
                [1,c11.pp.Arguments(c11.pp.work_next($work),$done,list.prepend($token,$current),
                    add($nesting,choose(eq($raw,"("),1,choose(eq($raw,")"),-1,0))),$at)])))));
effect c11.pp.bind_arguments([] ,0,[[]],$at) => env.empty();
effect[fallback] c11.pp.bind_arguments($params,$variadic,$arguments,$at) => choose(
    choose($variadic,not(lt(size($arguments),size($params))),eq(size($arguments),size($params))),
    bind($env,c11.pp.bind_fixed($params,$arguments,env.empty()),choose($variadic,
        env.put($env,"__VA_ARGS__",c11.pp.join_arguments(list.slice($arguments,size($params),size($arguments)),$at)),$env)),
    c11.lex.error($at,"macro argument count mismatch"));
effect c11.pp.bind_fixed([],$arguments,$env) => $env;
effect c11.pp.bind_fixed($params,$arguments,$env) when lt(0,size($params))
    => c11.pp.bind_fixed(list.tail($params),list.tail($arguments),env.put($env,list.head($params),list.head($arguments)));
effect c11.pp.join_arguments([],$at) => [];
effect c11.pp.join_arguments([$argument],$at) => $argument;
effect c11.pp.join_arguments($arguments,$at) when lt(1,size($arguments))
    => list.concat(list.head($arguments),list.prepend(c11.lex.made(5,",",$at),c11.pp.join_arguments(list.tail($arguments),$at)));

effect c11.pp.substitute($body,$bindings,$macros,$at,$depth) => c11.pp.paste(c11.pp.substitute_tokens($body,$bindings,$macros,$at,$depth,0),$at);
effect c11.pp.substitute_tokens($body,$bindings,$macros,$at,$depth,$previous_paste) => list.unfold("c11.pp.substitution_step",
    c11.pp.Substitution($body,$bindings,$macros,$at,$depth,$previous_paste),1000000);
effect c11.pp.substitution_step(c11.pp.Substitution([],$bindings,$macros,$at,$depth,$previous_paste))
    => [0,c11.pp.Substitution([],$bindings,$macros,$at,$depth,$previous_paste),[]];
effect c11.pp.substitution_step(c11.pp.Substitution($body,$bindings,$macros,$at,$depth,$previous_paste)) when lt(0,size($body))
    => bind($token,list.head($body),choose(eq(c11.lex.spelling($token),"#"),
        c11.pp.stringification_step(list.tail($body),$bindings,$macros,$at,$depth),
        [1,c11.pp.Substitution(list.tail($body),$bindings,$macros,$at,$depth,eq(c11.lex.spelling($token),"##")),
            c11.pp.parameter_value($token,$body,$bindings,$macros,$depth,$previous_paste)]));
effect c11.pp.stringification_step([],$bindings,$macros,$at,$depth) => c11.lex.error($at,"stringification requires a macro parameter");
effect c11.pp.stringification_step($tokens,$bindings,$macros,$at,$depth) when lt(0,size($tokens))
    => bind($name,c11.lex.spelling(list.head($tokens)),choose(env.contains($bindings,$name),
        [1,c11.pp.Substitution(list.tail($tokens),$bindings,$macros,$at,$depth,0),
            [c11.lex.made(3,text.quote(c11.pp.stringify(env.get($bindings,$name))),$at)]],
        c11.lex.error($at,"stringification requires a macro parameter")));
effect c11.pp.stringify($tokens) => text.trim(text.join(list.reverse(list.fold("c11.pp.stringify_one",$tokens,[])),""));
effect c11.pp.stringify_one($out,$token) => list.prepend(concat(choose(and(lt(0,size($out)),c11.lex.space($token))," ",""),c11.lex.spelling($token)),$out);
effect c11.pp.parameter_value($token,$body,$bindings,$macros,$depth,$previous_paste) => choose(env.contains($bindings,c11.lex.spelling($token)),
    // ## operands must use the unexpanded argument. The paste pass rescans it.
    choose(or($previous_paste,choose(lt(1,size($body)),eq(c11.lex.spelling(arg($body,1)),"##"),0)),
        c11.pp.paste_argument(env.get($bindings,c11.lex.spelling($token)),$token),
        c11.pp.expand(env.get($bindings,c11.lex.spelling($token)),$macros,env.empty(),add($depth,1))),[$token]);
effect c11.pp.paste_argument([],$at) => [c11.lex.made(8,"",$at)];
effect c11.pp.paste_argument($tokens,$at) when lt(0,size($tokens)) => $tokens;
effect c11.pp.paste($tokens,$at) => bind($reversed,list.fold("c11.pp.paste_one",$tokens,c11.pp.Pasting([],0,$at)),c11.pp.paste_finish($reversed));
effect c11.pp.paste_one(c11.pp.Pasting($out,0,$at),$token) => choose(eq(c11.lex.spelling($token),"##"),
    choose(eq(size($out),0),c11.lex.error($at,"token paste has no left operand"),c11.pp.Pasting($out,1,$at)),c11.pp.Pasting(list.prepend($token,$out),0,$at));
effect c11.pp.paste_one(c11.pp.Pasting($out,1,$at),$token)
    => c11.pp.Pasting(list.prepend(c11.pp.paste_pair(list.head($out),$token,$at),list.tail($out)),0,$at);
// Empty arguments are placemarkers, including when both operands are empty.
effect c11.pp.paste_pair($left,$right,$at) when eq(c11.lex.kind($left),8) => $right;
effect c11.pp.paste_pair($left,$right,$at) when and(not(eq(c11.lex.kind($left),8)),eq(c11.lex.kind($right),8)) => $left;
effect c11.pp.paste_pair($left,$right,$at) when and(not(eq(c11.lex.kind($left),8)),not(eq(c11.lex.kind($right),8)))
    => bind($joined,c11.lex.tokens(concat(c11.lex.spelling($left),c11.lex.spelling($right)),arg($at,2)),
        choose(eq(size($joined),1),c11.lex.made(c11.lex.kind(list.head($joined)),c11.lex.spelling(list.head($joined)),$at),
            c11.lex.error($at,"token paste does not form one preprocessing token")));
effect c11.pp.paste_finish(c11.pp.Pasting($out,0,$at)) => bind($tokens,list.fold("c11.pp.remove_placeholder",list.reverse($out),[]),list.reverse($tokens));
effect c11.pp.remove_placeholder($out,$token) => choose(eq(c11.lex.kind($token),8),$out,list.prepend($token,$out));
effect c11.pp.paste_finish(c11.pp.Pasting($out,1,$at)) => c11.lex.error($at,"token paste has no right operand");

// #if uses a separate constant-expression grammar and short-circuit evaluator.
effect c11.pp.condition($tokens,$macros) => c11.pp.truth(c11.pp.evaluate(source.parse_expression(
    c11.pp.undefined_zero(c11.pp.expand(c11.pp.defined_tokens($tokens,$macros),$macros,env.empty(),0)),"c11.pp_expr")));
effect c11.pp.defined_tokens([],$macros) => [];
effect c11.pp.defined_tokens($tokens,$macros) when lt(0,size($tokens))
    => choose(eq(c11.lex.spelling(list.head($tokens)),"defined"),c11.pp.defined_operand(list.tail($tokens),$macros,list.head($tokens)),
        list.prepend(list.head($tokens),c11.pp.defined_tokens(list.tail($tokens),$macros)));
effect c11.pp.defined_operand($tokens,$macros,$at) => choose(eq(size($tokens),0),c11.lex.error($at,"defined requires an identifier"),
    choose(eq(c11.lex.spelling(list.head($tokens)),"("),c11.pp.defined_parentheses($tokens,$macros,$at),
        list.prepend(c11.lex.made(2,text(c11.pp.defined($macros,c11.lex.spelling(list.head($tokens)))),$at),c11.pp.defined_tokens(list.tail($tokens),$macros))));
effect c11.pp.defined_parentheses($tokens,$macros,$at) => choose(choose(not(lt(size($tokens),3)),eq(c11.lex.spelling(arg($tokens,2)),")"),0),
    list.prepend(c11.lex.made(2,text(c11.pp.defined($macros,c11.lex.spelling(arg($tokens,1)))),$at),c11.pp.defined_tokens(list.slice($tokens,3,size($tokens)),$macros)),
    c11.lex.error($at,"malformed defined operator"));
effect c11.pp.undefined_zero($tokens) => list.map("c11.pp.zero_identifier",$tokens);
effect c11.pp.zero_identifier($token) => choose(eq(c11.lex.kind($token),1),c11.lex.made(2,"0",$token),$token);
effect c11.pp.truth(c11.pp.PPInt($value,$unsigned)) => not(eq($value,0));
syntax c11.pp_expr `$n:number` => c11.pp.Number($n);
syntax c11.pp_expr `$raw:string` => c11.pp.Character($raw);
syntax c11.pp_expr `($e:c11.pp_expr)` => $e;
syntax c11.pp_expr[90,right] `! $e:c11.pp_expr` => c11.pp.Unary("!",$e);
syntax c11.pp_expr[90,right] `~ $e:c11.pp_expr` => c11.pp.Unary("~",$e);
syntax c11.pp_expr[90,right] `- $e:c11.pp_expr` => c11.pp.Unary("-",$e);
syntax c11.pp_expr[90,right] `+ $e:c11.pp_expr` => c11.pp.Unary("+",$e);
syntax c11.pp_expr[80,left] `$a:c11.pp_expr * $b:c11.pp_expr` => c11.pp.Binary("*",$a,$b);
syntax c11.pp_expr[80,left] `$a:c11.pp_expr / $b:c11.pp_expr` => c11.pp.Binary("/",$a,$b);
syntax c11.pp_expr[80,left] `$a:c11.pp_expr % $b:c11.pp_expr` => c11.pp.Binary("%",$a,$b);
syntax c11.pp_expr[70,left] `$a:c11.pp_expr + $b:c11.pp_expr` => c11.pp.Binary("+",$a,$b);
syntax c11.pp_expr[70,left] `$a:c11.pp_expr - $b:c11.pp_expr` => c11.pp.Binary("-",$a,$b);
syntax c11.pp_expr[60,left] `$a:c11.pp_expr << $b:c11.pp_expr` => c11.pp.Binary("<<",$a,$b);
syntax c11.pp_expr[60,left] `$a:c11.pp_expr >> $b:c11.pp_expr` => c11.pp.Binary(">>",$a,$b);
syntax c11.pp_expr[50,left] `$a:c11.pp_expr < $b:c11.pp_expr` => c11.pp.Binary("<",$a,$b);
syntax c11.pp_expr[50,left] `$a:c11.pp_expr > $b:c11.pp_expr` => c11.pp.Binary(">",$a,$b);
syntax c11.pp_expr[50,left] `$a:c11.pp_expr <= $b:c11.pp_expr` => c11.pp.Binary("<=",$a,$b);
syntax c11.pp_expr[50,left] `$a:c11.pp_expr >= $b:c11.pp_expr` => c11.pp.Binary(">=",$a,$b);
syntax c11.pp_expr[45,left] `$a:c11.pp_expr == $b:c11.pp_expr` => c11.pp.Binary("==",$a,$b);
syntax c11.pp_expr[45,left] `$a:c11.pp_expr != $b:c11.pp_expr` => c11.pp.Binary("!=",$a,$b);
syntax c11.pp_expr[40,left] `$a:c11.pp_expr & $b:c11.pp_expr` => c11.pp.Binary("&",$a,$b);
syntax c11.pp_expr[35,left] `$a:c11.pp_expr ^ $b:c11.pp_expr` => c11.pp.Binary("^",$a,$b);
syntax c11.pp_expr[30,left] `$a:c11.pp_expr | $b:c11.pp_expr` => c11.pp.Binary("|",$a,$b);
syntax c11.pp_expr[20,left] `$a:c11.pp_expr && $b:c11.pp_expr` => c11.pp.Binary("&&",$a,$b);
syntax c11.pp_expr[15,left] `$a:c11.pp_expr || $b:c11.pp_expr` => c11.pp.Binary("||",$a,$b);
syntax c11.pp_expr[10,right] `$a:c11.pp_expr ? $b:c11.pp_expr : $c:c11.pp_expr` => c11.pp.ConditionalExpr($a,$b,$c);
// Preprocessing integer types use the selected intmax_t/uintmax_t policy.
effect c11.pp.number($raw) => bind(base.Typed(c11.types.IntType($rank,$width,$unsigned),base.Integer($value)),c11.types.literal($raw),c11.pp.PPInt($value,$unsigned));
effect c11.pp.evaluate(c11.pp.Number($raw)) => c11.pp.number($raw);
effect c11.pp.evaluate(c11.pp.Character($raw)) => choose(text.starts($raw,"'"),
    bind(base.Typed($type,base.Integer($value)),c11.types.character($raw),c11.pp.PPInt($value,0)),fail("string literal in C preprocessing expression"));
effect c11.pp.evaluate(c11.pp.Unary("!",$value)) => c11.pp.PPInt(not(c11.pp.truth(c11.pp.evaluate($value))),0);
effect c11.pp.evaluate(c11.pp.Unary("~",$value)) => bind(c11.pp.PPInt($integer,$unsigned),c11.pp.evaluate($value),c11.pp.checked(int.xor($integer,-1),$unsigned));
effect c11.pp.evaluate(c11.pp.Unary("-",$value)) => bind(c11.pp.PPInt($integer,$unsigned),c11.pp.evaluate($value),c11.pp.checked(int.neg($integer),$unsigned));
effect c11.pp.evaluate(c11.pp.Unary("+",$value)) => c11.pp.evaluate($value);
effect c11.pp.evaluate(c11.pp.Binary("&&",$a,$b)) => c11.pp.PPInt(choose(c11.pp.truth(c11.pp.evaluate($a)),c11.pp.truth(c11.pp.evaluate($b)),0),0);
effect c11.pp.evaluate(c11.pp.Binary("||",$a,$b)) => c11.pp.PPInt(choose(c11.pp.truth(c11.pp.evaluate($a)),1,c11.pp.truth(c11.pp.evaluate($b))),0);
effect c11.pp.evaluate(c11.pp.ConditionalExpr($a,$b,$c)) => c11.pp.convert(choose(c11.pp.truth(c11.pp.evaluate($a)),c11.pp.evaluate($b),c11.pp.evaluate($c)),or(c11.pp.signedness($b),c11.pp.signedness($c)));
effect c11.pp.evaluate(c11.pp.Binary($operator,$a,$b)) when and(not(eq($operator,"&&")),not(eq($operator,"||"))) => c11.pp.binary($operator,c11.pp.evaluate($a),c11.pp.evaluate($b));
effect c11.pp.checked($value,1) => c11.pp.PPInt(int.and($value,sub(int.shl(1,64),1)),1);
effect c11.pp.checked($value,0) => choose(int.fits($value,64,1),c11.pp.PPInt($value,0),fail("signed overflow in C preprocessing expression"));
effect c11.pp.convert(c11.pp.PPInt($value,$from),$to) => c11.pp.checked($value,$to);
effect c11.pp.signedness(c11.pp.Number($raw)) => arg(c11.pp.number($raw),1);
effect c11.pp.signedness(c11.pp.Character($raw)) => 0;
effect c11.pp.signedness(c11.pp.Unary("!",$value)) => 0;
effect c11.pp.signedness(c11.pp.Unary($operator,$value)) when not(eq($operator,"!")) => c11.pp.signedness($value);
effect c11.pp.signedness(c11.pp.Binary($operator,$a,$b)) => choose(c11.pp.comparison($operator),0,
    choose(or(eq($operator,"&&"),eq($operator,"||")),0,choose(or(eq($operator,"<<"),eq($operator,">>")),c11.pp.signedness($a),or(c11.pp.signedness($a),c11.pp.signedness($b)))));
effect c11.pp.signedness(c11.pp.ConditionalExpr($a,$b,$c)) => or(c11.pp.signedness($b),c11.pp.signedness($c));
effect c11.pp.comparison($operator) => or(or(eq($operator,"=="),eq($operator,"!=")),or(or(eq($operator,"<"),eq($operator,">")),or(eq($operator,"<="),eq($operator,">="))));
effect c11.pp.binary("<<",c11.pp.PPInt($a,$unsigned),c11.pp.PPInt($b,$bu)) => c11.pp.checked(c11.pp.shift("<<",$a,$b),$unsigned);
effect c11.pp.binary(">>",c11.pp.PPInt($a,$unsigned),c11.pp.PPInt($b,$bu)) => c11.pp.checked(c11.pp.shift(">>",$a,$b),$unsigned);
effect c11.pp.shift($operator,$value,$count) => choose(and(not(lt($count,0)),lt($count,64)),
    choose(eq($operator,"<<"),int.shl($value,$count),int.shr($value,$count)),fail("invalid C preprocessing shift count"));
effect[fallback] c11.pp.binary($operator,c11.pp.PPInt($a,$au),c11.pp.PPInt($b,$bu)) => bind($unsigned,or($au,$bu),
    bind(c11.pp.PPInt($left,$lu),c11.pp.checked($a,$unsigned),bind(c11.pp.PPInt($right,$ru),c11.pp.checked($b,$unsigned),
        c11.pp.checked(c11.pp.calculate($operator,$left,$right),choose(c11.pp.comparison($operator),0,$unsigned)))));
effect c11.pp.calculate("+",$a,$b) => int.add($a,$b);
effect c11.pp.calculate("-",$a,$b) => int.sub($a,$b);
effect c11.pp.calculate("*",$a,$b) => int.mul($a,$b);
effect c11.pp.calculate("/",$a,$b) => int.div($a,$b);
effect c11.pp.calculate("%",$a,$b) => int.rem($a,$b);
effect c11.pp.calculate("&",$a,$b) => int.and($a,$b);
effect c11.pp.calculate("|",$a,$b) => int.or($a,$b);
effect c11.pp.calculate("^",$a,$b) => int.xor($a,$b);
effect c11.pp.calculate("==",$a,$b) => eq($a,$b);
effect c11.pp.calculate("!=",$a,$b) => not(eq($a,$b));
effect c11.pp.calculate("<",$a,$b) => int.lt($a,$b);
effect c11.pp.calculate(">",$a,$b) => int.lt($b,$a);
effect c11.pp.calculate("<=",$a,$b) => not(int.lt($b,$a));
effect c11.pp.calculate(">=",$a,$b) => not(int.lt($a,$b));
