effect c11.abi.prepare_callee(Direct($name),$env) => Direct($name);
effect c11.abi.prepare_callee(Through($target),$env) => IndirectTarget(base.lower($target,$env));
effect c11.abi.callee_operands(Direct($name),$args) => $args;
effect c11.abi.callee_operands(IndirectTarget($pointer),$args) => list.prepend($pointer,$args);
effect c11.abi.callee_attrs(Direct($name)) => [RawAttr("callee",concat("@",text.quote($name)))];
effect c11.abi.callee_attrs(IndirectTarget($pointer)) => [];
