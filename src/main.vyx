module naru;
use std.collections;
use std.string;
use std.fs;
use std.log;

extern "C" {
    fn naru_same_file(first: rawptr, first_len: i64, second: rawptr, second_len: i64) -> i32;
    fn naru_mlir_open(path: rawptr, length: i64) -> i32;
}

fn naru_error(message: string) {
    log_error(message);
    log_flush();
}

fn naru_storage_log(e: &mut Engine) {
    log_debug("arena nodes=" + naru_number(e.nodes.len) + " free=" + naru_number(e.free_nodes.len)
        + " edges=" + naru_number(e.edges.len) + " free=" + naru_number(e.free_edges.len)
        + " indexes=" + naru_number(e.env_index.len) + " free=" + naru_number(e.free_env_index.len)
        + " interned=" + naru_number(e.text_pool.len));
}

fn naru_log_level(name: string) -> i32 {
    if (name == "trace") { return log_level_trace(); }
    if (name == "debug") { return log_level_debug(); }
    if (name == "info") { return log_level_info(); }
    if (name == "warn") { return log_level_warn(); }
    if (name == "error") { return log_level_error(); }
    return -1;
}

fn usage() {
    print("Naru 0.2.0 - extensible AOT compiler with in-process MLIR/LLVM/LLD");
    print("naru parse|check|emit <source> --rules <file.stx> [--rules ...]");
    print("naru eval --rules <file.stx> --expr 'relation(Term(...))'");
    print("naru build <source> --rules <file.stx> -o <artifact> [--target mlir|exe|profile.json]");
    print("naru opt <file.mlir> -o <artifact> [--target mlir|bytecode|llvm-ir|object|exe|profile.json]");
    print("naru freeze --rules <file.stx> -o <specialized.vyx>");
    print("naru build|resolve --project <directory|Naru.toml> [--locked]");
    print("Options: --entry item --relation emit --unit item|program --project Naru.toml --pass-pipeline PIPELINE");
    print("         --irdl FILE --dialect-plugin DLL --pass-plugin DLL --backend-library DLL");
    print("         --native-entry main --triple TRIPLE --cpu CPU --features FEATURES --opt-level 0|1|2|3|s|z");
    print("         --link-object FILE --link-library NAME|FILE --library-path DIR --runtime freestanding|crt-static|crt-dynamic");
    print("         --frontend RELATION --frontend-option key=value (raw source frontend defined by rules)");
    print("         --rule-budget STEPS --parse-budget STEPS (aliases: --rule-steps/--parse-steps; default 1000000)");
    print("         --rule-depth DEPTH --parse-depth DEPTH (1..1024, default 256)");
    print("         --log-level trace|debug|info|warn|error (diagnostics on stderr)");
    print("emit verifies MLIR; build optimizes and emits entirely in process.");
}

fn json_quote(text: string) -> string {
    var out = "\""; var i: i64 = 0;
    let hex = "0123456789abcdef";
    while (i < text.len) {
        let c = str_char_at(text, i);
        if (c == 34 || c == 92) { out = out + "\\" + text.substring(i, i + 1); }
        else if (c >= 0 && c < 32) {
            out = out + "\\u00" + hex.substring((c / 16) as i64, (c / 16) as i64 + 1)
                + hex.substring((c % 16) as i64, (c % 16) as i64 + 1);
        } else { out = out + text.substring(i, i + 1); }
        i = i + 1;
    }
    return out + "\"";
}

fn backend_configuration(e: &mut Engine, target: string, input: string, project: string, output: string,
    command: string, options: &mut Vec<string>) -> string {
    var out = "{\"target\":" + json_quote(target) + ",\"output\":" + json_quote(output) + ",\"source_inputs\":[";
    var separated = false; var i: i64 = 0;
    if (input.len > 0) { out = out + json_quote(naru_absolute_path(input)); separated = true; }
    if (project.len > 0) { out = out + (separated ? "," : "") + json_quote(naru_absolute_path(project)); separated = true; }
    while (i < e.modules.len) {
        out = out + (separated ? "," : "") + json_quote(e.modules.get(i).path);
        separated = true; i = i + 1;
    }
    i = 0;
    while (i < e.source_paths.len) {
        out = out + (separated ? "," : "") + json_quote(e.source_paths.get(i));
        separated = true; i = i + 1;
    }
    i = 0;
    while (i < e.project_inputs.len) {
        out = out + (separated ? "," : "") + json_quote(e.project_inputs.get(i)); separated = true; i = i + 1;
    }
    out = out + "]";
    // These extension options can repeat; keep their order within each list.
    var group: i64 = 0;
    while (group < 6) {
        let flag = group == 0 ? "--irdl" : (group == 1 ? "--dialect-plugin" : (group == 2 ? "--pass-plugin"
            : (group == 3 ? "--link-object" : (group == 4 ? "--link-library" : "--library-path"))));
        let key = group == 0 ? "irdl" : (group == 1 ? "dialect_plugins" : (group == 2 ? "pass_plugins"
            : (group == 3 ? "link_objects" : (group == 4 ? "link_libraries" : "library_paths"))));
        out = out + "," + json_quote(key) + ":["; separated = false; i = 0;
        while (i + 1 < options.len) {
            if (options.get(i) == flag) {
                out = out + (separated ? "," : "") + json_quote(options.get(i + 1)); separated = true;
            }
            i = i + 2;
        }
        out = out + "]"; group = group + 1;
    }
    i = 0;
    while (i + 1 < options.len) {
        let flag = options.get(i);
        if (flag != "--irdl" && flag != "--dialect-plugin" && flag != "--pass-plugin"
            && flag != "--link-object" && flag != "--link-library" && flag != "--library-path") {
            var last = true; var j = i + 2;
            while (j + 1 < options.len) { if (options.get(j) == flag) { last = false; } j = j + 2; }
            if (last && (command == "build" || command == "opt" || flag != "--pass-pipeline")) {
                let key = flag == "--pass-pipeline" ? "pipeline" : str_replace(flag.substring(2, flag.len), "-", "_");
                out = out + "," + json_quote(key) + ":" + json_quote(options.get(i + 1));
            }
        }
        i = i + 2;
    }
    if (command != "build" && command != "opt") { out = out + ",\"pipeline\":\"\""; }
    if (command == "emit") { out = out + ",\"generic_output\":true"; }
    return out + "}";
}

public fn project_comments(source: string) -> string {
    var out = std.string.StringBuilder.create();
    var in_string = false; var escaped = false; var comment = false;
    var i: i64 = 0;
    while (i < source.len) {
        let c = str_char_at(source, i);
        if (comment) {
            if (c == 10) { comment = false; out.appendChar(c); }
            else { out.appendChar(32); }
        } else if (!in_string && c == 35) { comment = true; out.appendChar(32); }
        else {
            out.appendChar(c);
            if (in_string && escaped) { escaped = false; }
            else if (in_string && c == 92) { escaped = true; }
            else if (c == 34) { in_string = !in_string; }
        }
        i = i + 1;
    }
    let result = out.build();
    return str_dup(result.as_str());
}


public fn same_path(first: string, second: string) -> bool {
    if (first.len == 0 || second.len == 0) { return false; }
    let absolute_first = naru_absolute_path(first);
    let absolute_second = naru_absolute_path(second);
    if (absolute_first.len > 0 && absolute_second.len > 0
        && str_to_lower(absolute_first) == str_to_lower(absolute_second)) { return true; }
    return naru_same_file(first.c_str(), first.len, second.c_str(), second.len) != 0;
}

fn output_is_source(e: &mut Engine, output: string, input: string, project: string) -> bool {
    if (output.len == 0) { return false; }
    if (same_path(output, input) || same_path(output, project)) { return true; }
    var i: i64 = 0;
    while (i < e.modules.len) {
        if (same_path(output, e.modules.get(i).path)) { return true; }
        i = i + 1;
    }
    i = 0;
    while (i < e.source_paths.len) {
        if (same_path(output, e.source_paths.get(i))) { return true; }
        i = i + 1;
    }
    i = 0;
    while (i < e.project_inputs.len) { if (same_path(output, e.project_inputs.get(i))) { return true; } i = i + 1; }
    return false;
}

fn validate_output_paths(e: &mut Engine, output: string, input: string, project: string, command: string,
    backend_args: &mut Vec<string>) -> bool {
    if (output_is_source(e, output, input, project)) {
        e.reject("output would overwrite a source or project file"); return false;
    }
    var i: i64 = 0;
    while (i + 1 < backend_args.len) {
        if (backend_args.get(i) == "--report") {
            let report = backend_args.get(i + 1);
            if (output_is_source(e, report, input, project)
                || same_path(report, output)) {
                e.reject("report would overwrite a source, project or artifact file"); return false;
            }
        }
        i = i + 2;
    }
    return true;
}

fn evaluation_budget(e: &mut Engine, text: string) -> i64 {
    var value: i64 = 0; var i: i64 = 0;
    while (i < text.len) {
        let c = str_char_at(text, i);
        if (!naru_digit(c) || value > 100000000) { e.reject("evaluation budget must be between 1 and 1000000000 steps"); return 0; }
        value = value * 10 + (c - 48) as i64; i = i + 1;
    }
    if (value < 1 || value > 1000000000) { e.reject("evaluation budget must be between 1 and 1000000000 steps"); return 0; }
    return value;
}

fn evaluation_depth(e: &mut Engine, text: string) -> i64 {
    var value: i64 = 0; var i: i64 = 0;
    while (i < text.len) {
        let c = str_char_at(text,i);
        if (!naru_digit(c) || value > 1024) { e.reject("evaluation depth must be between 1 and 1024"); return 0; }
        value = value * 10 + (c - 48) as i64; i = i + 1;
    }
    if (value < 1 || value > 1024) { e.reject("evaluation depth must be between 1 and 1024"); return 0; }
    return value;
}

fn naru_command() -> i32 {
    if (argCount() < 2) { usage(); return 0; }
    let command = getArg(1);
    if (command == "help" || command == "--help" || command == "--version") { usage(); return 0; }
    if (command != "parse" && command != "check" && command != "emit" && command != "eval"
        && command != "build" && command != "freeze" && command != "opt" && command != "resolve") { naru_error("unknown command: " + command); return 2; }
    var e = Engine.new();
    var rules = Vec::<string>.new();
    var backend_args = Vec::<string>.new();
    var frontend_args = Vec::<string>.new();
    var settings = Dict::<string, string>.new();
    var graph = ProjectGraph.new(); var locked = false;
    var input = ""; var output = ""; var expression = ""; var entry = ""; var relation = ""; var unit = "";
    var project = ""; var target = ""; var backend_library = ""; var frontend = "";
    var rule_budget = ""; var parse_budget = ""; var rule_depth = ""; var parse_depth = "";
    var index: i32 = 2;
    while (index < argCount()) {
        let arg = getArg(index);
        if (arg == "--locked") { locked = true; index = index + 1; continue; }
        if (!arg.starts_with("-")) {
            if (input.len > 0) { naru_error("unexpected argument: " + arg); return 2; }
            input = arg; index = index + 1; continue;
        }
        if (index + 1 >= argCount()) { naru_error("missing value for " + arg); return 2; }
        let value = getArg(index + 1);
        if (arg == "--rules") { rules.push(value); }
        else if (arg == "--entry") { entry = value; }
        else if (arg == "--relation") { relation = value; }
        else if (arg == "--unit") { unit = value; }
        else if (arg == "-o" || arg == "--output") { output = value; }
        else if (arg == "--expr") { expression = value; }
        else if (arg == "--project") { project = value; }
        else if (arg == "--target") { target = value; }
        else if (arg == "--backend-library") { backend_library = value; }
        else if (arg == "--frontend") { frontend = value; }
        else if (arg == "--frontend-option") { frontend_args.push(value); }
        else if (arg == "--rule-budget" || arg == "--rule-steps") { rule_budget = value; }
        else if (arg == "--parse-budget" || arg == "--parse-steps") { parse_budget = value; }
        else if (arg == "--rule-depth") { rule_depth = value; }
        else if (arg == "--parse-depth") { parse_depth = value; }
        else if (arg == "--log-level") {
            let level = naru_log_level(value);
            if (level < 0) { naru_error("invalid log level: " + value); return 2; }
            set_log_level(level);
        }
        else if (arg == "--pass-pipeline" || arg == "--irdl" || arg == "--dialect-plugin" || arg == "--pass-plugin" || arg == "--report" || arg == "--opt-level"
            || arg == "--lowering-pipeline" || arg == "--native-entry" || arg == "--triple" || arg == "--cpu" || arg == "--features"
            || arg == "--link-object" || arg == "--link-library" || arg == "--library-path" || arg == "--runtime"
            || arg == "--subsystem" || arg == "--vc-tools-dir" || arg == "--windows-sdk-dir" || arg == "--windows-sdk-version") {
            backend_args.push(arg); backend_args.push(value);
        } else { naru_error("unknown option: " + arg); return 2; }
        index = index + 2;
    }
    if (command != "opt" && project.len == 0 && rules.len == 0 && !specialized_available()) { project = discover_project(); }
    if (project.len > 0) { project = project_manifest_path(project); }
    let explicit_rule_count = rules.len;
    if (project.len > 0 && !read_project(&mut e, project, &mut rules, &mut settings, &mut graph)) { naru_error(e.diagnostic); return 1; }
    if (rule_budget.len == 0 && settings.contains("limits.rule_steps")) { rule_budget = settings.get("limits.rule_steps"); }
    if (parse_budget.len == 0 && settings.contains("limits.parse_steps")) { parse_budget = settings.get("limits.parse_steps"); }
    if (rule_budget.len > 0) { e.rule_limit = evaluation_budget(&mut e, rule_budget); }
    if (parse_budget.len > 0) { e.parse_limit = evaluation_budget(&mut e, parse_budget); }
    if (rule_depth.len == 0 && settings.contains("limits.rule_depth")) { rule_depth = settings.get("limits.rule_depth"); }
    if (parse_depth.len == 0 && settings.contains("limits.parse_depth")) { parse_depth = settings.get("limits.parse_depth"); }
    if (rule_depth.len > 0) { e.rule_depth_limit = evaluation_depth(&mut e,rule_depth); }
    if (parse_depth.len > 0) { e.parse_depth_limit = evaluation_depth(&mut e,parse_depth); }
    if (!e.good()) { naru_error(e.diagnostic); return 2; }
    if (graph.root >= 0) {
        var combined = Vec::<string>.new(); project_backend_options(&mut graph, &mut combined); var option_index: i64 = 0;
        while (option_index < backend_args.len) { combined.push(backend_args.get(option_index)); option_index = option_index + 1; }
        backend_args = combined;
    }
    if (entry.len == 0) { entry = settings.contains("language.entry") ? settings.get("language.entry") : "item"; }
    if (relation.len == 0 && settings.contains("language.relation")) { relation = settings.get("language.relation"); }
    if (frontend.len == 0 && settings.contains("language.frontend")) { frontend = settings.get("language.frontend"); }
    if (unit.len == 0) { unit = settings.contains("language.unit") ? settings.get("language.unit") : "item"; }
    if (unit != "item" && unit != "program") { naru_error("language unit must be item or program"); return 2; }
    if (input.len == 0 && settings.contains("package.entry")) { input = naru_join_path(naru_dirname(project), settings.get("package.entry")); }
    if (target.len == 0) {
        target = settings.contains("backend.target") ? settings.get("backend.target") : "mlir";
        if (target != "mlir" && target != "bytecode" && target != "llvm-ir" && target != "object" && target != "exe") { target = naru_join_path(naru_dirname(project), target); }
    }
    if (command == "build" && output.len == 0 && project.len > 0) {
        if (settings.contains("build.output")) { output = naru_join_path(naru_dirname(project), settings.get("build.output")); }
        else {
            let directory = settings.contains("build.output_dir") ? settings.get("build.output_dir") : "target";
            let extension = target == "exe" ? ".exe" : (target == "object" ? ".obj" : (target == "llvm-ir" ? ".ll" : (target == "bytecode" ? ".mlirbc" : ".mlir")));
            output = naru_join_path(naru_dirname(project), naru_join_path(directory, settings.get("package.name") + extension));
        }
    }
    if (backend_library.len > 0 && naru_mlir_open(backend_library.c_str(), backend_library.len) != 0) { naru_error(str_dup(from_cstr(naru_mlir_error(null)))); return 1; }
    if (command == "opt") {
        if (input.len == 0 || output.len == 0) { naru_error("opt requires an MLIR input and -o <artifact>"); return 2; }
        if (!validate_output_paths(&mut e, output, input, project, command, &mut backend_args)) { naru_error(e.diagnostic); return 2; }
        let text = naru_read_text(&mut e, input);
        if (!e.good()) { naru_error(e.diagnostic); return 1; }
        if (backend_library.len > 0 && naru_mlir_open(backend_library.c_str(), backend_library.len) != 0) {
            naru_error(str_dup(from_cstr(naru_mlir_error(null)))); return 1;
        }
        let configuration = backend_configuration(&mut e, target, input, project, output, command, &mut backend_args);
        var session = new_mlir_session(&mut e, configuration);
        if (e.good()) { parse_mlir_session(&mut e, &mut session, text, input); }
        let success = e.good() && compile_mlir_session(&mut e, &mut session, target, output);
        session.close();
        if (!success || !e.good()) { naru_error(e.diagnostic); return 1; }
        log_info("naru: wrote " + output + " (in-process MLIR/LLVM/LLD)"); return 0;
    }
    if (command == "resolve" && graph.root >= 0 && rules.len == 0) {
        if (!validate_output_paths(&mut e, output, input, project, command, &mut backend_args)) { naru_error(e.diagnostic); return 2; }
        if (!project_lock(&mut e, &mut graph, locked)) { naru_error(e.diagnostic); return 1; }
        print(project_lock_text(&mut e, &mut graph)); return e.good() ? 0 : 1;
    }
    if (specialized_available()) {
        specialized_load(&mut e);
        if (graph.root >= 0 || explicit_rule_count > 0) { e.linked = false; }
        if (graph.root >= 0 && e.good()) {
            var project_rules = Vec::<string>.new(); var project_index = explicit_rule_count;
            while (project_index < rules.len) { project_rules.push(rules.get(project_index)); project_index = project_index + 1; }
            validate_frozen_project(&mut e, &mut project_rules);
        }
        if (explicit_rule_count > 0 && e.good()) {
            var extension_index: i64 = 0;
            while (extension_index < explicit_rule_count && e.good()) {
                load_frozen_extension(&mut e, rules.get(extension_index)); extension_index = extension_index + 1;
            }
        }
        if (!e.linked && e.good()) { link_rules(&mut e); }
    } else {
        if (rules.len == 0) { naru_error("select a dialect group with --rules or --project"); return 2; }
        var i: i64 = 0;
        while (i < rules.len && e.good()) { load_rule_file(&mut e, rules.get(i)); i = i + 1; }
        if (e.good()) { link_rules(&mut e); }
    }
    if (!e.good()) { naru_error(e.diagnostic); return 1; }
    if (!validate_output_paths(&mut e, output, input, project, command, &mut backend_args)) { naru_error(e.diagnostic); return 2; }
    if (graph.root >= 0 && (command == "build" || command == "resolve" || command == "freeze" || locked)) {
        if (!project_lock(&mut e, &mut graph, locked)) { naru_error(e.diagnostic); return 1; }
    } else if (locked) { naru_error("--locked requires a project"); return 2; }
    if (command == "resolve") {
        if (graph.root < 0) { naru_error("resolve requires a project"); return 2; }
        print(project_lock_text(&mut e, &mut graph)); return e.good() ? 0 : 1;
    }
    if (!validate_output_paths(&mut e, output, input, project, command, &mut backend_args)) { naru_error(e.diagnostic); return 2; }
    if (command == "freeze") {
        if (output.len == 0) { naru_error("freeze requires -o specialized.vyx"); return 2; }
        if (!write_specialization(&mut e, output)) { naru_error(e.diagnostic); return 1; }
        log_info("generated native effect rules: " + output); return 0;
    }
    log_debug("linked " + naru_number(e.modules.len) + " rule modules, "
        + naru_number(e.effect_rules.len) + " effect rules");
    var rt = new_runtime(&mut e);
    rt.specialized = specialized_available();
    if (command == "eval") {
        if (expression.len == 0) { naru_error("eval requires --expr"); return 2; }
        var stream = tokenize(expression, "<command>");
        let root = stx_term(&mut e, &mut stream, 0);
        if (stream.diagnostic.len > 0) { e.reject(stream.diagnostic); }
        if (stream.peek().kind != 0) { e.reject("trailing tokens after --expr"); }
        if (root >= 0 && e.good()) { qualify_expression(&mut e, root, ""); }
        if (!e.good()) { naru_error(e.diagnostic); return 1; }
        let value = eval_term(&mut e, &mut rt, root, 0);
        if (!e.good()) { naru_error(e.diagnostic); return 1; }
        log_debug("rule evaluation completed in " + naru_number(rt.steps) + " steps");
        naru_storage_log(&mut e);
        print(render_term(&mut e, value)); return 0;
    }
    if (input.len == 0 || !fileExists(input)) { naru_error("source file not found: " + input); return 2; }
    var items: i64 = -1;
    if (frontend.len == 0) { items = load_program(&mut e, input, entry); }
    else {
        var options = e.add_node(11, "env", input, 1, 1);
        let keys = naru_text_keys(&settings); var option_index: i64 = 0;
        while (option_index < keys.len) {
            let key = keys.get(option_index);
            if (key.starts_with("frontend.")) {
                options = env_insert(&mut e, options, e.add_node(1, key.substring(9, key.len), input, 1, 1),
                    e.add_node(1, settings.get(key), input, 1, 1));
            }
            option_index = option_index + 1;
        }
        options = env_insert(&mut e, options, e.add_node(1, "project_directory", input, 1, 1),
            e.add_node(1, project.len > 0 ? naru_dirname(project) : naru_dirname(naru_absolute_path(input)), input, 1, 1));
        options = env_insert(&mut e, options, e.add_node(1, "target_configuration", input, 1, 1),
            e.add_node(1, backend_configuration(&mut e, target, input, project, output, command, &mut backend_args), input, 1, 1));
        option_index = 0;
        while (option_index < frontend_args.len && e.good()) {
            let value = frontend_args.get(option_index); var split: i64 = 0;
            while (split < value.len && str_char_at(value, split) != 61) { split = split + 1; }
            if (split == 0 || split == value.len) { e.reject("--frontend-option requires key=value"); }
            else { options = env_insert(&mut e, options, e.add_node(1, value.substring(0, split), input, 1, 1),
                e.add_node(1, value.substring(split + 1, value.len), input, 1, 1)); }
            option_index = option_index + 1;
        }
        if (e.good()) { items = load_frontend_program(&mut e, &mut rt, input, frontend, options); }
    }
    if (!e.good()) { naru_error(e.diagnostic); return 1; }
    if (!validate_output_paths(&mut e, output, input, project, command, &mut backend_args)) { naru_error(e.diagnostic); return 2; }
    if (command == "parse") { naru_storage_log(&mut e); print(render_term(&mut e, items)); return 0; }
    if ((command == "emit" || command == "build") && relation.len == 0) { relation = "emit"; }
    if (relation.len > 0) {
        let full_relation = resolve_entry(&mut e, relation);
        var i: i64 = 0;
        let count = unit == "program" ? 1 : e.node(items).count;
        while (i < count && e.good()) {
            var item = items;
            if (unit == "item") { item = e.child(items, i); }
            let origin = e.node(item);
            let call = e.add_node(4, full_relation, origin.file, origin.line, origin.column);
            e.add_child(call, item);
            let result = eval_term(&mut e, &mut rt, call, 0);
            if (command == "check" && e.good()) { print(render_term(&mut e, result)); }
            i = i + 1;
        }
    }
    if (!e.good()) { naru_error(e.diagnostic); return 1; }
    if (command == "check" && e.node(rt.active_region).count == 0) { print("check passed"); return 0; }
    if (command == "build" && output.len == 0) { naru_error("build requires -o <artifact>"); return 2; }
    if (backend_library.len > 0 && naru_mlir_open(backend_library.c_str(), backend_library.len) != 0) {
        naru_error(str_dup(from_cstr(naru_mlir_error(null)))); return 1;
    }
    naru_storage_log(&mut e);
    let configuration = backend_configuration(&mut e, target, input, project, output, command, &mut backend_args);
    var session = new_mlir_session(&mut e, configuration);
    if (e.good()) { import_mlir_graph(&mut e, &mut session, rt.active_region); }
    if (e.good()) { verify_mlir_session(&mut e, &mut session); }
    if (!e.good()) { session.close(); naru_error(e.diagnostic); return 1; }
    if (command == "check") { session.close(); print("check passed"); return 0; }
    if (command == "emit") {
        if (output.len > 0) {
            let success = compile_mlir_session(&mut e, &mut session, "mlir", output);
            session.close();
            if (!success || !e.good()) { naru_error(e.diagnostic); return 1; }
            return 0;
        }
        let ir = print_mlir_session(&mut e, &mut session);
        session.close();
        if (!e.good()) { naru_error(e.diagnostic); return 1; }
        print(ir); return 0;
    }
    let success = compile_mlir_session(&mut e, &mut session, target, output);
    session.close();
    if (!success || !e.good()) { naru_error(e.diagnostic); return 1; }
    log_info("naru: wrote " + output + " (in-process MLIR/LLVM/LLD)"); return 0;
}

fn main() -> i32 {
    set_log_level(log_level_info());
    let result = naru_command();
    log_flush();
    return result;
}
