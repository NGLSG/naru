effect c11.pp.target_macros($macros,$target) => choose(and(text.starts(env.get($target,"os"),"windows"),eq(env.get($target,"architecture"),"x86_64")),
    list.fold("c11.pp.predefine",[["_WIN32","1"],["_WIN64","1"],["_M_X64","100"],["_M_AMD64","100"],
        ["_INTEGRAL_MAX_BITS","64"]],$macros),$macros);
effect c11.pp.file($source,$path,$macros,$options,$stack,$depth) when lt(128,$depth) => fail("C include nesting exceeds 128");

// Each file uses context stored in the macro table under an opaque term key.
effect c11.pp.context($macros,$path,$options,$stack,$depth) => env.put($macros,c11.pp.ContextKey(),c11.pp.Context($path,$options,$stack,$depth));
effect c11.pp.file($source,$path,$macros,$options,$stack,$depth) when lt($depth,129)
    => choose(env.contains($macros,c11.pp.Once(text.lower($path))),[[],$macros],
        bind(c11.pp.State($result,$final,$conditions,$pending),list.fold("c11.pp.line_step",c11.pp.lines(c11.lex.tokens($source,$path)),
            c11.pp.State([],env.put(c11.pp.context($macros,$path,$options,list.prepend($path,$stack),$depth),c11.pp.LineMapKey(),c11.pp.LineMap($path,0)),[],[])),
            c11.pp.finish_file($result,$final,$conditions,$pending,$path,$options,$stack,$depth)));
effect c11.pp.finish_file($result,$macros,[],$pending,$path,$options,$stack,$depth)
    => bind(c11.pp.State($chunks,$final,$conditions,$empty),c11.pp.flush(c11.pp.State($result,$macros,[],$pending)),
        [list.flatten(list.reverse($chunks)),$final]);
effect c11.pp.finish_file($result,$macros,$conditions,$pending,$path,$options,$stack,$depth) when lt(0,size($conditions))
    => source.error($path,1,1,"unterminated C conditional directive");

// Split once at newlines; ordinary lines are accumulated until a directive so
// function-like macro calls can cross physical/logical lines.
effect c11.pp.lines($tokens) => bind([$done,$line],list.fold("c11.pp.split_line",$tokens,[[],[]]),
    list.reverse(list.prepend(list.reverse($line),$done)));
effect c11.pp.split_line([$done,$line],$token) => choose(eq(c11.lex.kind($token),7),
    [list.prepend(list.reverse($line),$done),[]],[$done,list.prepend($token,$line)]);
effect c11.pp.active([]) => 1;
effect c11.pp.active($conditions) when lt(0,size($conditions)) => bind(c11.pp.Conditional($parent,$taken,$active,$else),list.head($conditions),$active);
effect c11.pp.line_step(c11.pp.State($output,$macros,$conditions,$pending),[]) => c11.pp.State($output,$macros,$conditions,$pending);
effect c11.pp.line_step(c11.pp.State($output,$macros,$conditions,$pending),$line) when lt(0,size($line))
    => c11.pp.mapped_line(c11.pp.State($output,$macros,$conditions,$pending),c11.pp.remap($line,env.get($macros,c11.pp.LineMapKey())));
effect c11.pp.remap($line,$mapping) => bind(c11.pp.Mapping($reversed,$map),list.fold("c11.pp.remap_one",$line,c11.pp.Mapping([],$mapping)),list.reverse($reversed));
effect c11.pp.remap_one(c11.pp.Mapping($out,c11.pp.LineMap($file,0)),$token) when eq(arg($token,2),$file)
    => c11.pp.Mapping(list.prepend($token,$out),c11.pp.LineMap($file,0));
effect[fallback] c11.pp.remap_one(c11.pp.Mapping($out,c11.pp.LineMap($file,$offset)),[$kind,$raw,$path,$line,$column,$space])
    => c11.pp.Mapping(list.prepend([$kind,$raw,$file,add($line,$offset),$column,$space],$out),c11.pp.LineMap($file,$offset));
effect c11.pp.mapped_line(c11.pp.State($output,$macros,$conditions,$pending),$line)
    => choose(eq(c11.lex.spelling(list.head($line)),"#"),
        c11.pp.directive(c11.pp.flush(c11.pp.State($output,$macros,$conditions,$pending)),list.tail($line),list.head($line)),
        choose(c11.pp.active($conditions),c11.pp.State($output,$macros,$conditions,list.prepend($line,$pending)),c11.pp.State($output,$macros,$conditions,$pending)));
effect c11.pp.flush(c11.pp.State($out,$macros,$conditions,$pending))
    => bind(c11.pp.Marked($input,$unused),c11.pp.mark(c11.pp.pending_tokens($pending),env.empty()),
        bind([$marked,$final],c11.pp.expand_marked_result($input,$macros,0),
            c11.pp.State(list.prepend(list.flatten(list.map("c11.pp.final_token",$marked)),$out),$final,$conditions,[])));
effect[fallback] c11.pp.final_token(c11.pp.MarkedToken($token,$hide)) => [$token];
effect c11.pp.pending_tokens($chunks) => list.flatten(list.reverse($chunks));
effect c11.pp.directive($state,[],$at) => $state;
effect c11.pp.directive($state,$tokens,$at) when lt(0,size($tokens)) => c11.pp.command(c11.lex.spelling(list.head($tokens)),list.tail($tokens),$state,$at);
effect c11.pp.command("if",$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => c11.pp.push_condition($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at);
effect c11.pp.command("ifdef",$tokens,$state,$at) => c11.pp.defined_condition($tokens,$state,$at,0);
effect c11.pp.command("ifndef",$tokens,$state,$at) => c11.pp.defined_condition($tokens,$state,$at,1);
effect c11.pp.defined_condition([$name],c11.pp.State($out,$macros,$conditions,$pending),$at,$invert)
    => seq(choose(eq(c11.lex.kind($name),1),1,c11.lex.error($at,"ifdef/ifndef requires one identifier")),
        bind($value,choose($invert,not(c11.pp.defined($macros,c11.lex.macro_key($name))),c11.pp.defined($macros,c11.lex.macro_key($name))),
            c11.pp.State($out,$macros,list.prepend(c11.pp.Conditional(c11.pp.active($conditions),$value,and(c11.pp.active($conditions),$value),0),$conditions),$pending)));
effect[fallback] c11.pp.defined_condition($tokens,$state,$at,$invert) => c11.lex.error($at,"ifdef/ifndef requires one identifier");
effect c11.pp.push_condition($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => bind($parent,c11.pp.active($conditions),bind([$value,$final],choose($parent,c11.pp.condition_result($tokens,$macros),[0,$macros]),
        c11.pp.State($out,$final,list.prepend(c11.pp.Conditional($parent,$value,and($parent,$value),0),$conditions),$pending)));
effect c11.pp.command("elif",$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(eq(size($conditions),0),c11.lex.error($at,"elif without if"),
        c11.pp.elif($tokens,$out,$macros,list.head($conditions),list.tail($conditions),$at));
effect c11.pp.elif($tokens,$out,$macros,c11.pp.Conditional($parent,$taken,$active,0),$rest,$at)
    => bind([$value,$final],choose(and($parent,not($taken)),c11.pp.condition_result($tokens,$macros),[0,$macros]),
        c11.pp.State($out,$final,list.prepend(c11.pp.Conditional($parent,or($taken,$value),$value,0),$rest),[]));
effect c11.pp.elif($tokens,$out,$macros,c11.pp.Conditional($parent,$taken,$active,1),$rest,$at) => c11.lex.error($at,"elif after else");
effect c11.pp.command("else",[],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(eq(size($conditions),0),c11.lex.error($at,"else without if"),
        c11.pp.else_branch($out,$macros,list.head($conditions),list.tail($conditions),$at));
effect c11.pp.else_branch($out,$macros,c11.pp.Conditional($parent,$taken,$active,0),$rest,$at)
    => c11.pp.State($out,$macros,list.prepend(c11.pp.Conditional($parent,1,and($parent,not($taken)),1),$rest),[]);
effect c11.pp.else_branch($out,$macros,c11.pp.Conditional($parent,$taken,$active,1),$rest,$at) => c11.lex.error($at,"duplicate else");
effect c11.pp.command("endif",[],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(eq(size($conditions),0),c11.lex.error($at,"endif without if"),c11.pp.State($out,$macros,list.tail($conditions),[]));
effect[fallback] c11.pp.command($name,$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => choose(c11.pp.active($conditions),c11.pp.enabled($name,$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at),c11.pp.State($out,$macros,$conditions,$pending));
effect c11.pp.enabled("define",$tokens,$state,$at) => c11.pp.define($tokens,$state,$at);
effect c11.pp.enabled("undef",[$name],c11.pp.State($out,$macros,$conditions,$pending),$at)
    => seq(choose(eq(c11.lex.kind($name),1),1,c11.lex.error($at,"undef requires an identifier")),
        c11.pp.State($out,env.put($macros,c11.lex.macro_key($name),c11.pp.Undefined()),$conditions,$pending));
effect c11.pp.enabled("include",$tokens,c11.pp.State($out,$macros,$conditions,$pending),$at)
    => c11.pp.include_at($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at,0);
effect c11.pp.enabled("include_next",$tokens,$state,$at) => c11.pp.include_at($tokens,$state,$at,1);
effect c11.pp.include_at($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at,$next)
    => bind([$expanded,$final],c11.pp.include_result($tokens,$macros),
        c11.pp.include_expanded($expanded,c11.pp.State($out,$final,$conditions,$pending),$at,$next));
effect c11.pp.include_expanded($tokens,c11.pp.State($out,$macros,$conditions,$pending),$at,$next)
