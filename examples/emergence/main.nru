extern "C" { fn puts(message: *char) -> i32; }
type Score = i32;
struct Point { x: Score; y: Score; }
enum Event { Empty; Hit(Point); Failure(i32); }

fn add<T>(a: T, b: T) -> T where T: Numeric { return a + b; }
fn identity<T>(value: T) -> T { return move value; }
fn increment(value: i32) -> i32 { return value + 1; }
fn apply(f: fn(i32) -> i32, value: i32) -> i32 { return f(value); }
fn consume(value: owned<Score>) -> Score {
    let view = &value;
    let result = *view;
    end view;
    return result;
}

fn main() -> Score {
    defer puts("Naru: composed rules complete");
    let cost: cents = add<cents>(19, 22);
    var values = [0, 0, 0];
    for i in 0 .. 3 { values[i] = apply(fn increment, i); }
    let event = Event::Hit(Point { x: (cost as i32), y: values[0] });
    let value = match event { Empty() => 0, Hit(point) => point.x + point.y, Failure(code) => code };
    let offset = 0;
    let adjust = fn [offset](input: Score) -> Score { return input + offset; };
    let owner = identity<owned<Score>>(own(adjust(value)));
    let loan = &mut owner;
    *loan = twice(21);
    end loan;
    return consume(move owner);
}
