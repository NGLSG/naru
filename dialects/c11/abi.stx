effect c11.abi.buffer(Indirect($type)) => mlir.op("llvm.alloca",[storage.integer(1,64)],["!llvm.ptr"],
    [RawAttr("elem_type",types.repr($type)),Attr("alignment",c11.abi.copy_alignment($type),"i64")],[]);
effect[fallback] c11.abi.buffer($class) => NoBuffer();
effect c11.abi.copy_alignment($type) => bind($alignment,c11.types.alignment($type),choose(lt($alignment,16),16,$alignment));
effect c11.abi.lower_arguments([],$buffers,$env) => [];
effect c11.abi.lower_arguments($args,$buffers,$env) when lt(0,size($args))
    => bind($argument,list.head($args),bind($value,base.lower($argument,$env),
        list.prepend(c11.abi.outgoing($value,c11.abi.argument_class($argument),list.head($buffers)),
