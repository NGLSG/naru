// after preprocessing. Pragmas inside a body need not become executable code.
effect[fallback] c11.pp.output_tokens($macros,$options) => [];
effect c11.pp.configure($options) => bind($target,headers.toolchain($options),seq(
    choose(and(and(text.starts(env.get($target,"os"),"windows"),eq(env.get($target,"architecture"),"x86_64")),
        text.starts(env.get($target,"environment"),"msvc")),1,
        fail("C ABI rule profile requires x86_64 Windows MSVC; select a matching C ABI profile")),
    c11.pp.configure_options(env.put(env.put($options,"target_facts",$target),"system_include_paths",choose(env.contains($options,"system_include_paths"),
        text.split(env.get($options,"system_include_paths"),"|"),env.get($target,"include_paths"))))));
effect c11.pp.configure_options($options) => arg(list.fold("c11.pp.apply_option_provider",collect("c11.pp.option_provider",[]),[$options,env.empty()]),0);
effect[fallback] c11.pp.option_provider() => NoOptionProvider();
effect c11.pp.apply_option_provider([$options,$seen],NoOptionProvider()) => [$options,$seen];
effect c11.pp.apply_option_provider([$options,$seen],OptionProvider($name,$relation))
    => choose(env.contains($seen,$name),fail(concat("duplicate C target option provider: ",$name)),[apply($relation,[$options]),env.put($seen,$name,1)]);
effect c11.pp.finish_header($header,$path,$macros,$options)
    => arg(list.fold("c11.pp.apply_macro_provider",collect("c11.pp.header_macro_provider",[$header,$path,$options]),[$macros,env.empty()]),0);
effect[fallback] c11.pp.header_macro_provider($header,$path,$options) => NoMacroProvider();
// Platform compatibility facts are C rule policy, never Naru keywords.
effect c11.pp.platform_macros($options) => choose(env.contains($options,"target_facts"),
    c11.pp.translation_macros(c11.pp.target_macros(c11.pp.initial(),env.get($options,"target_facts")),$options),c11.pp.translation_macros(c11.pp.initial(),$options));
