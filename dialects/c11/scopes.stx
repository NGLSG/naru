mod c11.scopes;
use c11.syntax;
use c11.declarators;
use c11.types;
use c11.layout;
use c11.lex;
use c11.sema;
use base;
use tree;
use c11.names;
use c11.objects;
use c11.enums;
use c11.initializers;
use c11.specifiers;
use c11.storage;
use name_scope;

// Grouping keeps original rows and coordinates. It is a rule-library parser
// driver: selected fragments still use the ordinary contextual grammar.
effect c11.scopes.parse($rows) => bind($nodes,c11.scopes.groups($rows),bind(FileState($context,$items),
    list.fold("c11.scopes.file_part",c11.scopes.file_parts($nodes),FileState(c11.names.initialize(env.empty()),[])),list.flatten(list.reverse($items))));
effect c11.scopes.groups($rows) => bind($stack,list.fold("c11.scopes.group_row",$rows,[c11.scopes.Frame([],[])]),
    choose(eq(size($stack),1),list.reverse(arg(list.head($stack),1)),fail("unclosed C delimiter")));
effect c11.scopes.group_row($stack,$row) => c11.scopes.group_spelling($stack,$row,c11.lex.spelling($row));
effect c11.scopes.group_spelling($stack,$row,$raw) when or(eq($raw,"("),or(eq($raw,"["),eq($raw,"{")))
    => list.prepend(c11.scopes.Frame($row,[]),$stack);
effect c11.scopes.group_spelling($stack,$row,$raw) when or(eq($raw,")"),or(eq($raw,"]"),eq($raw,"}")))
    => choose(lt(1,size($stack)),bind(c11.scopes.Frame($open,$children),list.head($stack),
        choose(eq(c11.scopes.close_of(c11.lex.spelling($open)),$raw),c11.scopes.push_node(list.tail($stack),Group($open,list.reverse($children),$row)),
            c11.lex.error($row,"mismatched C delimiter"))),c11.lex.error($row,"unexpected C closing delimiter"));
effect[fallback] c11.scopes.group_spelling($stack,$row,$raw) => c11.scopes.push_node($stack,Token($row));
effect c11.scopes.push_node($stack,$node) => bind(c11.scopes.Frame($open,$children),list.head($stack),
    list.prepend(c11.scopes.Frame($open,list.prepend($node,$children)),list.tail($stack)));
effect c11.scopes.close_of("(") => ")";
effect c11.scopes.close_of("[") => "]";
effect c11.scopes.close_of("{") => "}";
effect c11.scopes.raw(Token($row)) => c11.lex.spelling($row);
effect c11.scopes.raw(Group($open,$children,$close)) => c11.lex.spelling($open);
effect c11.scopes.rows($nodes) => list.flatten(list.map("c11.scopes.node_rows",$nodes));
effect c11.scopes.node_rows(Token($row)) => [$row];
effect c11.scopes.node_rows(Group($open,$children,$close)) => list.concat([$open],list.concat(c11.scopes.rows($children),[$close]));
effect c11.scopes.first_row(Token($row)) => $row;
effect c11.scopes.first_row(Group($open,$children,$close)) => $open;
effect c11.scopes.expression($nodes,$category,$context)
    => bind($items,source.parse_tokens(c11.scopes.rows($nodes),$category,$context,"c11.scopes.identity_commit"),
        choose(eq(size($items),1),list.head($items),fail("C fragment requires exactly one grammatical item")));
effect c11.scopes.identity_commit($context,$item) => [$context,[$item]];
syntax c11.statement `$name:ident` when env.contains(syntax.context(),StatementKey($name)) => env.get(syntax.context(),StatementKey($name));
effect c11.scopes.synthetic($at,$name) => Token(c11.lex.made(1,$name,$at));

// File items end at a top-level semicolon, function body, or MSVC pack item.
effect c11.scopes.file_parts($nodes) => bind(Parts($out,$current),list.fold("c11.scopes.file_split",$nodes,Parts([],[])),
    choose(eq(size($current),0),list.reverse($out),fail("unterminated C file declaration")));
effect c11.scopes.file_split(Parts($out,$current),$node) => choose(eq(c11.scopes.raw($node),";"),
    choose(old_parameter_header(list.reverse($current)),Parts($out,list.prepend($node,$current)),
        Parts(list.prepend(FileDeclaration(list.reverse(list.prepend($node,$current))),$out),[])),
    choose(and(eq(c11.scopes.raw($node),"{"),c11.scopes.function_body_prefix($current)),
        Parts(list.prepend(FileFunction(list.reverse($current),$node),$out),[]),
        choose(and(eq(c11.scopes.raw($node),"("),c11.scopes.pack_prefix($current)),
            Parts(list.prepend(FileDeclaration(list.reverse(list.prepend($node,$current))),$out),[]),
            Parts($out,list.prepend($node,$current)))));
effect c11.scopes.function_body_prefix([]) => 0;
effect c11.scopes.function_body_prefix($current) when choose(lt(0,size($current)),eq(c11.scopes.raw(list.head($current)),"("),0) => and(eq(c11.scopes.raw(list.head($current)),"("),
    not(list.fold("c11.scopes.has_assignment",$current,0)));
effect c11.scopes.function_body_prefix($current) when choose(lt(0,size($current)),not(eq(c11.scopes.raw(list.head($current)),"(")),0)
    => old_parameter_header(list.reverse($current));
effect old_parameter_header($nodes) => choose(list.fold("c11.scopes.has_assignment",$nodes,0),0,old_parameter_scan($nodes,""));
effect old_parameter_scan([],$previous) => 0;
effect old_parameter_scan($nodes,$previous) when lt(0,size($nodes)) => choose(old_function_group($nodes,$previous),
    lt(0,size(list.tail($nodes))),old_parameter_scan(list.tail($nodes),raw(list.head($nodes))));
effect old_identifier_group(Group($open,$children,$close))
    => and(eq(c11.lex.spelling($open),"("),and(lt(0,size($children)),old_identifier_nodes($children)));
effect[fallback] old_identifier_group($node) => 0;
effect old_identifier_nodes([]) => 1;
effect old_identifier_nodes($nodes) when lt(0,size($nodes))
    => and(old_identifier_node(list.head($nodes)),old_identifier_nodes(list.tail($nodes)));
effect old_identifier_node(Token($row)) => or(eq(c11.lex.spelling($row),","),and(eq(c11.lex.kind($row),1),not(c11.lex.keyword(c11.lex.spelling($row)))));
effect[fallback] old_identifier_node($node) => 0;
effect old_function_group($nodes,$previous) => and(old_identifier_group(list.head($nodes)),
    and(not(or(eq($previous,""),or(c11.lex.keyword($previous),annotation_word($previous)))),
        choose(lt(1,size($nodes)),not(eq(raw(list.head(list.tail($nodes))),"(")),1)));
effect c11.scopes.has_assignment($found,$node) => or($found,eq(c11.scopes.raw($node),"="));
effect c11.scopes.pack_prefix([Token($row)]) => eq(c11.lex.spelling($row),"__pragma");
effect[fallback] c11.scopes.pack_prefix($current) => 0;
effect c11.scopes.file_part(FileState($context,$items),FileDeclaration($nodes))
    => bind(Rewritten($rewritten,$scope),c11.scopes.parameter_groups($nodes,$context),
        bind(CommittedItems($next,$chunk),rule.iterate("c11.scopes.parse_file_item",FileInput(c11.scopes.rows($rewritten),$scope,[]),1000000),
            FileState($next,list.prepend(c11.enums.file_constants($context,$next,$chunk),$items))));
// A declaration fragment can contain an existing extension item. Returning
// the committed scope is explicit rather than leaking parser-global state.
effect c11.scopes.parse_file_item(FileInput($rows,$context,$out))
    => bind($items,source.parse_tokens($rows,"c11.item",$context,"c11.scopes.capture_commit"),
        bind(Capture($next,$chunks),list.head($items),[0,CommittedItems($next,list.flatten($chunks))]));
effect c11.scopes.capture_commit($context,$item) => bind([$next,$items],c11.scopes.commit($context,$item),[$next,[Capture($next,[$items])]]);
effect c11.scopes.commit($context,$item) => bind([$next,$items],c11.syntax.commit($context,$item),
    bind(PointItems($out,$scope),list.fold("c11.scopes.file_point_item",$items,PointItems([],$next)),[$scope,list.reverse($out)]));
effect c11.scopes.file_point_item(PointItems($out,$context),$item) => bind($scope,c11.scopes.file_binding($context,$item),
    seq(c11.scopes.file_type_constraints($item),PointItems(list.prepend(c11.objects.file_point(c11.names.tags($scope),c11.names.file_references($item,$scope)),$out),$scope)));
effect[fallback] c11.scopes.file_type_constraints($item) => 1;
effect c11.scopes.file_binding($context,c11.syntax.Global($name,$type,$value))
    => c11.scopes.file_type_binding($context,$name,c11.sema.GlobalSlot($type,$name));
effect c11.scopes.file_binding($context,c11.syntax.ExternalGlobal($name,$type))
    => c11.scopes.file_type_binding($context,$name,c11.sema.GlobalSlot($type,$name));
effect c11.scopes.file_binding($context,c11.syntax.Prototype($name,$params,$result,$variadic))
    => c11.scopes.file_type_binding($context,$name,c11.sema.CSignature(list.map("c11.sema.parameter_type",$params),$result,$variadic,0));
effect c11.scopes.file_binding($context,c11.syntax.UnspecifiedPrototype($name,$result))
    => c11.scopes.file_type_binding($context,$name,c11.sema.UnspecifiedSignature($result));
effect c11.scopes.file_binding($context,c11.syntax.Function($name,$params,$result,$body))
    => c11.scopes.file_type_binding($context,$name,c11.sema.CSignature(list.map("c11.sema.parameter_type",$params),$result,0,1));
effect c11.scopes.file_binding($context,c11.syntax.VariadicFunction($name,$params,$result,$body))
    => c11.scopes.file_type_binding($context,$name,c11.sema.CSignature(list.map("c11.sema.parameter_type",$params),$result,1,1));
effect c11.scopes.file_binding($context,c11.syntax.OldFunction($name,$params,$result,$body))
    => c11.scopes.file_type_binding($context,$name,c11.sema.OldSignature(list.map("c11.sema.parameter_type",$params),$result));
effect c11.scopes.file_binding($context,c11.syntax.Internal($item)) => c11.scopes.file_binding($context,$item);
effect c11.scopes.file_binding($context,c11.syntax.NoInline($item)) => c11.scopes.file_binding($context,$item);
effect c11.scopes.file_binding($context,c11.syntax.HeaderInline($item)) => c11.scopes.file_binding($context,$item);
effect[fallback] c11.scopes.file_binding($context,$item) => $context;
effect c11.scopes.ordinary_file($context,$name) => choose(c11.syntax.typedef_visible($context,$name),
    fail(concat("C ordinary identifier conflicts with typedef: ",$name)),
        seq(c11.names.ordinary_allowed($context,$name),env.put(c11.names.ordinary($context,$name,OrdinaryDeclaration()),$name,c11.syntax.OrdinaryName())));
// Parse-time ICE contexts may type-check unevaluated calls to already declared
// functions. Publish only the declaration's type under its lexical identity;
// this never installs future names or evaluates an initializer/body.
effect c11.scopes.file_type_binding($context,$name,$binding)
    => bind($view,c11.sema.visible_binding_type($binding,c11.names.tags($context)),
        bind($composite,c11.scopes.visible_composite(c11.names.ordinary_local($context,$name),$view),
        bind($scope,c11.names.ordinary(c11.scopes.ordinary_file($context,$name),$name,c11.sema.DeclarationView($composite)),
            env.put($scope,c11.sema.NameBindingKey(name_scope.binding_identity(c11.names.visible_binding($scope,$name))),$composite))));
effect visible_composite(name_scope.Binding($identity,c11.sema.DeclarationView($prior)),$binding)
    => c11.sema.composite_binding($prior,$binding);
effect[fallback] visible_composite($prior,$binding) => $binding;
effect c11.scopes.file_part(FileState($context,$items),FileFunction($header,Group($open,$body,$close)))
    => bind([$function_header,$parameter_declarations],old_header_parts($header),
        c11.scopes.file_function($context,$items,$function_header,$parameter_declarations,$open,$body));
effect file_function($context,$items,$header,$declarations,$open,$body)
    => bind(Rewritten($head,$scope),c11.scopes.parameter_groups($header,$context),
        bind($empty,c11.scopes.synthetic($open,text(symbol("scope.block"))),
        bind($probe,c11.scopes.expression(list.concat($head,[$empty]),"c11.item",env.put($scope,BlockKey(c11.scopes.raw($empty)),base.End())),
        bind($params,old_definition_parameters($probe,$declarations,$scope),
        bind($name,tree.fold($probe,"c11.scopes.function_name",""),
        bind($declared,c11.scopes.ordinary_file($scope,$name),
        bind($function_scope,env.put(c11.names.inject_visible(c11.names.parameter_scope($declared),c11.names.visible_binding($declared,$name),$name),c11.initializers.AutomaticLiteralContextKey(),1),
        bind($block,c11.objects.scope_point(c11.names.tags($function_scope),c11.names.local_constants($function_scope,c11.scopes.block(c11.scopes.predefined_body($name,$body,$open),$function_scope,c11.scopes.parameter_names($params))),base.End()),
        bind($item,replace_old_parameters(c11.scopes.expression(list.concat($head,[$empty]),"c11.item",env.put($scope,BlockKey(c11.scopes.raw($empty)),$block)),$params),
        bind([$next,$chunk],c11.scopes.commit($declared,$item),FileState($next,list.prepend(c11.enums.file_constants($context,$next,$chunk),$items))))))))))));
// C11 6.4.2.2: an implicit static const char array in the outer function block.
// Reuse the ordinary declaration, scope and hoisting paths. An unused implicit
// declaration has no observable object, so avoid expanding every SDK inline.
effect c11.scopes.predefined_body($name,$body,$at) => choose(tree.fold($body,"c11.scopes.uses_function_name",0),
    list.concat(c11.scopes.groups(c11.scopes.synthetic_rows(concat("static const char __func__[] = ",concat(text.quote($name),";")),$at)),$body),$body);
effect c11.scopes.uses_function_name($found,c11.scopes.Token($row)) => or($found,and(eq(c11.lex.kind($row),1),eq(c11.lex.spelling($row),"__func__")));
effect[fallback] c11.scopes.uses_function_name($found,$node) => $found;
effect c11.scopes.synthetic_rows($source,$at) => bind(c11.scopes.SyntheticRows($out,$origin),
    list.fold("c11.scopes.synthetic_row",c11.lex.tokens($source,arg($at,2)),c11.scopes.SyntheticRows([],$at)),list.reverse($out));
effect c11.scopes.synthetic_row(c11.scopes.SyntheticRows($out,$at),$row)
    => c11.scopes.SyntheticRows(list.prepend(c11.lex.parser_token(c11.lex.made(c11.lex.kind($row),c11.lex.spelling($row),$at)),$out),$at);
effect c11.scopes.function_name($previous,c11.syntax.Function($name,$params,$result,$body)) => $name;
effect c11.scopes.function_name($previous,c11.syntax.VariadicFunction($name,$params,$result,$body)) => $name;
effect c11.scopes.function_name($previous,c11.syntax.OldFunction($name,$params,$result,$body)) => $name;
effect[fallback] c11.scopes.function_name($previous,$node) => $previous;
effect c11.scopes.function_parameters($previous,c11.syntax.Function($name,$params,$result,$body)) => $params;
effect c11.scopes.function_parameters($previous,c11.syntax.VariadicFunction($name,$params,$result,$body)) => $params;
effect c11.scopes.function_parameters($previous,c11.syntax.OldFunction($name,$params,$result,$body)) => $params;
effect old_header_parts($nodes) => old_header_scan($nodes,[],"");
effect old_header_scan([],$out,$previous) => [list.reverse($out),[]];
effect old_header_scan($nodes,$out,$previous) when lt(0,size($nodes)) => choose(old_function_group($nodes,$previous),
    [list.reverse(list.prepend(list.head($nodes),$out)),list.tail($nodes)],old_header_scan(list.tail($nodes),list.prepend(list.head($nodes),$out),raw(list.head($nodes))));
effect old_definition_parameters($probe,$nodes,$scope) => bind($params,tree.fold($probe,"c11.scopes.function_parameters",[]),
    choose(eq(size($nodes),0),choose(and(tree.fold($probe,"c11.scopes.is_old_definition",0),lt(0,size($params))),
        fail("C old-style definition requires a declaration for every parameter"),$params),
        bind(OldParameterFacts($types,$context,$names),list.fold("c11.scopes.old_parameter_part",semicolon_parts($nodes),
            OldParameterFacts(env.empty(),$scope,parameter_names($params))),
            old_parameter_types($params,$types))));
effect is_old_definition($prior,c11.syntax.OldFunction($name,$params,$result,$body)) => 1;
effect[fallback] is_old_definition($prior,$node) => $prior;
syntax c11.old_parameter_declaration `$spec:c11.specifiers $decls:c11.decls;`
    => bind(OldResolved($out,$base),list.fold("c11.scopes.old_resolve_parameter",$decls,OldResolved([],$spec)),OldParameterDeclarations($spec,list.reverse($out)));
effect old_resolve_parameter(OldResolved($out,$spec),$decl)
    => OldResolved(list.prepend(c11.declarators.resolve($decl,declaration_base($spec)),$out),$spec);
effect old_parameter_part($state,[]) => $state;
effect old_parameter_part(OldParameterFacts($types,$scope,$names),$nodes) when lt(0,size($nodes))
    => bind(Rewritten($parts,$context),parameter_groups($nodes,$scope),
        bind(OldParameterDeclarations($spec,$decls),expression($parts,"c11.old_parameter_declaration",$context),
            bind(OldDeclaration($next,$updated,$ids,$base),list.fold("c11.scopes.old_parameter_decl",$decls,OldDeclaration($types,$context,$names,$spec)),
                OldParameterFacts($next,$updated,$ids))));
effect old_parameter_decl(OldDeclaration($types,$scope,$names,$spec),c11.declarators.Resolved($name,$type))
    =>
        seq(choose(env.contains($names,$name),1,fail("C old-style parameter declaration names no parameter")),
        seq(choose(env.contains($types,$name),fail("duplicate C old-style parameter declaration"),1),
        seq(choose(or(eq(declaration_storage($spec),"none"),eq(declaration_storage($spec),"register")),1,fail("C old-style parameter storage must be register or absent")),
            bind($parameter,c11.declarators.parameter_value($name,$type),
                OldDeclaration(env.put($types,$name,choose(eq(declaration_storage($spec),"register"),
                    c11.storage.parameter_storage("register",$parameter),$parameter)),$scope,$names,$spec)))));
effect old_parameter_part(OldDeclaration($types,$scope,$names,$spec),$nodes)
    => old_parameter_part(OldParameterFacts($types,$scope,$names),$nodes);
effect old_parameter_types([],$types) => [];
effect old_parameter_types($params,$types) when lt(0,size($params)) => bind(base.Param($name,$prior),list.head($params),
    choose(env.contains($types,$name),list.prepend(env.get($types,$name),old_parameter_types(list.tail($params),$types)),
        fail("C old-style definition requires a declaration for every parameter")));
effect replace_old_parameters(c11.syntax.OldFunction($name,$prior,$result,$body),$params) => c11.syntax.OldFunction($name,$params,$result,$body);
effect replace_old_parameters(c11.syntax.Internal($item),$params) => c11.syntax.Internal(replace_old_parameters($item,$params));
effect replace_old_parameters(c11.syntax.HeaderInline($item),$params) => c11.syntax.HeaderInline(replace_old_parameters($item,$params));
effect replace_old_parameters(c11.syntax.NoInline($item),$params) => c11.syntax.NoInline(replace_old_parameters($item,$params));
effect[fallback] replace_old_parameters($item,$params) => $item;
effect[fallback] c11.scopes.function_parameters($previous,$node) => $previous;
syntax c11.block `$name:ident` when env.contains(syntax.context(),BlockKey($name)) => env.get(syntax.context(),BlockKey($name));

// Each parameter list has its own prototype scope. A declared parameter
// hides a typedef for subsequent parameters but never leaks out of the list.
syntax c11.parameters `$name:ident` when env.contains(syntax.context(),ParametersKey($name)) => env.get(syntax.context(),ParametersKey($name));
effect c11.scopes.parameter_groups($nodes,$context) => bind(Rewritten($rewritten,$initial),c11.names.rewrite($nodes,$context),
    bind(ParameterWalk($out,$scope,$previous,$initializer),
        list.fold("c11.scopes.parameter_group",$rewritten,ParameterWalk([],$initial,NoPrevious(),0)),Rewritten(list.reverse($out),$scope)));
effect c11.scopes.parameter_group(ParameterWalk($out,$context,$previous,$initializer),Group($open,$children,$close))
    => c11.scopes.parameter_group_kind($out,$context,$initializer,$open,$children,$close,
        c11.scopes.group_kind($previous,$open,$children,$context,$initializer));
// Annotation and expression groups are opaque only to this declarator walk.
// Their complete original rows still reach the selected language grammar;
// this neither accepts unknown annotations nor discards their arguments.
effect c11.scopes.group_kind($previous,$open,$children,$context,$initializer)
    => choose(c11.scopes.annotation_prefix($previous),AnnotationGroup(),
        choose(or($initializer,not(eq(c11.lex.spelling($open),"("))),OpaqueGroup(),
            choose(c11.scopes.expression_prefix($previous),OpaqueGroup(),
                choose(c11.scopes.parameter_prefix($previous,$children,$context),ParameterGroup(),DeclaratorGroup()))));
effect c11.scopes.annotation_word($name) => or(text.contains(" __declspec __attribute__ __attribute __pragma ",concat(" ",concat($name," "))),c11.scopes.annotation_extension($name));
effect[fallback] c11.scopes.annotation_extension($name) => 0;
effect c11.scopes.annotation_prefix(Token($row)) => c11.scopes.annotation_word(c11.lex.spelling($row));
effect[fallback] c11.scopes.annotation_prefix($previous) => 0;
effect c11.scopes.expression_prefix(Token($row)) => text.contains(" sizeof _Alignas _Alignof _Generic _Static_assert _Atomic __alignof __alignof__ typeof __typeof __typeof__ ",concat(" ",concat(c11.lex.spelling($row)," ")));
effect[fallback] c11.scopes.expression_prefix($previous) => 0;
effect c11.scopes.parameter_group_kind($out,$context,$initializer,$open,$children,$close,AnnotationGroup())
    => ParameterWalk(list.prepend(Group($open,$children,$close),$out),$context,Group($open,$children,$close),$initializer);
effect c11.scopes.parameter_group_kind($out,$context,$initializer,$open,$children,$close,OpaqueGroup())
    => bind(Rewritten($rewritten,$scope),c11.names.expression_groups($children,$context),
        ParameterWalk(list.prepend(Group($open,$rewritten,$close),$out),$scope,Group($open,$children,$close),$initializer));
effect c11.scopes.parameter_group_kind($out,$context,$initializer,$open,$children,$close,ParameterGroup())
    => bind(ParsedParameters($params,$parameter_scope),c11.scopes.parameters_context($children,c11.names.enter($context)),bind($name,text(symbol("scope.parameters")),
        ParameterWalk(list.prepend(Group($open,[c11.scopes.synthetic($open,$name)],$close),$out),
            env.put(env.put(c11.names.restore_parameters($context,$parameter_scope),ParametersKey($name),$params),c11.names.LastParametersKey(),$parameter_scope),
            Group($open,$children,$close),0)));
effect c11.scopes.parameter_group_kind($out,$context,$initializer,$open,$children,$close,DeclaratorGroup())
    => bind(Rewritten($nodes,$scope),c11.scopes.parameter_groups($children,$context),
        ParameterWalk(list.prepend(Group($open,$nodes,$close),$out),$scope,Group($open,$children,$close),0));
effect c11.scopes.parameter_group(ParameterWalk($out,$context,$previous,$initializer),Token($row))
    => bind($next_initializer,choose(eq(c11.lex.spelling($row),"="),1,choose(eq(c11.lex.spelling($row),","),0,$initializer)),
        choose(and($initializer,not(eq(c11.lex.spelling($row),","))),
            bind([1,c11.names.ExpressionWalk($rest,$rewritten,$scope,$last)],c11.names.expression_node(Token($row),[],[],$context,c11.scopes.previous_spelling($previous)),
                ParameterWalk(list.prepend(list.head($rewritten),$out),$scope,Token($row),$next_initializer)),
            ParameterWalk(list.prepend(Token($row),$out),$context,Token($row),$next_initializer)));
effect c11.scopes.previous_spelling(NoPrevious()) => "";
effect[fallback] c11.scopes.previous_spelling($previous) => c11.scopes.raw($previous);
effect c11.scopes.parameter_prefix($previous,$children,$context) => and(c11.scopes.declarator_tail($previous,$context),
    choose(eq(size($children),0),1,not(eq(c11.scopes.raw(list.head($children)),"*"))));
effect c11.scopes.declarator_tail(Token($row),$context) => and(eq(c11.lex.kind($row),1),
    and(not(c11.syntax.typedef_visible($context,c11.lex.spelling($row))),
        not(or(c11.scopes.annotation_prefix(Token($row)),c11.scopes.expression_prefix(Token($row))))));
effect c11.scopes.declarator_tail(Group($open,$children,$close),$context) => choose(and(eq(c11.lex.spelling($open),"("),lt(0,size($children))),
    or(eq(c11.scopes.raw(list.head($children)),"*"),choose(eq(size($children),1),c11.scopes.declarator_tail(list.head($children),$context),0)),0);
effect[fallback] c11.scopes.declarator_tail($node,$context) => 0;
effect c11.scopes.parameters($nodes,$context) => arg(c11.scopes.parameters_context($nodes,$context),0);
effect c11.scopes.parameters_context([],$context) => ParsedParameters(c11.declarators.Parameters([],0,0),$context);
effect c11.scopes.parameters_context($nodes,$context) when lt(0,size($nodes)) => choose(identifier_parameters($nodes,$context),
    bind($names,list.map("c11.scopes.identifier_parameter_name",comma_parts($nodes)),
