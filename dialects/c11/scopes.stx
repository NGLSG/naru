    typed_parameters_context($nodes,$context));
effect identifier_parameters($nodes,$context) => arg(list.fold("c11.scopes.identifier_parameter_part",comma_parts($nodes),[1,$context]),0);
effect identifier_parameter_part([$valid,$context],[Token($row)]) => [and($valid,and(eq(c11.lex.kind($row),1),and(not(c11.lex.keyword(c11.lex.spelling($row))),not(c11.syntax.typedef_visible($context,c11.lex.spelling($row)))))),$context];
