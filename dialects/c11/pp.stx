mod c11.pp;
use c11.lex;
use c11.types;
use base;
use headers;
use c11.pp_macros;

// Public preprocessing interfaces delegate to the marked-token implementation.
// A qualified extension cannot introduce an undeclared relation in its owner.
effect c11.pp.object_replacement($body,$at,$hide) => c11.pp_macros.object_replacement($body,$at,$hide);
effect c11.pp.marked_arguments($work,$at) => c11.pp_macros.marked_arguments($work,$at);
effect c11.pp.marked_bindings($params,$variadic,$args,$at) => c11.pp_macros.marked_bindings($params,$variadic,$args,$at);
effect c11.pp.marked_substitution($body,$bindings,$macros,$at,$depth,$hide) => c11.pp_macros.marked_substitution($body,$bindings,$macros,$at,$depth,$hide);
effect c11.pp.hide_union($left,$right) => c11.pp_macros.hide_union($left,$right);
effect c11.pp.hide_intersection($left,$right) => c11.pp_macros.hide_intersection($left,$right);

// The macro table, conditional stack, include stack and expansion hide sets
// are ordinary terms. No C directive is implemented in the compiler core.
effect c11.pp.option($options,$key,$default) => choose(env.contains($options,$key),env.get($options,$key),$default);
effect c11.pp.initial() => c11.pp.capability_macros(list.fold("c11.pp.predefine",[["__STDC__","1"],["__STDC_VERSION__","201112L"],
    ["__STDC_HOSTED__","1"],["__STDC_NO_ATOMICS__","1"],["__STDC_NO_THREADS__","1"],
    ["__STDC_NO_COMPLEX__","1"],["__STDC_NO_VLA__","1"]],env.empty()));
effect[fallback] c11.pp.capability_macros($macros)
    => arg(list.fold("c11.pp.apply_macro_provider",collect("c11.pp.capability_provider",[]),[$macros,env.empty()]),0);
effect[fallback] c11.pp.capability_provider() => NoMacroProvider();
effect c11.pp.apply_macro_provider([$macros,$seen],NoMacroProvider()) => [$macros,$seen];
effect c11.pp.apply_macro_provider([$macros,$seen],MacroProvider($name,$relation))
    => choose(env.contains($seen,$name),fail(concat("duplicate C capability macro provider: ",$name)),
        [apply($relation,[$macros]),env.put($seen,$name,1)]);
effect c11.pp.predefine($macros,[$name,$value]) => env.put($macros,$name,c11.pp.Object(c11.lex.tokens($value,"<predefined>")));
// Parse a compiler-supplied macro contract through the normal definition
// validator without entering a synthetic file or replacing include context.
effect c11.pp.define_source($source,$macros) => bind($tokens,c11.lex.tokens($source,"<compiler macro contract>"),
    choose(eq(size($tokens),0),fail("empty compiler macro definition"),
        arg(c11.pp.define($tokens,c11.pp.State([],$macros,[],[]),list.head($tokens)),1)));
effect c11.pp.preprocess($source,$path,$options) => bind($configured,c11.pp.configure($options),
    bind([$tokens,$macros],c11.pp.file($source,$path,c11.pp.platform_macros($configured),$configured,[],0),
        list.concat($tokens,list.flatten(collect("c11.pp.output_tokens",[$macros,$configured])))));
