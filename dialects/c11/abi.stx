// One allocation fact owns all buffers at a source call site. Frame planning
// puts them in the entry block, including calls inside loops and nested calls.
effect c11.sema.make_invoke($result,$name,$arguments,$params,$variadic,$definition)
    => c11.abi.make_call($result,Direct($name),$arguments,$params,$variadic);
effect c11.sema.make_indirect_invoke($result,$target,$arguments,$params,$variadic)
    => c11.abi.make_call($result,Through($target),$arguments,$params,$variadic);
effect c11.abi.make_call($result,$callee,$args,$params,$variadic)
    => base.Typed($result,WinCall(symbol("c.abi.call"),$callee,$args,c11.abi.fixed_types($args,$params),$variadic));
effect c11.abi.fixed_types($args,[]) => [];
