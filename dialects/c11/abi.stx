// Real SDK/resource headers own va_list and its macros. These are compiler
// intrinsics consumed by those headers, not replacement standard-library APIs.
syntax c11.atom_type `__builtin_va_list` => c11.types.Pointer(c11.types.PlainChar());
syntax c11.atom_type `__builtin_ms_va_list` => c11.types.Pointer(c11.types.PlainChar());
