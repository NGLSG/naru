effect c11.scopes.link_storage($storage,$type) => choose(or(eq($storage,"none"),eq($storage,"extern")),1,
    choose(or(eq($storage,"auto"),eq($storage,"register")),c11.storage.automatic_subject($type),fail("C block function declaration requires extern or no storage class")));
effect link_binding($name,c11.types.FunctionType($result,$params,$variadic,1))
    => c11.sema.CSignature(list.map("c11.sema.parameter_type",$params),$result,$variadic,0);
effect link_binding($name,c11.types.FunctionType($result,$params,$variadic,0))
    => c11.sema.UnspecifiedSignature($result);
effect[fallback] link_binding($name,$type) => c11.sema.GlobalSlot($type,$name);
effect link_item($name,c11.types.FunctionType($result,$params,$variadic,1)) => c11.syntax.Prototype($name,$params,$result,$variadic);
effect link_item($name,c11.types.FunctionType($result,$params,$variadic,0)) => c11.syntax.UnspecifiedPrototype($name,$result);
effect[fallback] link_item($name,$type) => c11.syntax.ExternalGlobal($name,$type);
effect linked_local_prior($seen,$name,$view) => choose(env.contains($seen,$name),linked_prior(env.get($seen,$name),$view),1);
effect linked_prior(c11.sema.DeclarationView($prior),$view) => c11.sema.composite_binding($prior,$view);
effect[fallback] linked_prior($prior,$view) => fail("C linked declaration conflicts with another local declaration");
effect local_object($name,$type,$initializer,$base,$storage,$context,$seen,$out,$for)
    => bind($valid,seq(c11.scopes.local_type_constraints($type,$storage),c11.scopes.for_declaration_constraints($storage,$type,$for)),
        seq(c11.names.ordinary_allowed($context,$name),choose(env.contains($seen,$name),fail(concat("duplicate C local declaration: ",$name)),
        bind($scope,env.put(c11.names.ordinary($context,$name,OrdinaryDeclaration()),$name,c11.syntax.OrdinaryName()),
            bind(Rewritten($rewritten,$initializer_scope),c11.names.expression_groups($initializer,$scope),
            bind($value,choose(eq(size($initializer),0),c11.syntax.Uninitialized(),c11.scopes.expression($rewritten,"c11.initializer",$initializer_scope)),
                LocalDeclarations($initializer_scope,env.put($seen,$name,OrdinaryDeclaration()),$base,$storage,
                    list.prepend(c11.objects.scope_point(c11.names.tags($initializer_scope),
                        c11.scopes.object_statement($name,c11.syntax.initialized_type($type,$value),$value,$storage,$scope),base.End()),$out),$for)))))));
effect[fallback] c11.scopes.object_statement($name,$type,$value,$storage,$context) => c11.syntax.local_declaration($name,$type,$value,$storage,base.End());
effect[fallback] c11.scopes.typedef_statement($name,$type) => LocalTypedef($name,$type,base.End());
effect c11.scopes.for_declaration_constraints($storage,$type,0) => 1;
effect c11.scopes.for_declaration_constraints($storage,$type,1) => choose(or(eq($storage,"none"),or(eq($storage,"auto"),eq($storage,"register"))),c11.scopes.for_object($type),
    fail("C for initializer declaration requires automatic objects"));
effect c11.scopes.for_object(c11.types.FunctionType($result,$params,$variadic,$prototype)) => fail("C for initializer cannot declare a function");
effect c11.scopes.for_object(c11.types.AlignedType($type,$alignment)) => c11.scopes.for_object($type);
effect[fallback] c11.scopes.for_object($type) => 1;
effect c11.scopes.typedef_local($seen,$name,$type) => choose(env.contains($seen,$name),
    choose(eq(env.get($seen,$name),TypedefDeclaration($type)),$seen,fail(concat("incompatible C local typedef declaration: ",$name))),
    env.put($seen,$name,TypedefDeclaration($type)));
effect c11.syntax.append(LocalTypedef($name,$type,$rest),$next) => LocalTypedef($name,$type,c11.syntax.append($rest,$next));
effect base.check_body(LocalTypedef($name,$type,$next),$env,$result) => c11.scopes.check_typedef($name,$type,$next,$env,$result);
effect[fallback] c11.scopes.check_typedef($name,$type,$next,$env,$result) => base.check_body($next,env.put($env,$name,TypeNameBinding($type)),$result);
effect[fallback] c11.scopes.local_type_constraints($type,$storage) => 1;
effect c11.sema.named_read(TypeNameBinding($type),$name) => fail(concat("C typedef name is not an expression: ",$name));
effect c11.sema.for_continues(LocalTypedef($name,$type,$next),$step) => LocalTypedef($name,$type,c11.sema.for_continues($next,$step));
effect c11.syntax.append(LocalLinked($tags,$item,$rest),$next) => LocalLinked($tags,$item,c11.syntax.append($rest,$next));
effect c11.sema.for_continues(LocalLinked($tags,$item,$rest),$step) => LocalLinked($tags,$item,c11.sema.for_continues($rest,$step));
effect base.check_body(LocalLinked($tags,$item,$next),$env,$result)
    => bind($scope,c11.objects.point_environment($tags,$env),
        base.check_body($next,$scope,$result));
