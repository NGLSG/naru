effect c11.sema.unnamed_parameter($type) => base.Param("",$type);
// Symbol modifiers accumulate facts independently. Combining annotations does
// not require a separate lower rule for every ordering or wrapper combination.
effect base.lower_function(CheckedCFunction($name,$params,$result,$body,$variadic)) => c11.sema.lower_symbol(CheckedCFunction($name,$params,$result,$body,$variadic),env.empty());
effect base.lower_function(CheckedPrototype($name,$params,$result,$variadic)) => c11.sema.lower_symbol(CheckedPrototype($name,$params,$result,$variadic),env.empty());
effect base.lower_function(CheckedGlobal($name,$type,$value)) => c11.sema.lower_symbol(CheckedGlobal($name,$type,$value),env.empty());
effect base.lower_function(CheckedExternalGlobal($name,$type)) => c11.sema.lower_symbol(CheckedExternalGlobal($name,$type),env.empty());
effect base.lower_function(Internal($item)) => c11.sema.lower_symbol(Internal($item),env.empty());
effect base.lower_function(HeaderInline($item)) => c11.sema.lower_symbol(HeaderInline($item),env.empty());
effect base.lower_function(InlineObject($item)) => c11.sema.lower_symbol(InlineObject($item),env.empty());
effect base.lower_function(NoInline($item)) => c11.sema.lower_symbol(NoInline($item),env.empty());
effect c11.sema.lower_symbol(Internal($item),$policy) => c11.sema.lower_symbol($item,env.put($policy,"linkage","internal"));
effect c11.sema.lower_symbol(HeaderInline($item),$policy) => c11.sema.lower_symbol($item,env.put(env.put($policy,"linkage","linkonce_odr"),"comdat",1));
effect c11.sema.lower_symbol(InlineObject($item),$policy) => c11.sema.lower_symbol($item,env.put(env.put($policy,"linkage","linkonce_odr"),"comdat",1));
effect c11.sema.lower_symbol(NoInline($item),$policy) => c11.sema.lower_symbol($item,c11.sema.symbol_attr($policy,"no_inline",RawAttr("no_inline","unit")));
effect c11.sema.symbol_attr($policy,$name,$attribute) => env.put($policy,"attributes",env.put(choose(env.contains($policy,"attributes"),env.get($policy,"attributes"),env.empty()),$name,$attribute));
effect c11.sema.symbol_attribute([$name,$attribute]) => $attribute;
effect c11.sema.symbol_enum_attribute($policy,$name) => env.put($policy,"enum_attributes",
    env.put(choose(env.contains($policy,"enum_attributes"),env.get($policy,"enum_attributes"),env.empty()),$name,1));
effect c11.sema.symbol_enum_name([$name,$value]) => text.quote($name);
effect c11.sema.symbol_attributes($name,$policy) => bind($attrs,choose(env.contains($policy,"attributes"),list.map("c11.sema.symbol_attribute",env.entries(env.get($policy,"attributes"))),[]),
    bind($merged,choose(env.contains($policy,"enum_attributes"),list.prepend(RawAttr("naru.llvm.function_attrs",
        concat("[",concat(text.join(list.map("c11.sema.symbol_enum_name",env.entries(env.get($policy,"enum_attributes"))),", "),"]"))),$attrs),$attrs),
        choose(env.contains($policy,"comdat"),seq(c11.sema.comdat($name),list.prepend(c11.sema.comdat_attr($name),$merged)),$merged)));
effect c11.sema.symbol_linkage($policy) => choose(env.contains($policy,"linkage"),env.get($policy,"linkage"),"external");
effect c11.sema.lower_symbol(CheckedCFunction($name,$params,$result,$body,$variadic),$policy)
    => c11.sema.lower_function_attrs($name,$params,$result,$body,$variadic,c11.sema.symbol_linkage($policy),c11.sema.symbol_attributes($name,$policy));
effect c11.sema.lower_symbol(CheckedPrototype($name,$params,$result,$variadic),$policy) => choose(eq(c11.sema.symbol_linkage($policy),"internal"),
    fail("static C function declared without a definition"),c11.sema.lower_prototype($name,$params,$result,$variadic,c11.sema.symbol_attributes($name,$policy)));
effect[fallback] c11.sema.lower_prototype($name,$params,$result,$variadic,$attrs) => mlir.op("llvm.func",[],[],
    list.concat(list.concat($attrs,c11.sema.function_abi_attrs($params,$result,$variadic)),
        [Attr("sym_name",$name),RawAttr("function_type",c11.sema.function_type($params,$result,$variadic))]),[mlir.region_blocks([])]);
effect c11.sema.lower_symbol(CheckedGlobal($name,$type,$value),$policy)
    => c11.sema.global_attrs($name,$type,$value,c11.sema.symbol_linkage($policy),c11.sema.symbol_attributes($name,$policy));
effect c11.sema.lower_symbol(CheckedExternalGlobal($name,c11.types.AlignedType($type,$alignment)),$policy)
    => mlir.op("llvm.mlir.global",[],[],list.concat(c11.sema.symbol_attributes($name,$policy),[Attr("sym_name",$name),
        RawAttr("global_type",types.repr($type)),Attr("alignment",$alignment,"i64"),c11.sema.linkage("external")]),[mlir.region_blocks([])]);
effect c11.sema.lower_symbol(CheckedExternalGlobal($name,$type),$policy) => mlir.op("llvm.mlir.global",[],[],
    list.concat(c11.sema.symbol_attributes($name,$policy),[Attr("sym_name",$name),RawAttr("global_type",types.repr($type)),c11.sema.linkage("external")]),[mlir.region_blocks([])]);
effect base.lower(base.Typed($type,FunctionAddress($name,$definition)),$env) => c11.sema.address_global($name);
effect c11.sema.call($name,$arguments,ObjectSlot($type,$identity),$env,$expected) => c11.sema.indirect_call(c11.sema.read(ObjectSlot($type,$identity)),$arguments,$env,$expected);
effect c11.sema.call($name,$arguments,GlobalSlot($type,$symbol),$env,$expected) => c11.sema.indirect_call(c11.sema.read(GlobalSlot($type,$symbol)),$arguments,$env,$expected);
effect c11.sema.indirect_call(base.Typed(c11.types.Pointer(c11.types.FunctionType($result,$params,$variadic,1)),$target),$arguments,$env,$expected)
    => c11.sema.contextual(c11.sema.make_indirect_invoke(c11.sema.value_type(c11.sema.complete_type($result,$env)),base.Typed(c11.types.Pointer(c11.types.FunctionType($result,$params,$variadic,1)),$target),
        c11.sema.arguments($arguments,list.map("c11.sema.parameter_type",$params),$variadic,$env),list.map("c11.sema.parameter_type",$params),$variadic),$expected);
effect c11.sema.indirect_call(base.Typed(c11.types.Pointer(c11.types.FunctionType($result,$params,$variadic,$prototype)),$target),$arguments,$env,$expected) when not(eq($prototype,1))
    => bind($promoted,c11.sema.arguments($arguments,[],1,$env),
        c11.sema.contextual(c11.sema.make_indirect_invoke(c11.sema.value_type(c11.sema.complete_type($result,$env)),
            base.Typed(c11.types.Pointer(c11.types.FunctionType($result,$params,$variadic,$prototype)),$target),$promoted,[],1),$expected));
effect checked_argument_type(base.Typed($type,$value)) => $type;
effect base.lower(base.Typed($result,IndirectInvoke($target,$arguments,$params,$variadic)),$env)
    => mlir.op("llvm.call",list.prepend(base.lower($target,$env),base.lower_arguments($arguments,$env)),base.result_types($result),
        list.concat(choose($variadic,[RawAttr("var_callee_type",c11.sema.function_type($params,$result,$variadic))],[]),[RawAttr("op_bundle_sizes","array<i32>"),
         RawAttr("operandSegmentSizes",concat("array<i32: ",concat(text(add(size($arguments),1)),", 0>")))]),[]);

effect c11.sema.named_read(CSignature($params,$result,$variadic,$definition),$name) => c11.sema.read_function($name,$params,$result,$variadic,$definition);
effect[fallback] c11.sema.named_read($binding,$name) => c11.sema.read($binding);

effect c11.sema.parameter_repr(base.Param($name,$type)) => types.repr($type);

// Selection retains a source expression, not a prematurely converted value.
// All arms are constraint checked, but only the selected source is checked in
// its enclosing value/address/sizeof/assignment context and ever lowered.
effect base.check(c11.syntax.Generic($control,$associations),$env,$expected)
    => base.check(c11.sema.generic_source($control,$associations,$env),$env,$expected);
effect c11.sema.lvalue(c11.syntax.Generic($control,$associations),$env)
    => c11.sema.lvalue(c11.sema.generic_source($control,$associations,$env),$env);
effect c11.sema.object_type(c11.syntax.Generic($control,$associations),$env)
    => c11.sema.object_type(c11.sema.generic_source($control,$associations,$env),$env);
effect base.check(c11.syntax.Address(c11.syntax.Generic($control,$associations)),$env,$expected)
    => base.check(c11.syntax.Address(c11.sema.generic_source($control,$associations,$env)),$env,$expected);
effect[fallback] base.check(c11.syntax.Address($value),$env,$expected)
    => fail("C address requires an lvalue or function designator");
effect c11.sema.generic_source($control,$associations,$env) => bind(base.Typed($type,$value),base.check($control,$env,base.Any()),
    bind(GenericState($scope,$control_type,$seen,$selected,$default),list.fold("c11.sema.generic_association",$associations,
        GenericState($env,c11.types.unqualified($type),[],NoGenericValue(),NoGenericValue())),
        c11.sema.generic_result($selected,$default)));
effect c11.sema.generic_association(GenericState($env,$control,$seen,$selected,$default),c11.syntax.TypeAssociation($type,$expression))
    => bind($complete,c11.sema.complete_type($type,$env),seq(c11.sema.generic_object_type($complete),
        choose(c11.sema.generic_seen($seen,$complete),fail("duplicate compatible C generic association type"),
            seq(base.check($expression,$env,base.Any()),GenericState($env,$control,list.prepend($complete,$seen),
                choose(c11.sema.generic_match($control,$complete),
                    choose(eq($selected,NoGenericValue()),$expression,
                        fail("multiple compatible C generic associations for the controlling type")),$selected),$default)))));
effect c11.sema.generic_association(GenericState($env,$control,$seen,$selected,NoGenericValue()),c11.syntax.DefaultAssociation($expression))
    => seq(base.check($expression,$env,base.Any()),GenericState($env,$control,$seen,$selected,$expression));
effect c11.sema.generic_association(GenericState($env,$control,$seen,$selected,$default),c11.syntax.DefaultAssociation($expression)) when not(eq($default,NoGenericValue()))
    => fail("multiple default C generic associations");
effect c11.sema.generic_result($selected,$default) when not(eq($selected,NoGenericValue())) => $selected;
effect c11.sema.generic_result(NoGenericValue(),$default) when not(eq($default,NoGenericValue())) => $default;
effect c11.sema.generic_result(NoGenericValue(),NoGenericValue()) => fail("no compatible C generic association and no default");
effect c11.sema.generic_seen([],$type) => 0;
effect c11.sema.generic_seen($seen,$type) when lt(0,size($seen))
    => or(c11.sema.generic_match(list.head($seen),$type),c11.sema.generic_seen(list.tail($seen),$type));
effect[fallback] c11.sema.generic_match($control,$association) => c11.types.compatible($control,$association);
effect c11.sema.generic_object_type($type) => c11.sema.generic_object_unqualified(c11.types.unqualified($type));
effect c11.sema.generic_object_unqualified(control.Void()) => fail("C generic association requires a complete object type");
effect c11.sema.generic_object_unqualified(c11.types.FunctionType($result,$params,$variadic,$prototype))
    => fail("C generic association requires a complete object type");
effect c11.sema.generic_object_unqualified(c11.types.IncompleteArray($element))
    => fail("C generic association requires a complete object type");
effect c11.sema.generic_object_unqualified(c11.types.FlexibleArray($element))
    => fail("C generic association requires a complete object type");
effect[fallback] c11.sema.generic_object_unqualified($type) => c11.types.bytes($type);

effect base.check(c11.syntax.IndirectCall($callee,$arguments),$env,$expected) => c11.sema.indirect_call(base.check($callee,$env,base.Any()),$arguments,$env,$expected);

// A static local is hoisted once with internal linkage. References in the
// lexical block bind to that object; no initializer executes at call time.
effect externc.rewrite_enter(c11.syntax.HeaderInline($item),$context,externc.Hoisting($globals,$pool))
    => tree.Descend([$item],$context,InlineCookie(choose(env.contains($pool,InlineOwnerKey()),env.get($pool,InlineOwnerKey()),NoInlineOwner())),
        externc.Hoisting($globals,env.put($pool,InlineOwnerKey(),InlineOwner(c11.sema.item_name($item),0))));
effect externc.rewrite_leave(InlineCookie($owner),[$item],$context,externc.Hoisting($globals,$pool))
    => [c11.syntax.HeaderInline($item),externc.Hoisting($globals,env.put($pool,InlineOwnerKey(),$owner))];
effect c11.sema.static_symbol($pool) => choose(env.contains($pool,InlineOwnerKey()),c11.sema.static_symbol_owner(env.get($pool,InlineOwnerKey()),$pool),
    [text(symbol(".naru.c.static")),$pool,0]);
effect c11.sema.static_symbol_owner(InlineOwner($function,$index),$pool) => [concat(".naru.c.inline.",concat($function,concat(".",text($index)))),
    env.put($pool,InlineOwnerKey(),InlineOwner($function,add($index,1))),1];
effect c11.sema.static_symbol_owner(NoInlineOwner(),$pool) => [text(symbol(".naru.c.static")),$pool,0];
effect externc.rewrite_enter(c11.syntax.StaticDeclare($name,$type,$value,$next),$context,externc.Hoisting($globals,$pool))
    => bind([$symbol,$symbol_pool,$shared],c11.sema.static_symbol($pool),
        tree.Descend([$value,$next],$context,StaticCookie($name,$type,$symbol,$shared,c11.initializers.static_identity($context,$name),c11.initializers.static_tags($context)),
            externc.Hoisting($globals,$symbol_pool)));
effect externc.rewrite_leave(StaticCookie($name,$type,$symbol,$shared,$identity,$tags),[$initializer,$body],$context,externc.Hoisting($globals,$pool))
    => [StaticBinding($name,$type,$symbol,$body),externc.Hoisting(list.prepend(c11.initializers.static_item($identity,$tags,
        choose($shared,c11.syntax.InlineObject(c11.syntax.Global($symbol,$type,$initializer)),
            c11.syntax.Internal(c11.syntax.Global($symbol,$type,$initializer)))),$globals),$pool)];
effect c11.syntax.append(c11.sema.StaticBinding($name,$type,$symbol,$body),$next)
    => c11.sema.StaticBinding($name,$type,$symbol,c11.syntax.append($body,$next));
effect base.check_body(StaticBinding($name,$type,$symbol,$next),$env,$result) => c11.sema.check_static_binding($name,$type,$symbol,$next,$env,$result);
effect[fallback] c11.sema.check_static_binding($name,$type,$symbol,$next,$env,$result)
    => c11.sema.check_static_body($name,env.get($env,$symbol),$next,$env,$result);
effect c11.sema.check_static_body($name,$binding,$next,$env,$result) => bind($seen,env.get($env,LocalNamesKey()),
    choose(env.contains($seen,$name),fail(concat("duplicate C local declaration: ",$name)),
        base.check_body($next,c11.sema.bind_name(env.put($env,LocalNamesKey(),env.put($seen,$name,1)),$name,$binding),$result)));

effect c11.sema.compound_value("left",$a,$b) => c11.sema.shift("left",$a,$b);
effect c11.sema.compound_value("right",$a,$b) => c11.sema.shift("right",$a,$b);
effect[fallback] c11.sema.compound_value($operation,$a,$b) => c11.sema.binary($operation,$a,$b);
