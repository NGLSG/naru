mod c11.sema;
use c11.syntax;
use c11.types;
use base;
use types;
use control;
use externc;
use tree;
use c11.constants;
use name_scope;
use c11.names;
use c11.enums;
use c11.initializers;
use c11.objects;

// Frontend snapshots carry an opaque immutable frame. The declaration table
// may contain future symbols for linking, but expression lookup is lexical.
effect visible_frame_key() => VisibleFrameKey();
effect c11.sema.name_visible($env,$name) => choose(env.contains($env,VisibleFrameKey()),
    or(name_scope.contains(env.get($env,VisibleFrameKey()),"ordinary",$name),
        or(choose(env.contains($env,FunctionNameKey()),eq(env.get($env,FunctionNameKey()),$name),0),
            choose(env.contains($env,$name),c11.sema.incoming_name(env.get($env,$name)),0))),1);
// Parameter copies read the bound incoming SSA slot before the first source
// statement installs its parameter-frame snapshot.
effect c11.sema.incoming_name(base.Slot($type,$identity)) => 1;
effect[fallback] c11.sema.incoming_name($binding) => 0;
effect c11.sema.lookup_name($env,$name) => choose(env.contains($env,$name),
    choose(c11.sema.name_visible($env,$name),env.get($env,$name),
        fail(concat("C identifier is not visible at this declaration point: ",$name))),env.get($env,$name));
// The spelling table serves linking and compatibility. Source references use
// stable lexical identities, so a later shadow cannot replace an earlier read.
effect c11.sema.bind_name($env,$name,$binding) => c11.sema.capture_name(env.put($env,$name,$binding),$name);
effect c11.sema.capture_name($env,$name) => bind($captured,choose(env.contains($env,VisibleFrameKey()),
    bind($binding,name_scope.lookup(env.get($env,VisibleFrameKey()),"ordinary",$name),
        choose(eq($binding,name_scope.Missing()),$env,c11.sema.capture_binding($env,$name,$binding))),$env),
            choose(env.contains($captured,$name),c11.sema.binding_facts($name,env.get($captured,$name),$captured),$captured));
// Library adapters may retain declaration facts under opaque keys. Lexical
// shadowing still changes the ordinary binding; it cannot erase learned ABI
// type identities needed by a generic library operation.
effect[fallback] c11.sema.binding_facts($name,$binding,$env) => $env;
effect capture_binding($env,$name,name_scope.Binding($identity,DeclarationView($view)))
    => env.put(env.put($env,NameBindingKey($identity),env.get($env,$name)),DeclarationBindingKey($identity,$view),env.get($env,$name));
effect[fallback] capture_binding($env,$name,$binding) => env.put($env,NameBindingKey(name_scope.binding_identity($binding)),env.get($env,$name));
effect c11.sema.capture_names($env,$names) => list.fold("c11.sema.capture_name",$names,$env);
effect c11.sema.lookup_at($frame,$name,$env) => bind($binding,name_scope.lookup($frame,"ordinary",$name),
    choose(eq($binding,name_scope.Missing()),fail(concat("C identifier is not visible at this declaration point: ",$name)),
        c11.sema.lookup_binding($binding,$name,$env)));
effect c11.sema.lookup_binding(name_scope.Binding($identity,c11.names.EnumerationName($value)),$name,$env) => c11.enums.EnumerationConstant($value);
effect c11.sema.lookup_binding(name_scope.Binding($identity,DeclarationView($view)),$name,$env)
    => choose(env.contains($env,DeclarationBindingKey($identity,$view)),env.get($env,DeclarationBindingKey($identity,$view)),
        $view);
effect[fallback] c11.sema.lookup_binding(name_scope.Binding($identity,$fact),$name,$env) => choose(env.contains($env,NameBindingKey($identity)),
    env.get($env,NameBindingKey($identity)),choose(c11.sema.current_identity($env,$name,$identity),env.get($env,$name),
        fail(concat("C declaration binding is unavailable at this expression point: ",$name))));
effect c11.sema.current_identity($env,$name,$identity) => choose(and(env.contains($env,VisibleFrameKey()),env.contains($env,$name)),
    bind($binding,name_scope.lookup(env.get($env,VisibleFrameKey()),"ordinary",$name),
        choose(eq($binding,name_scope.Missing()),0,eq(name_scope.binding_identity($binding),$identity))),0);

// Pointer arithmetic extensions are supplied by c11.objects; keep the
// relation declaration in its owning module so cross-module calls resolve.
effect c11.sema.pointer_subtract($left_type,$left,$right_type,$right) when eq(0,1)
    => fail("pointer subtraction extension is not loaded");
effect c11.sema.integer_constant_value($source,$env) when eq(0,1)
    => fail("integer constant policy is not loaded");
effect c11.sema.initializer_constant($source,$env) when eq(0,1)
    => fail("initializer constant policy is not loaded");

effect c11.sema.analyze($items) => bind($prepared,externc.prepare_module(c11.sema.prepare_domain($items)),
    c11.sema.append_runtime_items(c11.sema.prepare_items($prepared,c11.sema.module_constraints(c11.sema.declarations(c11.sema.declaration_order($prepared),env.empty())),env.empty())));
effect c11.sema.append_runtime_items($items) => bind([$support,$seen],list.fold("c11.sema.add_runtime_provider",
    collect("c11.sema.runtime_provider",[$items]),[[],env.empty()]),list.concat($support,$items));
effect[fallback] c11.sema.runtime_provider($items) => NoRuntimeProvider();
effect c11.sema.add_runtime_provider([$out,$seen],NoRuntimeProvider()) => [$out,$seen];
effect c11.sema.add_runtime_provider([$out,$seen],RuntimeProvider($name,$items))
    => choose(env.contains($seen,$name),fail(concat("duplicate C runtime provider: ",$name)),[list.concat($out,$items),env.put($seen,$name,1)]);
effect[fallback] c11.sema.module_constraints($env) => $env;
effect[fallback] c11.sema.function_constraints($name,$body,$env) => 1;
effect[fallback] c11.sema.language_annotations($item,$name,$env) => $item;
// Declaration registration is independent of the prepared source/emission
// order. Storage policies can postpone implicit declarations while preserving
// every source item's lexical snapshot and lowering order.
effect[fallback] c11.sema.declaration_order($items) => $items;
effect[fallback] c11.sema.prepare_domain($items) => $items;
effect c11.sema.emit_program($items) => base.lower_items(c11.sema.analyze($items));
effect c11.sema.declarations([],$env) => $env;
effect c11.sema.declarations($items,$env) when lt(0,size($items)) => list.fold("c11.sema.declaration_step",$items,$env);
effect c11.sema.declaration_step($env,$item) => c11.sema.declare($item,[],$env);
effect c11.sema.declare(c11.syntax.Function($name,$params,$result,$body),$rest,$env)
    => c11.sema.install($name,list.map("c11.sema.parameter_type",$params),c11.types.unqualified($result),0,1,$rest,$env);
effect c11.sema.declare(c11.syntax.VariadicFunction($name,$params,$result,$body),$rest,$env)
    => c11.sema.install($name,list.map("c11.sema.parameter_type",$params),c11.types.unqualified($result),1,1,$rest,$env);
effect c11.sema.declare(c11.syntax.OldFunction($name,$params,$result,$body),$rest,$env)
    => bind($binding,OldSignature(list.map("c11.sema.parameter_type",$params),c11.types.unqualified($result)),
        c11.sema.declarations($rest,env.put($env,$name,choose(env.contains($env,$name),composite_binding(env.get($env,$name),$binding),$binding))));
effect c11.sema.declare(c11.syntax.Prototype($name,$params,$result,$variadic),$rest,$env)
    => c11.sema.install($name,list.map("c11.sema.parameter_type",$params),c11.types.unqualified($result),$variadic,0,$rest,$env);
effect c11.sema.parameter_type(base.Param($name,$type)) => c11.types.unqualified($type);
effect c11.sema.declare(c11.syntax.UnspecifiedPrototype($name,$result),$rest,$env)
    => choose(env.contains($env,$name),
        c11.sema.declarations($rest,env.put($env,$name,c11.sema.composite_binding(env.get($env,$name),UnspecifiedSignature($result)))),
        c11.sema.declarations($rest,env.put($env,$name,UnspecifiedSignature($result))));
effect c11.sema.install($name,$params,$result,$variadic,$definition,$rest,$env)
    => choose(env.contains($env,$name),c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,env.get($env,$name)),
        c11.sema.declarations($rest,env.put($env,$name,CSignature($params,$result,$variadic,$definition))));
effect c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,CSignature($old_params,$old_result,$old_variadic,$old_definition))
    => choose(c11.types.compatible(c11.sema.signature_type($params,$result,$variadic),c11.sema.signature_type($old_params,$old_result,$old_variadic)),
        choose(and($definition,$old_definition),fail(concat("duplicate C function definition: ",$name)),
            bind(c11.types.FunctionType($composite_result,$composite_params,$v,$p),
                c11.types.composite(c11.sema.signature_type($params,$result,$variadic),c11.sema.signature_type($old_params,$old_result,$old_variadic)),
                c11.sema.declarations($rest,env.put($env,$name,CSignature(list.map("c11.sema.parameter_type",$composite_params),$composite_result,$v,or($definition,$old_definition)))))),
        fail(concat("incompatible C function declarations: ",$name)));
effect c11.sema.signature_type($params,$result,$variadic)
    => c11.types.FunctionType($result,list.map("c11.sema.unnamed_parameter",$params),$variadic,1);
effect visible_binding_type(GlobalSlot($type,$name),$tags) => GlobalSlot(c11.objects.declaration_type($type,$tags),$name);
effect visible_binding_type(CSignature($params,$result,$variadic,$definition),$tags)
    => bind(c11.types.FunctionType($r,$p,$v,$x),c11.objects.declaration_type(c11.sema.signature_type($params,$result,$variadic),$tags),
        CSignature(list.map("c11.sema.parameter_type",$p),$r,$v,$definition));
effect composite_binding(GlobalSlot($a,$name),GlobalSlot($b,$name))
    => GlobalSlot(choose(or(inferred_view($a),inferred_view($b)),$b,c11.sema.composite_object($a,$b)),$name);
effect inferred_view(c11.initializers.InferredArray($element,$source)) => 1;
effect inferred_view(c11.types.Qualified($type,$c,$v,$r)) => inferred_view($type);
effect inferred_view(c11.types.AlignedType($type,$alignment)) => inferred_view($type);
effect[fallback] inferred_view($type) => 0;
effect composite_binding(CSignature($ap,$ar,$av,$ad),CSignature($bp,$br,$bv,$bd))
    => choose(c11.types.compatible(c11.sema.signature_type($ap,$ar,$av),c11.sema.signature_type($bp,$br,$bv)),
        bind(c11.types.FunctionType($r,$p,$v,$x),c11.types.composite(c11.sema.signature_type($ap,$ar,$av),c11.sema.signature_type($bp,$br,$bv)),
            CSignature(list.map("c11.sema.parameter_type",$p),$r,$v,or($ad,$bd))),fail("incompatible C function declarations"));
effect[fallback] composite_binding($a,$b) => fail("C linked declaration conflicts with another identifier");
effect visible_binding_type(UnspecifiedSignature($result),$tags)
    => UnspecifiedSignature(c11.objects.declaration_type($result,$tags));
effect composite_binding(UnspecifiedSignature($a),UnspecifiedSignature($b))
    => UnspecifiedSignature(c11.types.composite($a,$b));
effect composite_binding(UnspecifiedSignature($a),CSignature($params,$b,$variadic,$definition))
    => bind(c11.types.FunctionType($r,$p,$v,$x),c11.types.composite(c11.types.FunctionType($a,[],0,0),c11.sema.signature_type($params,$b,$variadic)),
        CSignature(list.map("c11.sema.parameter_type",$p),$r,$v,$definition));
effect composite_binding(CSignature($params,$a,$variadic,$definition),UnspecifiedSignature($b))
    => composite_binding(UnspecifiedSignature($b),CSignature($params,$a,$variadic,$definition));
effect c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,UnspecifiedSignature($old_result))
    => c11.sema.declarations($rest,env.put($env,$name,composite_binding(UnspecifiedSignature($old_result),CSignature($params,$result,$variadic,$definition))));
effect visible_binding_type(OldSignature($params,$result),$tags)
    => bind(c11.types.FunctionType($r,$p,$v,$x),c11.objects.declaration_type(c11.sema.signature_type($params,$result,0),$tags),
        OldSignature(list.map("c11.sema.parameter_type",$p),$r));
effect composite_binding(OldSignature($params,$a),UnspecifiedSignature($b)) => OldSignature($params,c11.types.composite($a,$b));
effect composite_binding(UnspecifiedSignature($a),OldSignature($params,$b)) => OldSignature($params,c11.types.composite($a,$b));
effect composite_binding(OldSignature($params,$a),CSignature($prototype,$b,$variadic,$definition))
    => seq(choose($definition,fail("duplicate C function definition"),1),
        seq(choose(and(not($variadic),c11.types.compatible_parameters(list.map("c11.sema.unnamed_parameter",list.map("c11.types.default_argument",$params)),list.map("c11.sema.unnamed_parameter",$prototype))),
            1,fail("incompatible C old-style and prototype declarations")),
            CSignature($prototype,c11.types.composite($a,$b),0,1)));
effect composite_binding(CSignature($prototype,$a,$variadic,$definition),OldSignature($params,$b))
    => composite_binding(OldSignature($params,$b),CSignature($prototype,$a,$variadic,$definition));
effect composite_binding(OldSignature($a,$ar),OldSignature($b,$br)) => fail("duplicate C function definition");
effect c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,OldSignature($old_params,$old_result))
    => c11.sema.declarations($rest,env.put($env,$name,composite_binding(OldSignature($old_params,$old_result),CSignature($params,$result,$variadic,$definition))));
effect[fallback] c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,$old) => fail(concat("C identifier conflicts with an object: ",$name));
effect c11.sema.declare(c11.syntax.Global($name,$type,$value),$rest,$env)
    => bind($inference,c11.sema.bind_name($env,$name,GlobalSlot(c11.initializers.inference_type($type),$name)),
        bind($complete,c11.sema.complete_type($type,$inference),
            c11.sema.declarations($rest,c11.sema.install_object($name,$complete,c11.sema.object_definition($value),$value,$env))));
effect c11.sema.declare(c11.syntax.ExternalGlobal($name,$type),$rest,$env)
    => c11.sema.declarations($rest,c11.sema.install_object($name,$type,0,c11.syntax.Zero($type),$env));
effect c11.sema.object_definition(c11.syntax.Zero($type)) => 1;
effect[fallback] c11.sema.object_definition($value) => 2;
effect c11.sema.install_object($name,$type,$definition,$value,$environment) => bind($env,c11.sema.object_storage_environment($name,$environment),choose(env.contains($env,$name),
    c11.sema.merge_object($name,$type,$definition,$value,$env,env.get($env,$name)),
    env.put(env.put($env,$name,GlobalSlot($type,$name)),ObjectInfoKey($name),ObjectInfo($type,$definition,$value))));
effect[fallback] c11.sema.object_storage_environment($name,$env) => $env;
effect c11.sema.merge_object($name,$type,$definition,$value,$env,GlobalSlot($old_type,$symbol)) => choose(c11.types.compatible($type,$old_type),
    bind(ObjectInfo($old,$prior,$initializer),env.get($env,ObjectInfoKey($name)),
        choose(and(eq($prior,2),eq($definition,2)),fail(concat("duplicate C object definition: ",$name)),
            bind($composite,c11.sema.composite_object($old_type,$type),
                env.put(env.put($env,$name,GlobalSlot($composite,$symbol)),ObjectInfoKey($name),
                    choose(lt($prior,$definition),ObjectInfo($composite,$definition,$value),ObjectInfo($composite,$prior,$initializer)))))),
    fail(concat("incompatible C object declarations: ",$name)));
effect c11.sema.composite_object(c11.types.AlignedType($old,$a),c11.types.AlignedType($type,$b))
    => c11.types.AlignedType(c11.types.composite($old,$type),MergeAlignment($a,$b));
effect c11.sema.composite_object(c11.types.AlignedType($old,$a),$type) when not(c11.sema.is_aligned_type($type))
    => c11.types.AlignedType(c11.types.composite($old,$type),$a);
effect c11.sema.composite_object($old,c11.types.AlignedType($type,$b)) when not(c11.sema.is_aligned_type($old))
    => c11.types.AlignedType(c11.types.composite($old,$type),$b);
effect[fallback] c11.sema.composite_object($old,$type) => c11.types.composite($old,$type);
effect[fallback] c11.sema.merge_object($name,$type,$definition,$value,$env,$prior) => fail(concat("C object conflicts with another identifier: ",$name));
effect c11.sema.declare(c11.syntax.StaticAssert($condition,$message),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(c11.syntax.RecordDeclaration($name,$fields,$origin),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(c11.syntax.ForwardTag($name,$kind),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(c11.syntax.TypeDefinition($type),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.prepare_item(c11.syntax.TypeDefinition($type),$rest,$env,$seen) => c11.sema.prepare_items($rest,$env,$seen);
effect c11.sema.declare(c11.syntax.UnionDeclaration($name,$fields,$origin),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(externc.CStringGlobal($name,$literal),$rest,$env) => c11.sema.declarations($rest,$env);

effect c11.sema.prepare_items([],$env,$seen) => [];
effect c11.sema.prepare_items($items,$env,$seen) when lt(0,size($items)) => bind(Preparing($chunks,$environment,$visited),
    list.fold("c11.sema.prepare_step",$items,Preparing([],$env,$seen)),list.flatten(list.reverse($chunks)));
effect c11.sema.prepare_step(Preparing($chunks,$env,$seen),$item) => bind($out,c11.sema.prepare_item($item,[],$env,$seen),
    Preparing(list.prepend(c11.sema.internal_items($out,$env),$chunks),$env,choose(eq(size($out),0),$seen,env.put($seen,c11.sema.item_name($item),1))));
effect c11.sema.item_name(c11.syntax.Function($name,$params,$result,$body)) => $name;
effect c11.sema.item_name(c11.syntax.VariadicFunction($name,$params,$result,$body)) => $name;
effect c11.sema.item_name(c11.syntax.OldFunction($name,$params,$result,$body)) => $name;
effect c11.sema.item_name(c11.syntax.Prototype($name,$params,$result,$variadic)) => $name;
effect c11.sema.item_name(c11.syntax.UnspecifiedPrototype($name,$result)) => $name;
effect c11.sema.item_name(c11.syntax.Global($name,$type,$value)) => $name;
effect c11.sema.item_name(c11.syntax.ExternalGlobal($name,$type)) => $name;
effect c11.sema.item_name(c11.syntax.Internal($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(c11.syntax.HeaderInline($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(c11.syntax.InlineObject($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(c11.syntax.NoInline($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(externc.CStringGlobal($name,$literal)) => $name;
effect c11.sema.declare(c11.syntax.Internal($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,InternalKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.Internal($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.declare(c11.syntax.HeaderInline($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,HeaderInlineKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.HeaderInline($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.declare(c11.syntax.InlineObject($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,InlineObjectKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.InlineObject($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.declare(c11.syntax.NoInline($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,NoInlineKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.NoInline($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.internalize($item,$env) => bind($name,c11.sema.checked_name($item),choose(env.contains($env,InternalKey($name)),Internal($item),
    choose(env.contains($env,HeaderInlineKey($name)),HeaderInline($item),choose(env.contains($env,InlineObjectKey($name)),InlineObject($item),$item))));
effect c11.sema.checked_name(CheckedCFunction($name,$params,$result,$body,$variadic)) => $name;
effect c11.sema.checked_name(CheckedGlobal($name,$type,$value)) => $name;
effect c11.sema.checked_name(CheckedPrototype($name,$params,$result,$variadic)) => $name;
effect c11.sema.checked_name(CheckedExternalGlobal($name,$type)) => $name;
effect c11.sema.checked_name(externc.CheckedCStringGlobal($name,$literal)) => $name;

effect c11.sema.prepare_item(c11.syntax.Function($name,$params,$result,$body),$rest,$env,$seen)
    => c11.sema.prepare_function($name,$params,$result,$body,0,$rest,$env,$seen);
effect c11.sema.prepare_item(c11.syntax.VariadicFunction($name,$params,$result,$body),$rest,$env,$seen)
    => c11.sema.prepare_function($name,$params,$result,$body,1,$rest,$env,$seen);
effect c11.sema.prepare_item(c11.syntax.OldFunction($name,$params,$result,$body),$rest,$env,$seen)
    => seq(c11.sema.function_constraints($name,$body,$env),bind($result_type,c11.sema.value_type(c11.sema.complete_type($result,$env)),
        bind($completed,c11.sema.function_parameters($params,$env),bind($abi,list.map("c11.sema.old_abi_parameter",$completed),
        bind([$bound,$scope],base.bind_params($abi,env.put($env,FunctionNameKey(),$name),env.empty()),
            list.prepend(CheckedCFunction($name,$bound,$result_type,
                c11.sema.check_parameter_body($completed,c11.sema.function_body($name,$body),
                    c11.sema.function_label_scope($body,c11.sema.function_scope($scope,$completed,0)),$result_type),0),
                c11.sema.prepare_items($rest,$env,$seen)))))));
effect old_abi_parameter(base.Param($name,$type)) => base.Param($name,c11.types.default_argument(c11.types.unqualified($type)));
effect c11.sema.prepare_function($name,$params,$result,$body,$variadic,$rest,$env,$seen)
    => seq(c11.sema.function_constraints($name,$body,$env),bind($result_type,c11.sema.value_type(c11.sema.complete_type($result,$env)),
        bind($completed,c11.sema.function_parameters($params,$env),bind([$bound,$scope],base.bind_params($completed,env.put($env,FunctionNameKey(),$name),env.empty()),
        list.prepend(CheckedCFunction($name,$bound,$result_type,c11.sema.check_parameter_body($completed,c11.sema.function_body($name,$body),
            c11.sema.function_label_scope($body,c11.sema.function_scope($scope,$completed,$variadic)),$result_type),$variadic),
            c11.sema.prepare_items($rest,$env,$seen))))));
effect c11.sema.function_parameters($params,$env) => bind(FunctionParameters($out,$scope),
    list.fold("c11.sema.function_parameter_step",$params,FunctionParameters([],$env)),list.reverse($out));
effect c11.sema.function_parameter_step(FunctionParameters($out,$env),$param)
    => FunctionParameters(list.prepend(c11.sema.function_parameter($param,$env),$out),$env);
effect c11.sema.function_parameter(base.Param($name,$type),$env)
    => base.Param($name,c11.sema.complete_type($type,$env));
effect c11.sema.function_scope($scope,$params,0) => env.put($scope,LocalNamesKey(),env.empty());
effect[fallback] c11.sema.function_label_scope($body,$scope) => $scope;
effect c11.sema.function_scope($scope,$params,1) => choose(lt(0,size($params)),
    env.put(env.put($scope,LocalNamesKey(),env.empty()),VariadicLastKey(),arg(arg($params,sub(size($params),1)),0)),
    fail("C variadic definition requires a named parameter"));
effect c11.sema.function_body("main",$body) => c11.syntax.append($body,base.Return(c11.syntax.Literal("0")));
effect[fallback] c11.sema.function_body($name,$body) => $body;
effect c11.sema.parameter_locals([],$body) => $body;
effect c11.sema.parameter_locals($params,$body) when lt(0,size($params))
    => c11.sema.parameter_local(list.head($params),c11.sema.parameter_locals(list.tail($params),$body));
