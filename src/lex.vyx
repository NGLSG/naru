module naru;

use std.collections;
use std.string;

// kind: EOF=0, identifier=1, decimal=2, string=3, quotation=4, punctuation=5,
// numeric spelling=6, literal-only word=8. External rule frontends can reserve
// their own words without adding a keyword inventory to the compiler core.
struct Token {
    public kind: i32;
    public text: string;
    public file: string;
    public line: i64;
    public column: i64;
}

class Stream {
    public tokens: Vec<Token>;
    public pos: i64;
    public path: string;
    public diagnostic: string;
    public fn peek() -> Token { return self.tokens.get(self.pos); }
    public fn take() -> Token {
        let t = self.peek();
        if (t.kind != 0) { self.pos = self.pos + 1; }
        return t;
    }
    public fn at(text: string) -> bool {
        let t = self.peek();
        return (t.kind == 1 || t.kind == 5 || t.kind == 8) && t.text == text;
    }
    public fn accept(text: string) -> bool {
        if (self.at(text)) { self.take(); return true; }
        return false;
    }
    public fn reject(message: string) {
        if (self.diagnostic.len == 0) {
            let t = self.peek();
            self.diagnostic = t.file + ":" + naru_number(t.line) + ":" + naru_number(t.column) + ": " + message;
        }
    }
    public fn expect(text: string) -> bool {
        if (self.accept(text)) { return true; }
        self.reject("expected '" + text + "', found '" + self.peek().text + "'");
        return false;
    }
}

public fn tokenize(source: string, path: string) -> Stream {
    var s = Stream { tokens: Vec::<Token>.new(), pos: 0, path: str_dup(path), diagnostic: "" };
    var offset: i64 = 0;
    var line: i64 = 1;
    var column: i64 = 1;
    while (offset < source.len && s.diagnostic.len == 0) {
        let c = str_char_at(source, offset);
        let next = str_char_at(source, offset + 1);
        if (c == 32 || c == 9 || c == 13 || c == 10) {
            offset = offset + 1;
            if (c == 10) { line = line + 1; column = 1; }
            else { column = column + 1; }
            continue;
        }
        if (c == 47 && next == 47) {
            while (offset < source.len && str_char_at(source, offset) != 10) {
                offset = offset + 1; column = column + 1;
            }
            continue;
        }
        let start = offset;
        let token_line = line;
        let token_column = column;
        var kind: i32 = 5;
        var value: string = "";
        if (naru_ident_start(c)) {
            kind = 1;
            offset = offset + 1;
            while (offset < source.len && naru_ident_part(str_char_at(source, offset))) { offset = offset + 1; }
            value = source.substring(start, offset);
            column = column + offset - start;
        } else if (naru_digit(c)) {
            kind = 2;
            offset = offset + 1;
            // Keep C/LLVM hexadecimal floating spellings (for example
            // 0x1.fp3) as one numeric token.  The rule library, rather than
            // the core lexer, decides whether the spelling is a float or an
            // integer and which target format it receives.
            if (c == 48 && (str_char_at(source, offset) == 120 || str_char_at(source, offset) == 88)) {
                kind = 6; offset = offset + 1;
                while (naru_hex_digit(str_char_at(source, offset)) || str_char_at(source, offset) == 95) { offset = offset + 1; }
                if (str_char_at(source, offset) == 46) {
                    offset = offset + 1;
                    while (naru_hex_digit(str_char_at(source, offset)) || str_char_at(source, offset) == 95) { offset = offset + 1; }
                }
                if (str_char_at(source, offset) == 112 || str_char_at(source, offset) == 80) {
                    offset = offset + 1;
                    if (str_char_at(source, offset) == 43 || str_char_at(source, offset) == 45) { offset = offset + 1; }
                    while (naru_digit(str_char_at(source, offset)) || str_char_at(source, offset) == 95) { offset = offset + 1; }
                }
                if (naru_ident_start(str_char_at(source, offset))) {
                    while (naru_ident_part(str_char_at(source, offset))) { offset = offset + 1; }
                }
            } else {
                while (offset < source.len && naru_digit(str_char_at(source, offset))) { offset = offset + 1; }
                if (str_char_at(source, offset) == 46 && naru_digit(str_char_at(source, offset + 1))) {
                    kind = 6; offset = offset + 1;
                    while (naru_digit(str_char_at(source, offset)) || str_char_at(source, offset) == 95) { offset = offset + 1; }
                }
                if (naru_ident_start(str_char_at(source, offset))) {
                    kind = 6;
                    while (naru_ident_part(str_char_at(source, offset))) { offset = offset + 1; }
                    let last = str_char_at(source, offset - 1);
                    if ((last == 101 || last == 69) && (str_char_at(source, offset) == 43 || str_char_at(source, offset) == 45)) {
                        offset = offset + 1;
                        while (naru_ident_part(str_char_at(source, offset))) { offset = offset + 1; }
                    }
                }
            }
            value = source.substring(start, offset);
            column = column + offset - start;
        } else if (c == 34 || c == 96) {
            kind = c == 34 ? 3 : 4;
            offset = offset + 1; column = column + 1;
            var closed = false;
            var quoted = StringBuilder.create();
            while (offset < source.len && !closed && s.diagnostic.len == 0) {
                let q = str_char_at(source, offset);
                if (q == c) { closed = true; offset = offset + 1; column = column + 1; }
                else if (q == 92 && c == 34) {
                    let esc = str_char_at(source, offset + 1);
                    if (esc == 110) { quoted.appendChar(10); }
                    else if (esc == 114) { quoted.appendChar(13); }
                    else if (esc == 116) { quoted.appendChar(9); }
                    else if (esc == 34) { quoted.appendChar(34); }
                    else if (esc == 92) { quoted.appendChar(92); }
                    else { s.diagnostic = path + ":" + naru_number(line) + ":" + naru_number(column) + ": invalid string escape"; }
                    offset = offset + 2; column = column + 2;
                } else {
                    quoted.appendChar(q);
                    offset = offset + 1;
                    if (q == 10) { line = line + 1; column = 1; }
                    else { column = column + 1; }
                }
            }
            if (!closed && s.diagnostic.len == 0) {
                s.diagnostic = path + ":" + naru_number(token_line) + ":" + naru_number(token_column) + ": unterminated quotation";
            }
            let quoted_value = quoted.build();
            value = str_dup(quoted_value.as_str());
        } else {
            offset = offset + 1;
            if ((c == 61 && next == 62) || (c == 45 && next == 62) || (c == 61 && next == 61)
                || (c == 33 && next == 61)
                || (c == 42 && next == 42)
                || (c == 38 && next == 38) || (c == 124 && next == 124) || (c == 58 && next == 58)) {
                offset = offset + 1;
            }
            value = source.substring(start, offset);
            column = column + offset - start;
        }
        s.tokens.push(Token { kind: kind, text: str_dup(value), file: str_dup(path), line: token_line, column: token_column });
    }
    s.tokens.push(Token { kind: 0, text: "", file: str_dup(path), line: line, column: column });
    return s;
}
