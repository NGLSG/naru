// C11 layout expressions and declaration alignment annotations.
//
// The target facts and aggregate layout algorithm stay in c11.types and the
// shared layout dialect.  This module only exposes the source level bridge:
// offsetof is a constant size_t value and _Alignas is an annotation on an
// otherwise ordinary declaration.  Keeping this bridge separate lets a
// target dialect replace the layout relation without changing C grammar.
mod c11.layout;
use c11.types;
use c11.objects;
use c11.sema;
use c11.syntax;
use c11.declarators;
use c11.constants;
use base;
use tree;

// clang's stddef.h expands offsetof to this builtin on the Windows profile.
// The type category deliberately accepts records, unions, typedefs and
// qualified/declared type names through the existing c11.type rules.
syntax c11.layout.member_path `$member:ident` => [$member];
syntax c11.layout.member_path `$head:ident . $tail:c11.layout.member_path`
    => list.prepend($head,$tail);
syntax c11.expr `__builtin_offsetof($type:c11.type, $member:c11.layout.member_path)`
    => c11.layout.Offsetof($type,$member);

// C11 permits an alignment annotation before a declaration's specifiers.
// Both expression and type-name arguments are accepted.  The resolved object
// type is wrapped after declarator composition and lowered with LLVM
// `alignment` attributes for globals and allocas.
syntax c11.specifiers[20,right] `_Alignas($alignment:c11.expr) $spec:c11.specifiers`
    when not(c11.layout.typedef_alignment_operand($alignment,syntax.context()))
    => c11.layout.aligned_spec($spec,$alignment);
syntax c11.specifiers[20,right] `_Alignas($alignment:c11.type) $spec:c11.specifiers`
    => c11.layout.aligned_spec($spec,c11.sema.AlignType($alignment));

// A visible typedef identifier selects the type-name form. An ordinary name
// that shadows it remains an expression and must satisfy the ICE constraint.
effect c11.layout.typedef_alignment_operand(c11.syntax.Name($name),$context)
    => c11.syntax.typedef_visible($context,$name);
effect[fallback] c11.layout.typedef_alignment_operand($value,$context) => 0;

effect c11.layout.aligned_spec(c11.syntax.Specifiers($type,$storage,$inline),$alignment)
    => c11.layout.AlignedSpec(c11.syntax.Specifiers($type,$storage,$inline),$alignment);
effect c11.layout.aligned_spec(c11.layout.AlignedSpec($spec,$prior),$alignment)
    => c11.layout.AlignedSpec($spec,c11.sema.MergeAlignment($prior,$alignment));
effect[fallback] c11.layout.aligned_spec($spec,$alignment) => $spec;

// Alignment is attached after declarator composition.  This is important for
// `_Alignas(16) int *p`: the alignment belongs to p, not to the pointed-to
// int.  The wrapper is normalized by c11.sema once the declaration scope is
// available, where named aggregate types and constant expressions can be
// resolved.  A zero value is the standard no-op; nonzero values are required
// to be powers of two and cannot weaken the natural target alignment.
effect c11.layout.align_type($type,$alignment) => c11.types.AlignedType($type,$alignment);

effect c11.syntax.declaration(c11.layout.AlignedSpec(c11.syntax.Specifiers($type,$storage,$inline),$alignment),$decls)
    => c11.layout.aligned_declaration($type,$storage,$decls,$alignment);
effect c11.layout.aligned_declaration($type,$storage,$decls,$alignment)
    => bind(c11.layout.AlignedDeclarations($out,$base,$class,$alignment),
        list.fold("c11.layout.aligned_declaration_step",$decls,
            c11.layout.AlignedDeclarations([],$type,$storage,$alignment)),
        c11.syntax.DeclarationGroup(list.concat(c11.syntax.record_items($type),list.reverse($out))));
effect c11.layout.aligned_declaration_step(c11.layout.AlignedDeclarations($out,$base,$storage,$alignment),c11.syntax.Initialized($decl,$value))
    => bind(c11.declarators.Resolved($name,$type),c11.declarators.resolve($decl,c11.syntax.record_base($base)),
        c11.layout.AlignedDeclarations(list.prepend(c11.syntax.make_declaration($name,
            c11.layout.align_type($type, $alignment),$value,$storage),$out),$base,$storage,$alignment));

// `_Alignas` on a function definition is rejected instead of being silently
// dropped.  The declaration path above handles objects and typedefs continue
// through the normal typedef diagnostic.
effect c11.syntax.definition(c11.layout.AlignedSpec($spec,$alignment),$decl,$body)
    => fail("C alignment specifier cannot apply to a function definition");
effect c11.syntax.make_declaration($name,c11.types.AlignedType($type,$alignment),c11.syntax.Uninitialized(),"typedef")
    => fail("C alignment specifier cannot apply to a typedef");

effect c11.syntax.local_declarations(c11.layout.AlignedSpec(c11.syntax.Specifiers($type,$storage,$inline),$alignment),$decls)
    => c11.layout.aligned_local_declarations($type,$storage,$decls,$alignment);
effect c11.layout.aligned_local_declarations($type,$storage,$decls,$alignment)
    => bind(c11.layout.AlignedLocals($body,$base,$storage,$alignment),
        list.fold("c11.layout.aligned_local_step",list.reverse($decls),
            c11.layout.AlignedLocals(base.End(),c11.syntax.record_base($type),$storage,$alignment)),$body);
effect c11.layout.aligned_local_step(c11.layout.AlignedLocals($body,$base,$storage,$alignment),c11.syntax.Initialized($decl,$value))
    => bind(c11.declarators.Resolved($name,$type),c11.declarators.resolve($decl,$base),
        c11.layout.AlignedLocals(c11.syntax.local_declaration($name,c11.layout.align_type($type,$alignment),$value,$storage,$body),
            $base,$storage,$alignment));

// Locate a member through the same anonymous-member path search used by
// lvalue lowering.  This preserves nested anonymous struct/union offsets and
// the single-member ambiguity diagnostic.
effect c11.layout.offset_of($type,$members) when eq(size($members),1)
    => bind($member,list.head($members),
        c11.layout.offset_result(c11.objects.field_paths($type,$member),$member));
effect c11.layout.offset_of($type,$members) when lt(1,size($members))
    => bind($member,list.head($members),
        bind([$offset,$member_type],c11.layout.offset_member(c11.objects.field_paths($type,$member),$member),
            add($offset,c11.layout.offset_of($member_type,list.tail($members)))));
effect c11.layout.offset_member([[$offset,$member_type]],$member) => [$offset,$member_type];
effect c11.layout.offset_member([],$member)
    => fail(concat("unknown C aggregate member: ", $member));
effect[fallback] c11.layout.offset_member($paths,$member)
    => fail(concat("ambiguous C aggregate member: ", $member));
effect c11.layout.offset_result([[$offset,$member_type]],$member) => $offset;
effect c11.layout.offset_result([],$member)
    => fail(concat("unknown C aggregate member: ", $member));
effect[fallback] c11.layout.offset_result($paths,$member)
    => fail(concat("ambiguous C aggregate member: ", $member));

effect base.check(c11.layout.Offsetof($type,$member),$env,$expected)
    => bind($complete,c11.sema.complete_type($type,$env),
        c11.sema.contextual(base.Typed(c11.types.size_type(),
            base.Integer(c11.layout.offset_of($complete,$member))),$expected));
effect c11.sema.constant(c11.layout.Offsetof($type,$member))
    => base.Typed(c11.types.size_type(),base.Integer(c11.layout.offset_of($type,$member)));
effect c11.sema.integer_constant_expression(c11.layout.Offsetof($type,$member),$env) => 1;
effect c11.constants.context_enter(c11.layout.Offsetof($type,$member),$env,$state)
    => tree.Stop(base.check(c11.layout.Offsetof($type,$member),c11.constants.semantic_environment($env),base.Any()),$state);
