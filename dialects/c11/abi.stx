    => c11.sema.named_call("__va_start",$args,$env,$expected);
effect c11.sema.named_call($name,$args,$env,$expected) when c11.abi.va_builtin($name)
    => c11.abi.check_va_builtin($name,$args,$env,$expected);
effect c11.sema.named_call_at($frame,$name,$args,$env,$expected) when c11.abi.va_builtin($name)
    => c11.abi.check_va_builtin($name,$args,$env,$expected);
