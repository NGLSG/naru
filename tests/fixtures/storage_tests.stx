mod storage_tests;
use storage;
use memory_paths;

syntax item `storage_test $case:int` => Test($case);
effect emit(Test($case)) => mlir.op("llvm.func",[],[],
    [Attr("sym_name","main"),RawAttr("function_type","!llvm.func<i32 ()>")],
    [mlir.region(mlir.op("llvm.return",[check($case)],[],[],[]))]);
effect scalar($bits) => storage.Scalar(storage.integer_type($bits),$bits,$bits,"integer");
effect array($bits,$count) => storage.Aggregate(concat("!llvm.array<",concat(text($count),concat(" x i",concat(text($bits),">")))),
    mul($bits,$count),parts($bits,$count,0));
effect parts($bits,$count,$index) when eq($index,$count) => [];
effect parts($bits,$count,$index) when lt($index,$count) => list.prepend([mul($bits,$index),$index,scalar($bits)],parts($bits,$count,add($index,1)));
effect aggregate($shape,$values) => bind(Packing($result,$repr,$bits,$index),
    list.fold("storage_tests.put",$values,Packing(mlir.op("llvm.mlir.zero",[],[storage.repr($shape)],[],[]),storage.repr($shape),
        arg(arg(list.head(arg($shape,2)),2),1),0)),$result);
effect put(Packing($value,$repr,$bits,$index),$number) => Packing(mlir.op("llvm.insertvalue",[$value,storage.integer($number,$bits)],[$repr],
    [storage.position($index)],[]),$repr,$bits,add($index,1));
effect expect($value,$bits,$expected) => mlir.op("llvm.select",[
    mlir.op("llvm.icmp",[$value,storage.integer($expected,$bits)],["i1"],[Attr("predicate",0,"i64")],[]),
    storage.integer(42,32),storage.integer(1,32)],["i32"],[],[]);
effect check(0) => expect(storage.reinterpret(storage.integer(42,16),scalar(16),scalar(64)),64,42);
effect check(1) => expect(storage.reinterpret(storage.integer(1234605615003729962,64),scalar(64),scalar(32)),32,42);
effect check(2) => bind($shape,array(16,4),expect(storage.pack(storage.reinterpret(storage.integer(2814775537958922,64),scalar(64),$shape),$shape),64,2814775537958922));
effect check(3) => bind($shape,array(8,4),expect(storage.reinterpret(aggregate($shape,[10,11,12,9]),$shape,scalar(32)),32,151784202));
effect check(4) => bind($repr,"!llvm.struct<(i8, i32)>",bind($shape,storage.Aggregate($repr,64,[[0,0,scalar(8)],[32,1,scalar(32)]]),
    bind($value,mlir.op("llvm.insertvalue",[mlir.op("llvm.insertvalue",[mlir.op("llvm.mlir.zero",[],[$repr],[],[]),storage.integer(2,8)],[$repr],[storage.position(0)],[]),
        storage.integer(40,32)],[$repr],[storage.position(1)],[]),expect(storage.reinterpret($value,$shape,scalar(64)),64,171798691842))));
effect check(5) => bind($source,array(32,3),bind($dest,array(32,2),expect(storage.pack(storage.reinterpret(aggregate($source,[20,22,100]),$source,$dest),$dest),64,94489280532)));
effect check(6) => bind($dest,array(32,3),expect(storage.pack(storage.reinterpret(storage.integer(42,32),scalar(32),$dest),$dest),96,42));
effect check(7) => storage.reinterpret(aggregate(array(8,2),[20,22]),storage.Aggregate("!llvm.array<2 x i8>",16,[[8,0,scalar(8)],[0,1,scalar(8)]]),scalar(16));
effect check(8) => storage.reinterpret(aggregate(array(8,2),[20,22]),storage.Aggregate("!llvm.array<2 x i8>",16,[[0,0,scalar(8)],[4,1,scalar(8)]]),scalar(16));
effect check(9) => storage.reinterpret(aggregate(array(8,2),[20,22]),storage.Aggregate("!llvm.array<2 x i8>",16,[[0,0,scalar(8)],[12,1,scalar(8)]]),scalar(16));
effect check(10) => storage.reinterpret(storage.integer(42,32),scalar(32),storage.Aggregate("!llvm.array<1 x i32>",32,[[8,0,scalar(32)]]));
effect check(11) => storage.reinterpret(storage.integer(42,32),scalar(32),storage.Aggregate("!llvm.array<1 x i32>",1048577,[[0,0,scalar(32)]]));

// Language-neutral deferred image contracts; no C rule module is loaded.
effect storage.image_value(storage_tests.Number($number,$bits),$env) => storage.integer($number,$bits);
effect numeric_image($number,$bits) => storage.Image(scalar($bits),storage.ValueImage(storage_tests.Number($number,$bits)));
effect padded_image() => storage.image_record(8,[[1,numeric_image(42,32)]]);
effect check(12) => expect(storage.image_lower(storage.image_project(padded_image(),8,scalar(32)),env.empty()),32,42);
effect check(13) => bind($image,padded_image(),expect(storage.project(storage.image_lower($image,env.empty()),storage.image_shape($image),8,scalar(32)),32,42));
effect check(14) => expect(storage.image_lower(storage.image_project(storage.image_project(numeric_image(2752512,64),8,scalar(32)),8,scalar(16)),env.empty()),16,42);
effect check(15) => bind($image,storage.image_record(8,[[0,storage.Image(scalar(32),storage.ValueImage(storage_tests.NotNeeded()))],[4,numeric_image(42,32)]]),
    expect(storage.image_lower(storage.image_project($image,32,scalar(32)),env.empty()),32,42));
effect check(16) => expect(mlir.op("llvm.ptrtoint",[storage.image_lower(storage.image_project(storage.image_zero(scalar(64)),0,
    storage.Scalar("!llvm.ptr",64,64,"pointer")),env.empty())],["i64"],[],[]),64,0);
effect check(17) => storage.image_lower(storage.image_record(8,[[0,numeric_image(1,32)],[1,numeric_image(2,32)]]),env.empty());
effect check(18) => storage.image_lower(storage.image_record(2,[[0,numeric_image(42,32)]]),env.empty());
effect check(19) => storage.packed_layout(1,[[0,scalar(1)]]);
effect check(20) => storage.image_lower(storage.image_project(numeric_image(42,32),8,scalar(32)),env.empty());
effect check(21) => storage.image_lower(storage.Image(scalar(32),storage.ValueImage(storage_tests.Unknown())),env.empty());

// Runtime alignment and zero/one/multiple-result callback composition.
effect test_pointer($number) => mlir.op("llvm.inttoptr",[storage.integer($number,64)],["!llvm.ptr"],[],[]);
effect number($value) => storage.integer($value,32);
effect aligned_number($address,$alignment,$bits,$left,$right)
    => memory_paths.select(memory_paths.aligned(test_pointer($address),$alignment,$bits),["i32"],
        "storage_tests.number",[$left],"storage_tests.number",[$right]);
effect pair($first,$second) => [storage.integer($first,32),storage.integer($second,64)];
effect aligned_pair($address,$left,$right)
    => bind($values,memory_paths.select(memory_paths.aligned(test_pointer($address),8,64),["i32","i64"],
        "storage_tests.pair",$left,"storage_tests.pair",$right),
        mlir.op("llvm.add",[arg($values,0),mlir.op("llvm.trunc",[arg($values,1)],["i32"],[],[])],["i32"],[],[]));
effect store_number($pointer,$number) => mlir.op("llvm.store",[storage.integer($number,32),$pointer],[],[Attr("alignment",4,"i64")],[]);
effect aligned_store($address,$left,$right)
    => bind($slot,mlir.op("llvm.alloca",[storage.integer(1,64)],["!llvm.ptr"],[RawAttr("elem_type","i32"),Attr("alignment",4,"i64")],[]),
        seq(memory_paths.select(memory_paths.aligned(test_pointer($address),8,64),[],"storage_tests.store_number",[$slot,$left],
            "storage_tests.store_number",[$slot,$right]),mlir.op("llvm.load",[$slot],["i32"],[Attr("alignment",4,"i64")],[])));
effect trap_number() => seq(mlir.op("llvm.intr.trap",[],[],[],[]),storage.integer(1,32));
effect check(22) => aligned_number(32,8,64,42,1);
effect check(23) => aligned_number(33,8,64,1,42);
effect check(24) => aligned_number(33,1,64,42,1);
effect check(25) => aligned_number(32,8,32,42,1);
effect check(26) => aligned_pair(32,[20,22],[1,1]);
effect check(27) => aligned_pair(33,[1,1],[20,22]);
effect check(28) => aligned_store(32,42,1);
effect check(29) => aligned_store(33,1,42);
effect check(30) => aligned_number(32,0,64,42,1);
effect check(31) => aligned_number(32,3,64,42,1);
effect check(32) => aligned_number(32,8,0,42,1);
effect check(33) => memory_paths.select(memory_paths.aligned(test_pointer(32),8,64),["i32"],
    "storage_tests.number",[42],"storage_tests.trap_number",[]);
