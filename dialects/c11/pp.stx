effect c11.pp.header_cursor($macros) => choose(env.contains($macros,c11.pp.HeaderCursorKey()),env.get($macros,c11.pp.HeaderCursorKey()),c11.pp.NoHeaderCursor());
effect c11.pp.search_directories($local,0,$path,$options,$cursor,$at) => headers.directories($local,$path,$options,env.get($options,"system_include_paths"));
effect c11.pp.search_directories($local,1,$path,$options,c11.pp.HeaderCursor($remaining),$at) => $remaining;
effect c11.pp.search_directories($local,1,$path,$options,c11.pp.NoHeaderCursor(),$at) => c11.lex.error($at,"include_next requires a header found through an include search chain");
effect c11.pp.include_tokens($tokens,$macros) => arg(c11.pp.include_result($tokens,$macros),0);
effect c11.pp.include_result([],$macros) => [[],$macros];
