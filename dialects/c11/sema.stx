mod c11.sema;
use c11.syntax;
use c11.types;
use base;
use types;
use control;
use externc;
use tree;
use c11.constants;

// Pointer arithmetic extensions are supplied by c11.objects; keep the
// relation declaration in its owning module so cross-module calls resolve.
effect c11.sema.pointer_subtract($left_type,$left,$right_type,$right) when eq(0,1)
    => fail("pointer subtraction extension is not loaded");
effect c11.sema.integer_constant_value($source,$env) when eq(0,1)
    => fail("integer constant policy is not loaded");
effect c11.sema.initializer_constant($source,$env) when eq(0,1)
    => fail("initializer constant policy is not loaded");

effect c11.sema.analyze($items) => bind($prepared,externc.prepare_module(c11.sema.prepare_domain($items)),
    c11.sema.prepare_items($prepared,c11.sema.declarations($prepared,env.empty()),env.empty()));
effect[fallback] c11.sema.prepare_domain($items) => $items;
effect c11.sema.emit_program($items) => base.lower_items(c11.sema.analyze($items));
effect c11.sema.declarations([],$env) => $env;
effect c11.sema.declarations($items,$env) when lt(0,size($items)) => list.fold("c11.sema.declaration_step",$items,$env);
effect c11.sema.declaration_step($env,$item) => c11.sema.declare($item,[],$env);
effect c11.sema.declare(c11.syntax.Function($name,$params,$result,$body),$rest,$env)
    => c11.sema.install($name,list.map("c11.sema.parameter_type",$params),c11.types.unqualified($result),0,1,$rest,$env);
effect c11.sema.declare(c11.syntax.VariadicFunction($name,$params,$result,$body),$rest,$env)
    => c11.sema.install($name,list.map("c11.sema.parameter_type",$params),c11.types.unqualified($result),1,1,$rest,$env);
effect c11.sema.declare(c11.syntax.Prototype($name,$params,$result,$variadic),$rest,$env)
    => c11.sema.install($name,list.map("c11.sema.parameter_type",$params),c11.types.unqualified($result),$variadic,0,$rest,$env);
effect c11.sema.parameter_type(base.Param($name,$type)) => c11.types.unqualified($type);
effect c11.sema.declare(c11.syntax.UnspecifiedPrototype($name,$result),$rest,$env)
    => fail(concat("C function declaration without a prototype is not implemented: ",$name));
effect c11.sema.install($name,$params,$result,$variadic,$definition,$rest,$env)
    => choose(env.contains($env,$name),c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,env.get($env,$name)),
        c11.sema.declarations($rest,env.put($env,$name,CSignature($params,$result,$variadic,$definition))));
effect c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,CSignature($old_params,$old_result,$old_variadic,$old_definition))
    => choose(and(eq($params,$old_params),and(eq($result,$old_result),eq($variadic,$old_variadic))),
        choose(and($definition,$old_definition),fail(concat("duplicate C function definition: ",$name)),
            c11.sema.declarations($rest,env.put($env,$name,CSignature($params,$result,$variadic,or($definition,$old_definition))))),
        fail(concat("incompatible C function declarations: ",$name)));
effect[fallback] c11.sema.merge($name,$params,$result,$variadic,$definition,$rest,$env,$old) => fail(concat("C identifier conflicts with an object: ",$name));
effect c11.sema.declare(c11.syntax.Global($name,$type,$value),$rest,$env)
    => c11.sema.declarations($rest,c11.sema.install_object($name,$type,c11.sema.object_definition($value),$value,$env));
effect c11.sema.declare(c11.syntax.ExternalGlobal($name,$type),$rest,$env)
    => c11.sema.declarations($rest,c11.sema.install_object($name,$type,0,c11.syntax.Zero($type),$env));
effect c11.sema.object_definition(c11.syntax.Zero($type)) => 1;
effect[fallback] c11.sema.object_definition($value) => 2;
effect c11.sema.install_object($name,$type,$definition,$value,$env) => choose(env.contains($env,$name),
    c11.sema.merge_object($name,$type,$definition,$value,$env,env.get($env,$name)),
    env.put(env.put($env,$name,GlobalSlot($type,$name)),ObjectInfoKey($name),ObjectInfo($type,$definition,$value)));
effect c11.sema.merge_object($name,$type,$definition,$value,$env,GlobalSlot($old_type,$symbol)) => choose(eq($type,$old_type),
    bind(ObjectInfo($old,$prior,$initializer),env.get($env,ObjectInfoKey($name)),
        choose(and(eq($prior,2),eq($definition,2)),fail(concat("duplicate C object definition: ",$name)),
            choose(lt($prior,$definition),env.put($env,ObjectInfoKey($name),ObjectInfo($type,$definition,$value)),$env))),
    fail(concat("incompatible C object declarations: ",$name)));
effect[fallback] c11.sema.merge_object($name,$type,$definition,$value,$env,$prior) => fail(concat("C object conflicts with another identifier: ",$name));
effect c11.sema.declare(c11.syntax.StaticAssert($condition,$message),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(c11.syntax.RecordDeclaration($name,$fields,$origin),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(c11.syntax.ForwardTag($name,$kind),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(c11.syntax.TypeDefinition($type),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.prepare_item(c11.syntax.TypeDefinition($type),$rest,$env,$seen) => c11.sema.prepare_items($rest,$env,$seen);
effect c11.sema.declare(c11.syntax.UnionDeclaration($name,$fields,$origin),$rest,$env) => c11.sema.declarations($rest,$env);
effect c11.sema.declare(externc.CStringGlobal($name,$literal),$rest,$env) => c11.sema.declarations($rest,$env);

effect c11.sema.prepare_items([],$env,$seen) => [];
effect c11.sema.prepare_items($items,$env,$seen) when lt(0,size($items)) => bind(Preparing($chunks,$environment,$visited),
    list.fold("c11.sema.prepare_step",$items,Preparing([],$env,$seen)),list.flatten(list.reverse($chunks)));
effect c11.sema.prepare_step(Preparing($chunks,$env,$seen),$item) => bind($out,c11.sema.prepare_item($item,[],$env,$seen),
    Preparing(list.prepend(c11.sema.internal_items($out,$env),$chunks),$env,choose(eq(size($out),0),$seen,env.put($seen,c11.sema.item_name($item),1))));
effect c11.sema.item_name(c11.syntax.Function($name,$params,$result,$body)) => $name;
effect c11.sema.item_name(c11.syntax.VariadicFunction($name,$params,$result,$body)) => $name;
effect c11.sema.item_name(c11.syntax.Prototype($name,$params,$result,$variadic)) => $name;
effect c11.sema.item_name(c11.syntax.Global($name,$type,$value)) => $name;
effect c11.sema.item_name(c11.syntax.ExternalGlobal($name,$type)) => $name;
effect c11.sema.item_name(c11.syntax.Internal($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(c11.syntax.HeaderInline($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(c11.syntax.InlineObject($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(c11.syntax.NoInline($item)) => c11.sema.item_name($item);
effect c11.sema.item_name(externc.CStringGlobal($name,$literal)) => $name;
effect c11.sema.declare(c11.syntax.Internal($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,InternalKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.Internal($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.declare(c11.syntax.HeaderInline($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,HeaderInlineKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.HeaderInline($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.declare(c11.syntax.InlineObject($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,InlineObjectKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.InlineObject($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.declare(c11.syntax.NoInline($item),$rest,$env) => c11.sema.declare($item,$rest,env.put($env,NoInlineKey(c11.sema.item_name($item)),1));
effect c11.sema.prepare_item(c11.syntax.NoInline($item),$rest,$env,$seen) => c11.sema.prepare_item($item,$rest,$env,$seen);
effect c11.sema.internalize($item,$env) => bind($name,c11.sema.checked_name($item),choose(env.contains($env,InternalKey($name)),Internal($item),
    choose(env.contains($env,HeaderInlineKey($name)),HeaderInline($item),choose(env.contains($env,InlineObjectKey($name)),InlineObject($item),$item))));
effect c11.sema.checked_name(CheckedCFunction($name,$params,$result,$body,$variadic)) => $name;
effect c11.sema.checked_name(CheckedGlobal($name,$type,$value)) => $name;
effect c11.sema.checked_name(CheckedPrototype($name,$params,$result,$variadic)) => $name;
effect c11.sema.checked_name(CheckedExternalGlobal($name,$type)) => $name;
effect c11.sema.checked_name(externc.CheckedCStringGlobal($name,$literal)) => $name;

effect c11.sema.prepare_item(c11.syntax.Function($name,$params,$result,$body),$rest,$env,$seen)
    => c11.sema.prepare_function($name,$params,$result,$body,0,$rest,$env,$seen);
effect c11.sema.prepare_item(c11.syntax.VariadicFunction($name,$params,$result,$body),$rest,$env,$seen)
    => c11.sema.prepare_function($name,$params,$result,$body,1,$rest,$env,$seen);
effect c11.sema.prepare_function($name,$params,$result,$body,$variadic,$rest,$env,$seen)
    => bind([$bound,$scope],base.bind_params($params,$env,env.empty()),
        list.prepend(CheckedCFunction($name,$bound,c11.types.unqualified($result),base.check_body(c11.sema.parameter_locals($params,c11.sema.function_body($name,$body)),
            c11.sema.function_label_scope($body,c11.sema.function_scope($scope,$params,$variadic)),c11.types.unqualified($result)),$variadic),
            c11.sema.prepare_items($rest,$env,$seen)));
effect c11.sema.function_scope($scope,$params,0) => env.put($scope,LocalNamesKey(),env.empty());
effect[fallback] c11.sema.function_label_scope($body,$scope) => $scope;
effect c11.sema.function_scope($scope,$params,1) => choose(lt(0,size($params)),
    env.put(env.put($scope,LocalNamesKey(),env.empty()),VariadicLastKey(),arg(arg($params,sub(size($params),1)),0)),
    fail("C variadic definition requires a named parameter"));
effect c11.sema.function_body("main",$body) => c11.syntax.append($body,base.Return(c11.syntax.Literal("0")));
effect[fallback] c11.sema.function_body($name,$body) => $body;
effect c11.sema.parameter_locals([],$body) => $body;
effect c11.sema.parameter_locals($params,$body) when lt(0,size($params)) => bind(base.Param($name,$type),list.head($params),
    ParameterDeclare($name,$type,c11.sema.parameter_locals(list.tail($params),$body)));
effect c11.sema.prepare_item(c11.syntax.Prototype($name,$params,$result,$variadic),$rest,$env,$seen)
    => bind(CSignature($types,$declared_result,$declared_variadic,$definition),env.get($env,$name),
        choose(or($definition,env.contains($seen,$name)),c11.sema.prepare_items($rest,$env,$seen),
            list.prepend(CheckedPrototype($name,$types,$result,$variadic),c11.sema.prepare_items($rest,$env,env.put($seen,$name,1)))));
effect c11.sema.prepare_item(c11.syntax.Global($name,$type,$value),$rest,$env,$seen)
    => c11.sema.prepare_object($name,$rest,$env,$seen);
effect c11.sema.prepare_item(c11.syntax.ExternalGlobal($name,$type),$rest,$env,$seen)
    => c11.sema.prepare_object($name,$rest,$env,$seen);
effect c11.sema.prepare_object($name,$rest,$env,$seen) => choose(env.contains($seen,$name),c11.sema.prepare_items($rest,$env,$seen),
    bind(ObjectInfo($raw_type,$definition,$value),env.get($env,ObjectInfoKey($name)),
        bind($type,c11.sema.aligned_type($raw_type,$env),
            list.prepend(choose(eq($definition,0),CheckedExternalGlobal($name,$type),
                CheckedGlobal($name,$type,c11.sema.constant_initializer($value,c11.types.unqualified($type),$env))),
                c11.sema.prepare_items($rest,$env,env.put($seen,$name,1))))));
effect[fallback] c11.sema.constant_initializer($value,$type) => c11.sema.constant_convert(c11.sema.constant($value),$type);

// Normalize declaration alignment after tags and typedefs are in scope.  A
// type-name alignment is resolved through the same target layout relation as
// `_Alignof`; expression alignments must be integer constant powers of two.
effect c11.sema.aligned_type(c11.types.AlignedType($type,$raw),$env)
    => bind($complete,c11.sema.complete_type($type,$env),
        bind($alignment,c11.sema.alignment_value($raw,$env),
            choose(eq($alignment,0),$complete,
                choose(lt($alignment,c11.types.alignment($complete)),
                    fail("C alignment specifier weakens the natural object alignment"),
                    c11.types.AlignedType($complete,$alignment)))));
effect[fallback] c11.sema.aligned_type($type,$env) => c11.sema.complete_type($type,$env);
effect c11.sema.is_aligned_type(c11.types.AlignedType($type,$alignment)) => 1;
effect[fallback] c11.sema.is_aligned_type($type) => 0;
effect c11.sema.alignment_value(c11.sema.AlignType($type),$env)
    => c11.types.alignment(c11.sema.complete_type($type,$env));
effect[fallback] c11.sema.alignment_value($value,$env)
    => bind(base.Typed($type,base.Integer($number)),c11.sema.integer_constant_value($value,$env),
        choose(eq($number,0),0,choose(and(not(lt($number,1)),eq(int.and($number,sub($number,1)),0)),
            $number,fail("C alignment must be zero or a power of two"))));
effect c11.sema.alignment_value(c11.sema.MergeAlignment($left,$right),$env)
    => bind($a,c11.sema.alignment_value($left,$env),bind($b,c11.sema.alignment_value($right,$env),choose(lt($a,$b),$b,$a)));
effect c11.sema.prepare_item(c11.syntax.StaticAssert($condition,$message),$rest,$env,$seen)
    => bind(base.Typed($type,base.Integer($value)),c11.sema.integer_constant_value($condition,$env),choose(not(eq($value,0)),c11.sema.prepare_items($rest,$env,$seen),
        fail(concat("C static assertion failed: ",text.unquote($message)))));
effect c11.sema.prepare_item(c11.syntax.RecordDeclaration($name,$fields,$origin),$rest,$env,$seen) => c11.sema.prepare_items($rest,$env,$seen);
effect c11.sema.prepare_item(c11.syntax.ForwardTag($name,$kind),$rest,$env,$seen) => c11.sema.prepare_items($rest,$env,$seen);
effect c11.sema.prepare_item(c11.syntax.UnionDeclaration($name,$fields,$origin),$rest,$env,$seen) => c11.sema.prepare_items($rest,$env,$seen);
effect c11.sema.prepare_item(externc.CStringGlobal($name,$literal),$rest,$env,$seen)
    => list.prepend(externc.CheckedCStringGlobal($name,$literal),c11.sema.prepare_items($rest,$env,$seen));

// Statements reuse the generic CFG builder. C object and conversion policies
// remain attached to C descriptors and C AST terms.
effect base.check_body(c11.syntax.Declare($name,$type,$value,$next),$env,$result)
    => c11.sema.check_declaration($name,$type,$value,$next,$env,$result,0);
// Parameter copies intentionally read the incoming SSA binding; ordinary C
// names enter scope immediately after their declarator, before initialization.
effect base.check_body(ParameterDeclare($name,$type,$next),$env,$result)
    => c11.sema.check_declaration($name,$type,c11.syntax.Name($name),$next,$env,$result,1);
effect c11.sema.check_declaration($name,$type,$value,$next,$env,$result,$parameter)
    => bind($declared,c11.sema.aligned_type($type,$env),
        bind($seen,env.get($env,LocalNamesKey()),choose(env.contains($seen,$name),fail(concat("duplicate C local declaration: ",$name)),
            bind($identity,symbol($name),Declared($identity,$declared,c11.sema.initializer($value,
                choose($parameter,$env,env.put($env,$name,ObjectSlot($declared,$identity))),c11.types.unqualified($declared)),
                base.check_body($next,env.put(env.put($env,LocalNamesKey(),env.put($seen,$name,1)),$name,ObjectSlot($declared,$identity)),$result))))));
effect c11.sema.initializer(c11.syntax.Uninitialized(),$env,$type) => NoInitializer();
effect base.check(c11.syntax.Comma($first,$last),$env,$expected)
    => bind($left,base.check($first,$env,base.Any()),bind(base.Typed($type,$right),base.check($last,$env,$expected),
        base.Typed($type,CommaValue($left,base.Typed($type,$right)))));
effect base.lower(base.Typed($type,CommaValue($first,$last)),$env) => seq(base.lower($first,$env),base.lower($last,$env));
effect[fallback] c11.sema.initializer($value,$env,$type) => c11.sema.convert_expression($value,$env,c11.types.unqualified($type));
effect base.check_body(c11.syntax.Scope($body,$next),$env,$result)
    => CheckedScope(base.check_body($body,env.put($env,LocalNamesKey(),env.empty()),$result),base.check_body($next,$env,$result));
effect base.check_body(c11.syntax.For($init,$condition,$step,$body,$next),$env,$result)
    => base.check_body(c11.syntax.Scope(c11.syntax.append($init,base.While(c11.syntax.Truth($condition),
        c11.syntax.append(c11.sema.for_continues($body,$step),control.Evaluate($step,base.End())),base.End())),$next),$env,$result);
effect base.check_body(c11.syntax.DoWhile($body,$condition,$next),$env,$result)
    => CheckedDoWhile(base.check_body($body,base.loop_scope($env),$result),c11.sema.truth(base.check($condition,$env,base.Any())),base.check_body($next,$env,$result));
effect c11.sema.for_continues(control.Continue(),$step) => control.Evaluate($step,control.Continue());
effect c11.sema.for_continues(c11.syntax.Declare($name,$type,$value,$next),$step) => c11.syntax.Declare($name,$type,$value,c11.sema.for_continues($next,$step));
effect c11.sema.for_continues(c11.syntax.Scope($body,$next),$step) => c11.syntax.Scope(c11.sema.for_continues($body,$step),c11.sema.for_continues($next,$step));
effect c11.sema.for_continues(base.If($condition,$yes,$no,$next),$step) => base.If($condition,c11.sema.for_continues($yes,$step),c11.sema.for_continues($no,$step),c11.sema.for_continues($next,$step));
effect c11.sema.for_continues(base.While($condition,$body,$next),$step) => base.While($condition,$body,c11.sema.for_continues($next,$step));
effect c11.sema.for_continues(c11.syntax.DoWhile($body,$condition,$next),$step) => c11.syntax.DoWhile($body,$condition,c11.sema.for_continues($next,$step));
effect c11.sema.for_continues(control.Evaluate($value,$next),$step) => control.Evaluate($value,c11.sema.for_continues($next,$step));
effect[fallback] c11.sema.for_continues($body,$step) => $body;
effect base.prepare_storage(Declared($identity,$type,$value,$next),$entry,$env)
    => bind($slot,mlir.with_block($entry,c11.sema.allocate($type)),base.prepare_storage($next,$entry,env.put($env,$identity,$slot)));
effect base.prepare_storage(CheckedScope($body,$next),$entry,$env) => base.prepare_storage($next,$entry,base.prepare_storage($body,$entry,$env));
effect base.prepare_storage(CheckedDoWhile($body,$condition,$next),$entry,$env) => base.prepare_storage($next,$entry,base.prepare_storage($body,$entry,$env));
effect base.lower_flow(Declared($identity,$type,NoInitializer(),$next),$env,$block,$continuation) => base.lower_flow($next,$env,$block,$continuation);
effect base.lower_flow(Declared($identity,$type,$value,$next),$env,$block,$continuation) when not(eq($value,NoInitializer()))
    => seq(mlir.in_block($block,c11.sema.store($value,env.get($env,$identity),$env,$type)),base.lower_flow($next,$env,$block,$continuation));
effect base.lower_flow(CheckedScope($body,$next),$env,$block,$continuation)
    => bind($join,mlir.block([]),list.concat(base.lower_flow($body,$env,$block,$join),
        choose(choose(base.flow_terminal($body),not(base.keep_continuation($next)),0),[],base.lower_flow($next,$env,$join,$continuation))));
effect base.lower_flow(CheckedDoWhile($body,$condition,$next),$env,$block,$continuation)
    => c11.sema.lower_do($body,$condition,$next,$env,$block,$continuation,mlir.block([]),mlir.block([]),mlir.block([]));
effect c11.sema.lower_do($body,$condition,$next,$env,$block,$continuation,$loop,$test,$exit)
    => seq(mlir.in_block($block,base.jump($loop)),seq(mlir.in_block($test,base.branch_to(base.lower($condition,$env),$loop,$exit)),
        list.concat([$block],list.concat(base.lower_flow($body,base.loop_values($env,$test,$exit),$loop,$test),
            list.concat([$test],base.lower_flow($next,$env,$exit,$continuation))))));
effect base.flow_terminal(Declared($identity,$type,$value,$next)) => base.flow_terminal($next);
effect base.flow_terminal(CheckedScope($body,$next)) => or(base.flow_terminal($body),base.flow_terminal($next));
effect base.flow_terminal(CheckedDoWhile($body,$condition,$next)) => base.flow_terminal($next);
effect base.function_continuation(c11.types.IntType($rank,$width,$unsigned)) => Fallthrough(c11.types.IntType($rank,$width,$unsigned));
effect base.function_continuation(c11.types.FloatType($rank,$format)) => Fallthrough(c11.types.FloatType($rank,$format));
effect base.function_continuation(c11.types.Pointer($element)) => Fallthrough(c11.types.Pointer($element));
effect base.function_continuation(c11.types.CBool()) => Fallthrough(c11.types.CBool());
effect base.function_continuation(c11.types.PlainChar()) => Fallthrough(c11.types.PlainChar());
effect base.function_continuation(c11.types.Qualified($type,$const,$volatile,$restrict)) => base.function_continuation($type);
effect base.finish(Fallthrough($type)) => base.ret(mlir.op("llvm.mlir.undef",[],[types.repr($type)],[],[]));
effect base.finish_context(Fallthrough($type),$environment) => base.return_in($environment,[mlir.op("llvm.mlir.undef",[],[types.repr($type)],[],[])]);

effect base.check(c11.syntax.Name($name),$env,$expected) => c11.sema.contextual(c11.sema.complete_value(c11.sema.named_read(env.get($env,$name),$name),$env),$expected);
effect c11.sema.complete_value(base.Typed($type,$value),$env) => base.Typed(c11.sema.complete_type($type,$env),$value);
effect c11.sema.read(ObjectSlot($type,$identity)) => c11.sema.object_read($type,LocalReference($type,$identity));
effect c11.sema.read(GlobalSlot($type,$name)) => c11.sema.object_read($type,GlobalReference($type,$name));
effect[fallback] c11.sema.object_read($type,$reference) => base.Typed(c11.types.unqualified($type),ReferenceLoad($reference));
effect c11.sema.read(base.Slot($type,$identity)) => base.Typed(c11.types.unqualified($type),base.Read($identity));
effect base.check(c11.syntax.Literal($raw),$env,$expected) => c11.sema.contextual(c11.types.literal($raw),$expected);
effect base.check(c11.syntax.Character($raw),$env,$expected) => c11.sema.contextual(c11.types.character($raw),$expected);
effect base.check(c11.syntax.Zero($type),$env,$expected) => c11.sema.contextual(c11.sema.zero($type),$expected);
effect base.check(StringAddress($name,$count),$env,$expected) => c11.sema.contextual(base.Typed(c11.types.Pointer(c11.types.integer("char")),StringPointer($name)),$expected);
effect c11.sema.contextual($value,base.Any()) => $value;
effect c11.sema.contextual($value,$expected) when not(eq($expected,base.Any())) => c11.sema.convert($value,c11.types.unqualified($expected));
// Nullness is a source-language fact: a variable containing zero is not a
// null pointer constant. Evaluate only proven integer constant expressions
// when a pointer context actually needs this fact; ordinary runtime arithmetic
// keeps its checked expression and does not invoke the constant evaluator.
effect c11.sema.convert_expression($source,$env,$type)
    => c11.sema.contextual_expression($source,base.check($source,$env,base.Any()),$env,$type);
effect c11.sema.contextual_expression($source,$value,$env,c11.types.Pointer($type))
    => c11.sema.convert(c11.sema.null_operand($source,$value,$env),c11.types.Pointer($type));
effect[fallback] c11.sema.contextual_expression($source,$value,$env,$expected) => c11.sema.contextual($value,$expected);
effect c11.sema.null_operand($source,base.Typed($type,$value),$env)
