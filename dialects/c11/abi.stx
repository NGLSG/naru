        fail("Windows va_list must be a modifiable char pointer lvalue")),seq(c11.sema.writable_type(arg($reference,0)),$reference)));
effect c11.abi.start_va($list,c11.syntax.Name($last),$env,$expected)
    => seq(c11.abi.va_reference($list,$env),c11.msvc.va_start(c11.syntax.Address($list),$last,$env,$expected));
